/* ── Types ─────────────────────────────────────────────────────────── */

type MeasureTool = 'select' | 'distance' | 'polyline' | 'area' | 'rectarea' | 'volume' | 'count'
  | 'cloud' | 'arrow' | 'text' | 'rectangle' | 'highlight'
  | 'perimeter' | 'diameter' | 'radiusCenter' | 'radius3Point' | 'angle'
  | 'polygonCutout' | 'ellipseCutout' | 'dynamicFill';

/** Annotation-specific tool types */
type AnnotationToolType = 'cloud' | 'arrow' | 'text' | 'rectangle' | 'highlight';

const ANNOTATION_TOOLS: AnnotationToolType[] = ['cloud', 'arrow', 'text', 'rectangle', 'highlight'];

// --- Takeoff toolbar styling primitives ---------------------------------
// Kept together so every control in the two-row toolbar shares one rhythm:
// 28px (h-7) hit targets, soft "segmented" group tracks (a faint surface
// pill behind related buttons, in place of hairline dividers) and a single
// clear active treatment per category. `tbBtn` returns the className for a
// toolbar button given its on/off state and which accent its active state
// uses (blue = measure, orange = markup, purple = scale, neutral = view).
const TB_GROUP = 'inline-flex items-center gap-0.5 rounded-lg bg-surface-secondary/70 p-0.5';
type TbAccent = 'blue' | 'orange' | 'purple' | 'neutral';
function tbBtn(active: boolean, accent: TbAccent = 'neutral'): string {
  const base =
    'inline-flex h-7 items-center justify-center gap-1.5 rounded-md px-1.5 text-xs font-medium transition-colors disabled:opacity-30 disabled:pointer-events-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-oe-blue/40';
  if (!active) return `${base} text-content-secondary hover:bg-surface-primary hover:text-content-primary`;
  if (accent === 'blue') return `${base} bg-oe-blue text-white shadow-sm`;
  if (accent === 'orange') return `${base} bg-orange-500 text-white shadow-sm`;
  if (accent === 'purple') return `${base} bg-purple-500 text-white shadow-sm`;
  return `${base} bg-surface-primary text-content-primary shadow-xs`;
}

/** Check if a tool is an annotation tool */
const isAnnotationTool = (tool: MeasureTool): tool is AnnotationToolType =>
  (ANNOTATION_TOOLS as string[]).includes(tool);

/** Check if a measurement type is an annotation type */
const isAnnotationType = (type: string): boolean =>
  (ANNOTATION_TOOLS as string[]).includes(type);

/**
 * Quantize a measured quantity for persistence to a BOQ position.
 *
 * Previously this rounded to 2 dp (`Math.round(v*100)/100`), which
 * silently destroyed precision the backend itself preserves: BOQ line
 * storage quantizes to **4 dp** (`_MONEY_QUANTUM = Decimal("0.0001")`),
 * so a 0.0345 m² patch or a 12.3456 m run lost real digits *before* it
 * ever reached the server (D-TKC-022). Round to the same 4 dp quantum
 * so the frontend never pre-truncates below backend storage fidelity;
 * display-side rounding stays separate (read-only, lossless on store).
 */
const boqQuantity = (value: number): number => {
  if (!Number.isFinite(value)) return 0;
  return Math.round(value * 1e4) / 1e4;
};

/** Map a takeoff measurement to a canonical quantities dict for cost
 *  matching: area measurements feed area_m2, volumes feed volume_m3,
 *  lines/polylines feed length_m, counts feed count. */
function pdfMeasurementQuantities(m: Measurement): Record<string, number> {
  if (!Number.isFinite(m.value)) return {};
  // A wall (linear run with a height) is matched as the wall surface it
  // reports: net area, with its length and height alongside.
  if (isWallMeasurement(m)) {
    return { area_m2: reportedMagnitude(m), length_m: m.value, height_m: m.wallHeight ?? 0 };
  }
  switch (m.type) {
    case 'area':
      return { area_m2: m.value };
    case 'volume':
      return { volume_m3: m.value };
    case 'count':
      return { count: m.value };
    case 'distance':
    case 'polyline':
      return { length_m: m.value };
    default:
      return {};
  }
}

/** i18n descriptors for a measure dimension, used by the dimension-guard
 *  toast (mirrors the backend ``push_quantity`` guard, which refuses the
 *  push silently - the UI surfaces the mismatch instead). */
const DIMENSION_LABELS: Readonly<Record<MeasureDimension, { key: string; fallback: string }>> = {
  length: { key: 'takeoff.dim_length', fallback: 'length' },
  area: { key: 'takeoff.dim_area', fallback: 'area' },
  volume: { key: 'takeoff.dim_volume', fallback: 'volume' },
  mass: { key: 'takeoff.dim_mass', fallback: 'weight' },
  count: { key: 'takeoff.dim_count', fallback: 'count' },
  lsum: { key: 'takeoff.dim_lsum', fallback: 'lump sum' },
  time: { key: 'takeoff.dim_time', fallback: 'time' },
};

/** Badge colours per confidence band.
 *
 *  Green / amber / red is the platform's agreed reading for an AI result, so
 *  the band is legible before the number is read. ``unknown`` keeps the violet
 *  "this came from a detector" tone rather than borrowing red: the offline
 *  Recognize path proposes geometry without scoring it, and painting that as
 *  low confidence would invent a judgement nothing made. */
const CONFIDENCE_BAND_CLASSES: Record<ConfidenceBand, string> = {
  high: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
  medium: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
  low: 'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300',
  unknown: 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300',
};

/** Plain wording for each band, used in the badge tooltip and the review bar. */
const CONFIDENCE_BAND_TEXT: Record<ConfidenceBand, { key: string; fallback: string }> = {
  high: { key: 'takeoff_viewer.confidence_high', fallback: 'High confidence' },
  medium: { key: 'takeoff_viewer.confidence_medium', fallback: 'Medium confidence' },
  low: { key: 'takeoff_viewer.confidence_low', fallback: 'Low confidence' },
  unknown: { key: 'takeoff_viewer.confidence_unknown', fallback: 'Not scored' },
};

/** How each stored scale provenance reads to an estimator. A value absent from
 *  this map (including a source added server-side ahead of this client) falls
 *  back to "Unknown", which is also what a row with no source at all shows -
 *  the honest answer, and the one that matters when a sheet turns out to have
 *  been measured at the wrong ratio. */
// Keyed by the closed union rather than by `string`, so adding a source to the
// backend vocabulary without giving it a label here is a build error instead of
// a row that silently renders as "Unknown".
const SCALE_SOURCE_TEXT: Record<ScaleSource, { key: string; fallback: string }> = {
  manual_calibration: {
    key: 'takeoff_viewer.scale_source_manual_calibration',
    fallback: 'Calibrated on this sheet',
  },
  preset: { key: 'takeoff_viewer.scale_source_preset', fallback: 'Document scale' },
  inherited: {
    key: 'takeoff_viewer.scale_source_inherited',
    fallback: "Inherited from the sheet's scale",
  },
  page_text: {
    key: 'takeoff_viewer.scale_source_page_text',
    fallback: 'Read from the drawing text',
  },
  recovered_text: {
    key: 'takeoff_viewer.scale_source_recovered_text',
    fallback: 'Recovered from the sheet by OCR',
  },
  vision_read: {
    key: 'takeoff_viewer.scale_source_vision_read',
    fallback: 'Read from the drawing by the model',
  },
};

interface Point {
  x: number;
  y: number;
}

interface Measurement {
  id: string;
  type: 'distance' | 'polyline' | 'area' | 'volume' | 'count'
    | 'cloud' | 'arrow' | 'text' | 'rectangle' | 'highlight'
    | 'perimeter' | 'diameter' | 'radiusCenter' | 'radius3Point' | 'angle'
    | 'polygonCutout' | 'ellipseCutout' | 'dynamicFill' | 'legend';
  points: Point[];
  value: number;
  unit: string;
  label: string;
  annotation: string; // User-provided text label (e.g. "Living room wall")
  page: number;
  group: string; // Measurement group (e.g. "General", "Structural")
  /** Mirrored copy of the group's band (issue #393); see takeoff-types.ts. */
  groupBand?: number;
  depth?: number; // Depth in real units, only for volume type
  area?: number; // Area in real units, only for volume type
  /** For cutouts: the ID of the parent area/volume measurement this cutout subtracts from. */
  cutoutOf?: string;
  text?: string; // Text content for text annotations
  color?: string; // Color for annotation tools
  width?: number; // Width for rectangle/highlight
  height?: number; // Height for rectangle/highlight
  /** For legends: the specific measurement IDs this legend covers.
   *  Undefined = live "all measurements" legend. Set = snapshot of the
   *  selection at placement time. */
  legendMeasurementIds?: string[];
  fillAlpha?: number; // Per-measurement fill opacity 0..1 (issue #311)
  strokeWidth?: number; // Per-measurement stroke width in CSS px (issue #312)
  /** Per-measurement stroke width in canonical METRES (issue #339). When set
   *  (and the page is calibrated) the band renders at the element's true width
   *  via strokeWidthReal * pixelsPerUnit, so it stays consistent across pages at
   *  different scales. Mutually exclusive with `strokeWidth`; round-trips via
   *  metadata as ``stroke_width_real``. */
  strokeWidthReal?: number;
  strokeAlpha?: number; // Per-measurement LINE opacity 0..1 for linear types (issue #332)
  /** Per-markup label text size override (px) for the NAME line. When set,
   *  this markup's floating label uses it instead of the global Colours-tab
   *  size, so each markup can have its own label size. Undefined = use
   *  global default. */
  labelTextSize?: number;
  /** Per-markup overrides for the MATERIAL and DIMENSION label lines. */
  labelMaterialSize?: number;
  labelDimSize?: number;
  /** Per-markup overrides for the NAME / MATERIAL / DIMENSION label line colours. */
  labelNameColor?: string;
  labelMaterialColor?: string;
  labelDimColor?: string;
  /** True-surface slope / pitch factor for an AREA measurement (roofs, ramps):
   *  true surface qty = plan area x slopeFactor (>= 1). Undefined = 1 (flat). */
  slopeFactor?: number;
  /** Material wastage / allowance percent on the reported quantity (10 = +10%).
   *  Undefined = 0. */
  wastagePct?: number;
  /** Typical-multiplier: this measurement stands for N identical repeats
   *  (typical floors / bays). Effective qty = base x multiplier. Undefined = 1. */
  multiplier?: number;
  /** Wall height in canonical metres for a linear measurement; when set the
   *  row reports wall area (length x height). See takeoff-types.ts. */
  wallHeight?: number;
  /** Openings deducted from the wall area (width x height x count, metres). */
  openings?: WallOpening[];
  /** Custom colour of this measurement's GROUP (issue #313), mirrored onto the
   *  measurement so the group colour scheme round-trips server-side through the
   *  metadata blob (like fillAlpha/strokeWidth) instead of being localStorage-
   *  only. Distinct from `color`, which is a per-measurement override. */
  groupColor?: string;
  /** Explicit paint (z) order key (issue #379). Higher = painted later = on
   *  top; drives the canvas paint pass, the click hit-test precedence and the
   *  PDF export. Undefined on a measurement the user never reordered: it then
   *  falls back to its position in the measurements array (creation order,
   *  #375), so existing measurements are unchanged. Round-trips via the metadata
   *  blob like the other per-measurement overrides. */
  order?: number;
  /** Free-form notes entered via the properties panel. */
  notes?: string;
  /** User-defined ledger columns: column name → cell text (e.g. Subject,
   *  Material from the tool chest). Round-trips via the metadata blob. */
  customFields?: Record<string, string>;
  /** Opening deduction: an `area` measurement that represents a void
   *  (door, window, cut-out) whose area is SUBTRACTED from the gross area
   *  of its group so a net area = gross - openings. Stored as a positive
   *  gross area; only the rollup subtracts it. Only meaningful for area. */
  isDeduction?: boolean;
  /** Server ID (set after first persistence sync). */
  serverId?: string;
  /** Linked BOQ position id — the canonical "this measurement feeds that position". */
  linkedPositionId?: string;
  /** Linked BOQ position ordinal, cached for the badge. */
  linkedPositionOrdinal?: string;
  /** Linked BOQ id — so the badge can deep-link straight into the editor. */
  linkedBoqId?: string;
  /** Human label of the linked position (description), for tooltip. */
  linkedPositionLabel?: string;
  /** Proposed by a detector and not yet reviewed by a human (issue #194).
   *  Renders dashed/translucent and stays out of the totals until someone
   *  accepts it. It IS stored server-side as a `proposed` row - the flag
   *  mirrors that state rather than meaning "unsaved", so a rejection is a
   *  decision the next reload respects instead of an undo waiting to happen. */
  suggested?: boolean;
  /** Recognition confidence 0..1, present only on AI-sourced measurements. */
  confidence?: number;
  /** Where the scale used to compute this measurement came from, or undefined
   *  when it was never recorded. This is CAPTURE provenance: it is written
   *  together with the ratio it describes and never on its own, so the two
   *  always refer to the same moment. Rendered as "Unknown" when missing,
   *  because on a mis-scaled sheet "we do not know" is the useful answer.
   *  Mirrors the field of the same name on the shared `Measurement` in
   *  `features/takeoff/lib/takeoff-types.ts`. */
  scaleSource?: ScaleSource;
}

/** Narrow to a measurement the server already holds, so a review decision can
 *  be addressed to a real row without an assertion at the call site. */
function isPersisted(m: Measurement): m is Measurement & { serverId: string } {
  return Boolean(m.serverId);
}

/* ── Annotation Colors ───────────────────────────────────────────── */

interface AnnotationColor {
  name: string;
  value: string;
}

const ANNOTATION_COLORS: AnnotationColor[] = [
  { name: 'Red', value: '#EF4444' },
  { name: 'Blue', value: '#3B82F6' },
  { name: 'Green', value: '#22C55E' },
  { name: 'Orange', value: '#F59E0B' },
  { name: 'Purple', value: '#8B5CF6' },
  { name: 'Yellow', value: '#FACC15' },
];

/** Default colors for each annotation tool */
const DEFAULT_ANNOTATION_COLORS: Record<AnnotationToolType, string> = {
  cloud: '#EF4444',
  arrow: '#3B82F6',
  text: '#000000',
  rectangle: '#22C55E',
  highlight: '#FACC15',
};

/* ── Measurement Groups ───────────────────────────────────────────── */

interface MeasurementGroup {
  name: string;
  color: string;
}

const MEASUREMENT_GROUPS: MeasurementGroup[] = [
  { name: 'General', color: '#3B82F6' },
  { name: 'Structural', color: '#EF4444' },
  { name: 'Electrical', color: '#F59E0B' },
  { name: 'Plumbing', color: '#8B5CF6' },
  { name: 'HVAC', color: '#06B6D4' },
  { name: 'Finishing', color: '#22C55E' },
  { name: 'Excavation', color: '#92400E' },
  { name: 'Concrete', color: '#6B7280' },
  /* Cold-formed steel estimation groups — these map 1:1 to the CFS
   * Estimation tabs (Estimating → Estimation → CFS Estimation), so a
   * multi-selected ledger export can land in the right tab. */
  { name: 'Roof Trusses', color: '#DC2626' },
  { name: 'Floor Trusses', color: '#EA580C' },
  { name: 'Load Bearing Walls', color: '#7C3AED' },
  { name: 'Non Load Bearing Walls', color: '#0891B2' },
];

/** Ledger → CFS Estimation export targets. Each maps a group pick-list
 *  option to the CFS tab (and wall bearing) it lands in. */
export type CfsExportTargetId = 'roofTrusses' | 'floorTrusses' | 'loadBearingWalls' | 'nonLoadBearingWalls';

export const CFS_EXPORT_TARGETS: Array<{
  id: CfsExportTargetId;
  /** Group pick-list name shown in the export popup. */
  groupName: string;
  /** CFS tab label shown in the export popup. */
  tabLabel: string;
}> = [
  { id: 'roofTrusses', groupName: 'Roof Trusses', tabLabel: 'Roof Trusses' },
  { id: 'floorTrusses', groupName: 'Floor Trusses', tabLabel: 'Floor Trusses' },
  { id: 'loadBearingWalls', groupName: 'Load Bearing Walls', tabLabel: 'Wall Studs' },
  { id: 'nonLoadBearingWalls', groupName: 'Non Load Bearing Walls', tabLabel: 'Wall Studs' },
];

/* ── Tool Chest (Bluebeam-style custom tools) ───────────────────────────
 * A saved tool captures the current measuring setup — tool type, markup
 * color and active group — under a name. Clicking it restores the setup
 * instantly. Persisted in localStorage so the chest survives reloads. */
export interface SavedTool {
  id: string;
  name: string;
  tool: MeasureTool;
  color: string;
  group: string;
  /** Bluebeam subject (e.g. Howe) — shown as its own field, stamped onto measurements. */
  subject?: string;
  /** Bluebeam label/material (e.g. 362S162-43) — shown as its own field, becomes the annotation. */
  label?: string;
  /** Bluebeam tool set this came from (e.g. Truss, CFS). */
  toolSet?: string;
}

const TOOL_CHEST_KEY = 'takeoff.toolChest.v1';

function loadToolChest(): SavedTool[] {
  try {
    const raw = localStorage.getItem(TOOL_CHEST_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed.filter(
      (t): t is SavedTool =>
        t && typeof t.id === 'string' && typeof t.name === 'string' && typeof t.tool === 'string',
    );
  } catch {
    return [];
  }
}

/** Human label for a measure tool, for the chest list. */
const TOOL_LABELS: Record<MeasureTool, string> = {
  select: 'Select',
  distance: 'Distance',
  polyline: 'Polyline',
  area: 'Area',
  rectarea: 'Rect Area',
  volume: 'Volume',
  count: 'Count',
  cloud: 'Cloud',
  arrow: 'Arrow',
  text: 'Text',
  rectangle: 'Rectangle',
  highlight: 'Highlight',
  perimeter: 'Perimeter',
  diameter: 'Diameter',
  radiusCenter: 'Center Radius',
  radius3Point: '3-Point Radius',
  angle: 'Angle',
  polygonCutout: 'Polygon Cutout',
  ellipseCutout: 'Ellipse Cutout',
  dynamicFill: 'Dynamic Fill',
};

/** Bluebeam-style legend (placed on the PDF) geometry, in PDF user units.
 *  The box height grows with the row count; the viewer hit-tests and paints
 *  from these same constants so the two can never disagree. */
const LEGEND_WIDTH = 230;
const LEGEND_HEADER_H = 30;
const LEGEND_COLHEADER_H = 16;
const LEGEND_ROW_H = 24;
const LEGEND_PAD = 10;
/** Legend box height for a given row count. `padV` = extra vertical cell
 *  padding (top + bottom) applied to the title row, the column-header row
 *  and every data row, in the same PDF units. */
const legendBoxHeight = (rowCount: number, padV = 0): number =>
  (LEGEND_HEADER_H + padV) + (LEGEND_COLHEADER_H + padV) + rowCount * (LEGEND_ROW_H + padV) + LEGEND_PAD;
/** Content-based legend width for a column count (before any user resize). */
const legendContentWidth = (colCount: number): number => 150 + colCount * 70;
/** Effective legend box width in PDF units: the stored resize, else the
 *  content-based default. */
const legendWidthOf = (m: { width?: number }, colCount: number): number =>
  m.width && m.width > 0 ? m.width : legendContentWidth(colCount);
/** Effective legend box height in PDF units: the stored resize, but
 *  NEVER below the content height for the current row count — a placed
 *  legend grows automatically when new measurements add rows (the stored
 *  height used to freeze the box and clip new rows inside it). Mirrors
 *  the width rule in legendHitWidth. */
const legendHeightOf = (m: { height?: number }, rowCount: number, padV = 0): number =>
  Math.max(m.height && m.height > 0 ? m.height : 0, legendBoxHeight(rowCount, padV));
/** Effective legend width for hit-testing: must match the render's
 *  `effW` exactly (max of manual width and auto-measured width), else the
 *  right-edge hover/drag zones sit left of the visual right edge once
 *  content outgrows a manual resize. */
const legendHitWidth = (
  m: { id: string; width?: number },
  autoWidths: Map<string, number>,
  colCount: number,
): number => {
  const autoW = autoWidths.get(m.id) ?? legendContentWidth(colCount);
  const userW = m.width && m.width > 0 ? m.width : 0;
  return userW > 0 ? Math.max(userW, autoW) : autoW;
};
/** Minimum legend box size in PDF units (resize clamp). */
const LEGEND_MIN_W = 80;
const LEGEND_MIN_H = 40;
/** Corner handle grab radius in CSS px for legend resize hit-testing. */
const LEGEND_CORNER_TOL_CSS = 8;
/** Human label for a measurement type in the legend. Falls back to the raw
 *  type string for future types. */
const legendTypeLabel = (type: string): string =>
  (TOOL_LABELS as Record<string, string>)[type] ?? type;

/** Icon for legend row line-type (user identification). */
const LegendTypeIcon = ({ type, size = 12 }: { type: string; size?: number }) => {
  const props = { size, className: 'shrink-0 text-content-secondary' };
  switch (type) {
    case 'distance':
      return <Minus {...props} />;
    case 'polyline':
      return <Route {...props} />;
    case 'area':
      return <Square {...props} />;
    case 'rectangle':
      return <RectangleHorizontal {...props} />;
    case 'count':
      return <Hash {...props} />;
    case 'volume':
      return <Box {...props} />;
    case 'diameter':
      return <Circle {...props} />;
    case 'angle':
      return <Triangle {...props} />;
    default:
      return <Minus {...props} />;
  }
};

/** Canvas twin of LegendTypeIcon for the placed PDF legend box: strokes
 *  the tool symbol (24-unit grid) into the box whose top-left is (x, y)
 *  at the given device-px size. The legend Kind column shows this symbol
 *  instead of the type name text. Glyphs mirror the lucide icons above. */
const drawLegendTypeSymbol = (
  ctx: CanvasRenderingContext2D,
  type: string,
  x: number,
  y: number,
  size: number,
  color: string,
): void => {
  const s = size / 24;
  ctx.save();
  ctx.translate(x, y);
  ctx.scale(s, s);
  ctx.strokeStyle = color;
  ctx.lineWidth = 2;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  const stroke = (build: () => void) => {
    ctx.beginPath();
    build();
    ctx.stroke();
  };
  switch (type) {
    case 'polyline':
      stroke(() => { ctx.arc(6, 19, 3, 0, Math.PI * 2); });
      stroke(() => { ctx.arc(18, 5, 3, 0, Math.PI * 2); });
      ctx.stroke(new Path2D('M12 19h4.5a3.5 3.5 0 0 0 0-7h-7a3.5 3.5 0 0 1 0-7H12'));
      break;
    case 'area':
      stroke(() => { ctx.roundRect(3, 3, 18, 18, 2); });
      break;
    case 'rectangle':
      stroke(() => { ctx.roundRect(2, 6, 20, 12, 2); });
      break;
    case 'count':
      stroke(() => {
        ctx.moveTo(4, 9); ctx.lineTo(20, 9);
        ctx.moveTo(4, 15); ctx.lineTo(20, 15);
        ctx.moveTo(10, 3); ctx.lineTo(8, 21);
        ctx.moveTo(16, 3); ctx.lineTo(14, 21);
      });
      break;
    case 'volume':
      stroke(() => {
        ctx.moveTo(12, 2.7); ctx.lineTo(21, 7.5); ctx.lineTo(21, 16.5);
        ctx.lineTo(12, 21.3); ctx.lineTo(3, 16.5); ctx.lineTo(3, 7.5);
        ctx.closePath();
        ctx.moveTo(3, 7.5); ctx.lineTo(12, 12.3); ctx.lineTo(21, 7.5);
        ctx.moveTo(12, 12.3); ctx.lineTo(12, 21.3);
      });
      break;
    case 'diameter':
      stroke(() => { ctx.arc(12, 12, 10, 0, Math.PI * 2); });
      break;
    case 'angle':
      stroke(() => {
        ctx.moveTo(12, 3); ctx.lineTo(22, 20); ctx.lineTo(2, 20);
        ctx.closePath();
      });
      break;
    default:
      stroke(() => { ctx.moveTo(5, 12); ctx.lineTo(19, 12); });
      break;
  }
  ctx.restore();
};

/** Hit-test for placed text annotations. The text is drawn at a constant
 *  14 CSS px (bold) starting at its anchor point, so the hit box is the
 *  anchor plus the measured text width, in screen space. Returns the
 *  nearest text measurement on the given page whose box contains the
 *  point (PDF units), if any. Used to reopen a text for editing. */
let textMeasureCtx: CanvasRenderingContext2D | null | undefined;
const getTextMeasureCtx = (): CanvasRenderingContext2D | null => {
  if (textMeasureCtx === undefined) {
    try { textMeasureCtx = document.createElement('canvas').getContext('2d'); }
    catch { textMeasureCtx = null; }
  }
  return textMeasureCtx;
};
/** Width of a string in PDF units at the text box font (bold 14). */
const measureTextUnits = (content: string): number => {
  const ctx = getTextMeasureCtx();
  if (!ctx) return content.length * 8;
  ctx.font = `bold ${TEXT_FONT_PX}px sans-serif`;
  return ctx.measureText(content).width;
};
/** Wrap text into lines fitting a box inner width (PDF units),
 *  honouring manual line breaks. Mirrors the canvas draw exactly. */
const wrapTextLines = (content: string, innerWidth: number): string[] => {
  const maxW = Math.max(10, innerWidth);
  const out: string[] = [];
  for (const para of content.split('\n')) {
    const words = para.split(/\s+/).filter(Boolean);
    if (words.length === 0) {
      out.push('');
      continue;
    }
    let line = '';
    for (const word of words) {
      const trial = line ? `${line} ${word}` : word;
      if (line && measureTextUnits(trial) > maxW) {
        out.push(line);
        line = word;
      } else {
        line = trial;
      }
    }
    out.push(line);
  }
  return out.length > 0 ? out : [''];
};
/** Box height (PDF units) for content at a given box width. */
const textBoxHeight = (content: string, width: number): number =>
  wrapTextLines(content, width - TEXT_PAD_X * 2).length * TEXT_LINE_HEIGHT_PX + TEXT_PAD_Y * 2;

const findTextAnnotationAt = (
  all: Measurement[],
  page: number,
  point: Point,
  zoomLevel: number,
): Measurement | undefined => {
  const sx = point.x * zoomLevel;
  const sy = point.y * zoomLevel;
  let best: Measurement | undefined;
  let bestDist = Infinity;
  for (const m of all) {
    if (m.type !== 'text' || m.page !== page || m.points.length < 1) continue;
    const anchor = m.points[0]!;
    // Box annotations: a hit anywhere inside the stored box (PDF units).
    if (m.width && m.width > 0) {
      const bh = m.height && m.height > 0 ? m.height : TEXT_LINE_HEIGHT_PX + TEXT_PAD_Y * 2;
      if (
        point.x >= anchor.x && point.x <= anchor.x + m.width &&
        point.y >= anchor.y && point.y <= anchor.y + bh
      ) {
        const d = Math.abs(point.x - anchor.x) + Math.abs(point.y - anchor.y);
        if (d < bestDist) { bestDist = d; best = m; }
      }
      continue;
    }
    // Legacy pins: the measured single-line band around the anchor.
    const ax = anchor.x * zoomLevel;
    const ay = anchor.y * zoomLevel;
    const w = measureTextUnits(m.text || m.annotation || '');
    if (sx >= ax - 6 && sx <= ax + w + 6 && sy >= ay - 16 && sy <= ay + (TEXT_LINE_HEIGHT_PX + TEXT_PAD_Y) * zoomLevel + 5) {
      const d = Math.abs(point.x - anchor.x) + Math.abs(point.y - anchor.y);
      if (d < bestDist) { bestDist = d; best = m; }
    }
  }
  return best;
};


/** Built-in group colours. Custom groups add their colours at runtime via the
 *  component's `groupColorMap` memo (issue #313). */
const BASE_GROUP_COLORS: Record<string, string> = Object.fromEntries(
  MEASUREMENT_GROUPS.map((g) => [g.name, g.color]),
);

/** Miter-join polyline offset (used by the Offset feature).
 *  Returns a parallel copy of `points` at `dist` PDF points.
 *  `side`: +1 = left of the drawing direction, -1 = right (PDF coords, y-down).
 *  Closed shapes (first ≈ last point) are offset as a ring. Miter spikes are
 *  clamped to 3× the distance so sharp corners stay sane. */
function offsetPolylinePoints(points: Point[], dist: number, side: 1 | -1): Point[] {
  const n = points.length;
  if (n < 2 || !(dist > 0)) return points.map((p) => ({ ...p }));
  const closed = Math.hypot(points[0]!.x - points[n - 1]!.x, points[0]!.y - points[n - 1]!.y) < 0.001;
  const ring = closed ? points.slice(0, n - 1) : points;
  const m = ring.length;
  if (m < 2) return points.map((p) => ({ ...p }));

  // Per-segment unit normals (left of direction, scaled by side).
  // Closed: m segments (wrapping). Open: m-1 segments.
  const segCount = closed ? m : m - 1;
  const normals: Point[] = [];
  for (let i = 0; i < segCount; i++) {
    const p0 = ring[i]!;
    const p1 = ring[(i + 1) % m]!;
    const dx = p1.x - p0.x;
    const dy = p1.y - p0.y;
    const len = Math.hypot(dx, dy);
    if (len < 1e-9) {
      normals.push({ x: 0, y: 0 });
    } else {
      normals.push({ x: (-dy / len) * side, y: (dx / len) * side });
    }
  }

  // Intersection of two offset lines (miter). Falls back to the averaged
  // normal when the segments are parallel.
  const miter = (
    vertex: Point,
    p1: Point, d1: Point, n1: Point,
    p2: Point, d2: Point, n2: Point,
  ): Point => {
    const q1 = { x: p1.x + n1.x * dist, y: p1.y + n1.y * dist };
    const q2 = { x: p2.x + n2.x * dist, y: p2.y + n2.y * dist };
    const denom = d1.x * d2.y - d1.y * d2.x;
    if (Math.abs(denom) < 1e-9) {
      const ax = (n1.x + n2.x) / 2;
      const ay = (n1.y + n2.y) / 2;
      const alen = Math.hypot(ax, ay) || 1;
      return { x: vertex.x + (ax / alen) * dist, y: vertex.y + (ay / alen) * dist };
    }
    let t = ((q2.x - q1.x) * d2.y - (q2.y - q1.y) * d2.x) / denom;
    // Clamp the miter length so acute corners do not spike.
    const d1len = Math.hypot(d1.x, d1.y) || 1;
    const miterLen = Math.abs(t) * d1len;
    const maxMiter = dist * 4;
    if (miterLen > maxMiter) t = (maxMiter / d1len) * Math.sign(t || 1);
    return { x: q1.x + d1.x * t, y: q1.y + d1.y * t };
  };

  const out: Point[] = [];
  if (closed) {
    for (let i = 0; i < m; i++) {
      const prev = (i - 1 + m) % m;
      const p0 = ring[prev]!;
      const p1 = ring[i]!;
      const p2 = ring[(i + 1) % m]!;
      out.push(miter(
        p1,
        p0, { x: p1.x - p0.x, y: p1.y - p0.y }, normals[prev]!,
        p1, { x: p2.x - p1.x, y: p2.y - p1.y }, normals[i]!,
      ));
    }
    out.push({ ...out[0]! }); // re-close the ring
  } else {
    for (let i = 0; i < m; i++) {
      if (i === 0) {
        out.push({ x: ring[0]!.x + normals[0]!.x * dist, y: ring[0]!.y + normals[0]!.y * dist });
      } else if (i === m - 1) {
        out.push({ x: ring[m - 1]!.x + normals[m - 2]!.x * dist, y: ring[m - 1]!.y + normals[m - 2]!.y * dist });
      } else {
        const p0 = ring[i - 1]!;
        const p1 = ring[i]!;
        const p2 = ring[i + 1]!;
        out.push(miter(
          p1,
          p0, { x: p1.x - p0.x, y: p1.y - p0.y }, normals[i - 1]!,
          p1, { x: p2.x - p1.x, y: p2.y - p1.y }, normals[i]!,
        ));
      }
    }
  }
  return out;
}

/** Signed area of a point ring (PDF coords, y-down). Positive = clockwise. */
function signedArea(points: Point[]): number {
  let a = 0;
  for (let i = 0; i < points.length; i++) {
    const p = points[i]!;
    const q = points[(i + 1) % points.length]!;
    a += p.x * q.y - q.x * p.y;
  }
  return a / 2;
}

/** Multiply ghost data for the track preview. */
interface MultiplyGhostData {
  points: Point[][];
  srcCenter: Point;
  dir: Point;
  distPdf: number;
  copies: number;
}

/** Draw the multiply ghost preview directly on a canvas context.
 *  Module-level so both the React draw effect and the synchronous preview
 *  path use the exact same rendering. */
function drawMultiplyGhost(
  ctx: CanvasRenderingContext2D,
  ghost: MultiplyGhostData,
  zoom: number,
  dpr: number,
  distanceLabel: string,
): void {
  const ghostPts = ghost.points;
  if (ghostPts.length === 0) return;
  ctx.save();
  // Track line: from source center through the last copy.
  const sx0 = ghost.srcCenter.x * dpr * zoom;
  const sy0 = ghost.srcCenter.y * dpr * zoom;
  const sx1 = (ghost.srcCenter.x + ghost.dir.x * ghost.distPdf * ghost.copies) * dpr * zoom;
  const sy1 = (ghost.srcCenter.y + ghost.dir.y * ghost.distPdf * ghost.copies) * dpr * zoom;
  ctx.setLineDash([10 * dpr, 6 * dpr]);
  ctx.globalAlpha = 0.85;
  ctx.strokeStyle = '#2563EB';
  ctx.lineWidth = 2.5 * dpr;
  ctx.beginPath();
  ctx.moveTo(sx0, sy0);
  ctx.lineTo(sx1, sy1);
  ctx.stroke();
  // Arrowhead at the track end.
  const ang = Math.atan2(sy1 - sy0, sx1 - sx0);
  const ahLen = 10 * dpr;
  ctx.setLineDash([]);
  ctx.fillStyle = '#2563EB';
  ctx.beginPath();
  ctx.moveTo(sx1, sy1);
  ctx.lineTo(sx1 - ahLen * Math.cos(ang - 0.4), sy1 - ahLen * Math.sin(ang - 0.4));
  ctx.lineTo(sx1 - ahLen * Math.cos(ang + 0.4), sy1 - ahLen * Math.sin(ang + 0.4));
  ctx.closePath();
  ctx.fill();
  // Ghost copies with numbers.
  ctx.setLineDash([6 * dpr, 4 * dpr]);
  ctx.globalAlpha = 0.75;
  ctx.strokeStyle = '#2563EB';
  ctx.lineWidth = Math.max(2 * dpr, 2 * dpr * zoom * 0.5);
  ghostPts.forEach((pts, idx) => {
    if (pts.length === 0) return;
    ctx.beginPath();
    pts.forEach((p, i) => {
      const sx = p.x * dpr * zoom;
      const sy = p.y * dpr * zoom;
      if (i === 0) ctx.moveTo(sx, sy);
      else ctx.lineTo(sx, sy);
    });
    if (pts.length > 2) ctx.closePath();
    ctx.stroke();
    const ccx = pts.reduce((s, p) => s + p.x, 0) / pts.length;
    const ccy = pts.reduce((s, p) => s + p.y, 0) / pts.length;
    const bx = ccx * dpr * zoom;
    const by = ccy * dpr * zoom;
    ctx.globalAlpha = 1;
    ctx.setLineDash([]);
    ctx.font = `700 ${13 * dpr}px sans-serif`;
    const num = `${idx + 1}`;
    const tw = ctx.measureText(num).width;
    const pad = 5 * dpr;
    ctx.fillStyle = '#2563EB';
    ctx.beginPath();
    ctx.arc(bx, by, tw / 2 + pad, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#ffffff';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(num, bx, by + 0.5 * dpr);
    ctx.globalAlpha = 0.75;
    ctx.setLineDash([6 * dpr, 4 * dpr]);
  });
  // Spacing label at the track midpoint.
  if (distanceLabel) {
    const mx = (sx0 + sx1) / 2;
    const my = (sy0 + sy1) / 2;
    ctx.globalAlpha = 1;
    ctx.setLineDash([]);
    ctx.font = `600 ${12 * dpr}px sans-serif`;
    const tw = ctx.measureText(distanceLabel).width;
    const pad = 4 * dpr;
    ctx.fillStyle = 'rgba(0,0,0,0.75)';
    ctx.beginPath();
    ctx.roundRect(mx - tw / 2 - pad, my - 10 * dpr - pad, tw + pad * 2, 14 * dpr + pad * 2, 4 * dpr);
    ctx.fill();
    ctx.fillStyle = '#93c5fd';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(distanceLabel, mx, my - 3 * dpr);
  }
  ctx.restore();
}

/** Map a display-unit label to a CalibrationUnit for toMeters(). Falls back
 *  to feet (the user's working unit) for unrecognized labels. */
function toCalibrationUnit(label: string): 'm' | 'mm' | 'ft' | 'in' {
  const s = (label || '').trim().toLowerCase();
  if (s === 'mm' || s.startsWith('millim')) return 'mm';
  if (s === 'm' || s.startsWith('meter') || s.startsWith('metre')) return 'm';
  if (s === 'in' || s === '"' || s === '″' || s.startsWith('inch')) return 'in';
  return 'ft';
}

/** Parse a Bluebeam-style distance string into metres.
 *  Accepts `1'-6"`, `1'6"`, `18"`, `1.5'` as well as plain decimals
 *  (interpreted in `fallbackUnit`). Returns null when unparsable. */
function parseDistanceToMeters(raw: string, fallbackUnit: 'm' | 'mm' | 'ft' | 'in' | 'ft-in'): number | null {
  const s = (raw || '').trim();
  if (!s) return null;
  // Explicit metric suffix: "300mm", "2.5m", "10 mm".
  const metric = s.match(/^(-?\d+(?:\.\d+)?)\s*(mm|m)\s*$/i);
  if (metric) {
    const v = parseFloat(metric[1]!);
    if (!Number.isFinite(v) || v <= 0) return null;
    return metric[2]!.toLowerCase() === 'mm' ? v * 0.001 : v;
  }
  // Explicit imperial suffix: "10ft", "10 ft".
  const ftWord = s.match(/^(-?\d+(?:\.\d+)?)\s*ft\s*$/i);
  if (ftWord) {
    const v = parseFloat(ftWord[1]!);
    if (!Number.isFinite(v) || v <= 0) return null;
    return v * 0.3048;
  }
  // Dash format without quote marks: "6-5" -> 6'-5". In a distance field
  // "6-5" is never subtraction; it's always feet-inches.
  const dashFtIn = s.match(/^\s*(\d+(?:\.\d+)?)\s*-\s*(\d+(?:\.\d+)?)\s*$/);
  if (dashFtIn) {
    const ft = parseFloat(dashFtIn[1]!);
    const inch = parseFloat(dashFtIn[2]!);
    if (Number.isFinite(ft) && Number.isFinite(inch)) {
      const meters = ft * 0.3048 + inch * 0.0254;
      return meters > 0 ? meters : null;
    }
  }
  // ft-in form: "2'", "2'-0\"", "14\"", "12'-8\"", "12.66'", "8in", "8 in".
  // The dash in "6'-6\"" is optional and ignored.
  const ftIn = s.match(/^\s*(?:(\d+(?:\.\d+)?)\s*')?\s*-?\s*(?:(\d+(?:\.\d+)?)\s*(?:"|″|in)?)?\s*$/i);
  if (ftIn && (ftIn[1] !== undefined || ftIn[2] !== undefined)) {
    const ft = ftIn[1] !== undefined ? parseFloat(ftIn[1]) : 0;
    const inch = ftIn[2] !== undefined && ftIn[2] !== '' ? parseFloat(ftIn[2]) : 0;
    if (!Number.isFinite(ft) || !Number.isFinite(inch)) return null;
    const hasMark = s.includes("'") || s.includes('"') || s.includes('″') || /in$/i.test(s);
    if (hasMark) {
      const meters = ft * 0.3048 + inch * 0.0254;
      return meters > 0 ? meters : null;
    }
  }
  const v = parseFloat(s);
  if (!Number.isFinite(v) || v <= 0) return null;
  // A bare number is interpreted in the selected unit. For 'ft-in', a bare
  // number means feet (e.g. "6" = 6'-0"); inches need an explicit mark
  // (6") or the 'in' unit — otherwise offsets come out 12x too small.
  const factor = { m: 1, mm: 0.001, ft: 0.3048, in: 0.0254, 'ft-in': 0.3048 }[fallbackUnit] ?? 0.3048;
  return v * factor;
}

/** Describes a reversible measurement operation for the undo stack. */
type UndoOperation =
  | { kind: 'add_point'; tool: MeasureTool; point: Point }
  | { kind: 'complete_measurement'; measurement: Measurement; previousActivePoints: Point[] }
  | { kind: 'add_count_point'; measurementId: string; point: Point; wasNew: boolean; previousMeasurement: Measurement | null }
  | { kind: 'delete_measurement'; measurement: Measurement }
  | { kind: 'change_annotation'; measurementId: string; previousAnnotation: string }
  // Bulk add (Multiply / Offset): a set of measurements created by one user
  // action, so a single undo removes them all together.
  | { kind: 'bulk_add'; measurements: Measurement[] }
  // In-canvas geometry edit (#194 Feature 1). Both kinds snapshot the
  // pre-edit measurement so undo restores the exact prior geometry +
  // derived value; redo replays the post-edit snapshot.
  | { kind: 'edit_geometry'; measurementId: string; previousMeasurement: Measurement; nextMeasurement: Measurement }
  // Paint-order change (issue #379: bring-to-front / send-to-back). Stores the
  // previous and next `order` keys (undefined = "no explicit order") so undo
  // restores the persisted key rather than a remembered list index, keeping the
  // stack correct under concurrent edits.
  // ``regrouped`` marks a drop that also moved the row between groups (issue
  // #393), and is the only thing undo and redo may branch on. A group name is
  // legitimately the empty string, so testing the names for truthiness would
  // read a real move out of an unnamed group as no move at all and undo would
  // leave the row where the redo put it. The two names cannot collapse into one
  // field either, since undoing needs the name to go back to and that is gone
  // once the move has been applied.
  | {
      kind: 'reorder_measurement';
      measurementId: string;
      previousOrder: number | undefined;
      nextOrder: number;
      regrouped?: boolean;
      previousGroup?: string;
      nextGroup?: string;
    }
  // A drop that had to renumber a whole group because the gap it was released
  // into could no longer hold a distinct key (issue #405). It is a separate kind
  // rather than optional extra fields on the frame above, because that frame has
  // three producers: bring-to-front, send-to-back and the ordinary drop, all of
  // which move exactly one row. Widening it would have left every one of them
  // carrying a shape they never fill, and undo branching on which shape it got.
  // ``regrouped`` and the group names mean what they mean above, and apply to
  // ``measurementId``, the one row the user actually dragged; the rest of
  // ``rows`` only changed key. ``previousOrder`` is undefined for a row that had
  // never been reordered, which undo has to write back as undefined rather than
  // skip, or the row keeps a key the renumber invented.
  | {
      kind: 'renumber_measurement_order';
      rows: { id: string; previousOrder: number | undefined; nextOrder: number }[];
      measurementId: string;
      regrouped?: boolean;
      previousGroup?: string;
      nextGroup?: string;
    }
  // Dragging a group block to a new slot (issue #400). Unlike a measurement
  // reorder this rewrites the band of EVERY group in one step, so the frame
  // carries whole maps rather than one key. The previous map is frequently
  // empty, which is a real state and not a missing value: it means no group had
  // ever been pinned and every band was derived.
  | {
      kind: 'reorder_groups';
      previousBands: Record<string, number>;
      nextBands: Record<string, number>;
    };

/* ── Component ─────────────────────────────────────────────────────── */

/** Minimal shape of a previously-uploaded takeoff document, surfaced as a
 *  "Recent drawings" list on the landing page so the user can reopen a PDF
 *  in one click instead of re-uploading it. */
export interface RecentTakeoffDocument {
  id: string;
  filename: string;
  pages: number;
  size_bytes: number;
  uploaded_at: string | null;
}

interface TakeoffViewerModuleProps {
  /** URL to pre-load a PDF from (e.g. `/api/v1/takeoff/documents/{id}/download/`). */
  initialPdfUrl?: string;
  /** Optional filename to associate with the pre-loaded PDF (display only). */
  initialPdfName?: string;
  /** Stable document UUID for this PDF (issue #238). Measurement identity is
   *  ``projectId`` + this id, never the filename. Every opener that has a
   *  server document passes it explicitly; omitting it means "this PDF has no
   *  server document", which is exactly the state a fresh local drop is in.
   *  The id is never recovered by parsing ``initialPdfUrl``: that URL can point
   *  at either namespace (``/takeoff/documents/{id}/`` or Project Files
   *  ``/documents/{id}/``) and the two ids are not interchangeable, so a parsed
   *  id was liable to be sent to the endpoints of the wrong namespace. */
  initialDocumentId?: string | null;
  /** Optional measurement id to auto-select + scroll-to once the measurement
   *  list lands (used by the /markups → /takeoff deep-link). Matches either
   *  the frontend id or the server-side UUID. */
  initialMeasurementId?: string | null;
  /** Optional 1-based page to restore once a server-loaded document finishes
   *  loading (issue #386 - reopening a document should land on the page it
   *  was left on, not always page 1). Clamped to the loaded document's page
   *  count. Ignored for local file uploads, which always start on page 1. */
  initialPage?: number;
  /** Called with the 1-based page whenever it changes on a loaded document,
   *  so the parent can mirror it into the URL for bookmarking/sharing. */
  onPageChange?: (page: number) => void;
  /** Previously-uploaded documents for the active project, shown on the
   *  landing page as a "Recent drawings" quick-open list. */
  recentDocuments?: RecentTakeoffDocument[];
  /** Open one of the recent documents in the viewer (parent owns navigation). */
  onOpenRecentDocument?: (docId: string) => void;
}

/** localStorage key for the dragged legend position (#358). A workspace
 *  preference, like a panel size - kept out of the document so it never follows
 *  the file to another user. */
const LEGEND_POS_KEY = 'oe.takeoff.legend-pos';

/* ── Resizable side panels ──────────────────────────────────────────────
 * The page-thumbnails strip (left) and the Measurements panel (right) are
 * user-resizable via the drag grips rendered between them and the canvas
 * column. Widths persist in localStorage like the other takeoff view
 * preferences. Bounds mirror the previous fixed widths (w-32 = 128px,
 * w-72 = 288px) so the defaults look identical to before. */
const LEFT_STRIP_DEFAULT = 128;
const LEFT_STRIP_MIN = 96;
const LEFT_STRIP_MAX = 420;
const RIGHT_PANEL_DEFAULT = 288;
const RIGHT_PANEL_MIN = 240;
const RIGHT_PANEL_MAX = 760;
const LEFT_STRIP_KEY = 'takeoff.leftStripWidth';
const RIGHT_PANEL_KEY = 'takeoff.rightPanelWidth';
/** Bottom ledger bar: vertically resizable like the side panels. Dragging
 *  its top handle below the threshold snaps it shut to a slim strip. */
const LEDGER_DEFAULT = 220;
const LEDGER_MIN = 120;
const LEDGER_MAX = 600;
const LEDGER_COLLAPSE_THRESHOLD = 40;
const LEDGER_HEIGHT_KEY = 'takeoff.ledgerHeight';
const LEDGER_SHOW_KEY = 'takeoff.showLedger';
/** Dragging a strip below this width snaps it shut to zero and hides the
 *  panel (left strip -> drag left, right panel -> drag right). Reopening
 *  from the toolbar restores the pre-collapse width. */
const COLLAPSE_THRESHOLD = 48;

function readPanelWidth(key: string, fallback: number, min: number, max: number): number {
  try {
    const v = Number(localStorage.getItem(key));
    return Number.isFinite(v) && v > 0 ? Math.min(max, Math.max(min, v)) : fallback;
  } catch {
    return fallback;
  }
}

/** Edge tab shown when a side panel is collapsed to zero: a visible
 *  indication of where the panel went, clickable to reopen and draggable to
 *  extend it back open from zero. Deliberately wide (32px) with a grip-dot
 *  affordance so the tab is easy to grab and drag open. */
/** Toast stack rendered INSIDE the fullscreen viewer element. The global
 *  ToastContainer lives at document level, which the browser hides while an
 *  element is fullscreen — without this, no notification is visible in
 *  fullscreen measuring mode. */
/** Second split-screen pane: an independent read-only view of the same PDF
 *  document (Bluebeam-style split view). It has its own page, zoom and
 *  scroll position; measurements on its page are drawn as a lightweight
 *  read-only overlay. All measuring stays in the main pane. */
function SplitPane({
  pdfDoc,
  page,
  zoom,
  totalPages,
  measurements,
  groupColorMap,
  onPageChange,
  onZoomChange,
  onClose,
}: {
  pdfDoc: PDFDocumentProxy;
  page: number;
  zoom: number;
  totalPages: number;
  measurements: Measurement[];
  groupColorMap: Record<string, string>;
  onPageChange: (p: number) => void;
  onZoomChange: (z: number) => void;
  onClose: () => void;
}) {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const overlayRef = useRef<HTMLCanvasElement>(null);
  const scrollRef = useRef<HTMLDivElement>(null);
  /* Current zoom for the non-passive wheel handler (avoids stale closure). */
  const zoomRef = useRef(zoom);
  zoomRef.current = zoom;
  /* Cursor-anchored zoom: content point to keep under the cursor after the
   * zoom re-renders, applied in the effect keyed on zoom. */
  const pendingAnchorRef = useRef<{ contentX: number; contentY: number; viewX: number; viewY: number } | null>(null);

  /* Ctrl/Cmd + wheel = smooth cursor-anchored zoom (like the main pane).
   * Native listener with passive:false so preventDefault() stops the page
   * from scrolling while zooming. */
  useEffect(() => {
    const el = scrollRef.current;
    if (!el) return;
    const onWheel = (e: WheelEvent) => {
      if (!(e.ctrlKey || e.metaKey)) return;
      e.preventDefault();
      // Stop the viewer-root wheel guard from zooming the MAIN pane too —
      // split zoom must stay independent per pane.
      e.stopPropagation();
      const rect = el.getBoundingClientRect();
      const viewX = e.clientX - rect.left;
      const viewY = e.clientY - rect.top;
      const contentX = viewX + el.scrollLeft;
      const contentY = viewY + el.scrollTop;
      // Delta-proportional (not fixed-step) so trackpads glide smoothly.
      const factor = Math.pow(1.0012, -e.deltaY);
      const cur = zoomRef.current;
      const next = Math.min(4, Math.max(0.25, Math.round(cur * factor * 100) / 100));
      if (next === cur) return;
      const scale = next / cur;
      pendingAnchorRef.current = {
        contentX: contentX * scale,
        contentY: contentY * scale,
        viewX,
        viewY,
      };
      onZoomChange(next);
    };
    el.addEventListener('wheel', onWheel, { passive: false });
    return () => el.removeEventListener('wheel', onWheel);
  }, [onZoomChange]);

  /* Apply the pending cursor anchor after the zoom re-renders. */
  useEffect(() => {
    const a = pendingAnchorRef.current;
    const el = scrollRef.current;
    if (a && el) {
      el.scrollLeft = Math.max(0, a.contentX - a.viewX);
      el.scrollTop = Math.max(0, a.contentY - a.viewY);
      pendingAnchorRef.current = null;
    }
  }, [zoom]);

  /** Fit the page width to this pane. */
  const fitWidth = useCallback(async () => {
    try {
      const pdfPage = await pdfDoc.getPage(page);
      const vp = pdfPage.getViewport({ scale: 1 });
      const availW = (scrollRef.current?.clientWidth ?? 800) - 32;
      if (vp.width > 0) {
        onZoomChange(Math.max(0.25, Math.min(4, Math.round((availW / vp.width) * 100) / 100)));
      }
    } catch {
      /* ignore */
    }
  }, [pdfDoc, page, onZoomChange]);

  /** Draw the read-only measurement overlay (simple colored shapes). */
  const drawOverlay = useCallback(() => {
    const overlay = overlayRef.current;
    if (!overlay) return;
    const ctx = overlay.getContext('2d');
    if (!ctx) return;
    const dpr = window.devicePixelRatio || 1;
    ctx.clearRect(0, 0, overlay.width, overlay.height);
    ctx.lineWidth = 2 * dpr;
    for (const m of measurements) {
      if (m.suggested) continue;
      const color = m.color || groupColorMap[m.group] || '#3b82f6';
      ctx.strokeStyle = color;
      ctx.fillStyle = color;
      const pts = m.points.map((p) => ({ x: p.x * zoom * dpr, y: p.y * zoom * dpr }));
      if (pts.length === 0) continue;
      if (m.type === 'count' || pts.length === 1) {
        ctx.beginPath();
        ctx.arc(pts[0].x, pts[0].y, 6 * dpr, 0, Math.PI * 2);
        ctx.fill();
      } else {
        ctx.beginPath();
        ctx.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
        if (m.type === 'area' || m.type === 'rectangle' || m.type === 'cloud') {
          ctx.closePath();
        }
        ctx.stroke();
      }
    }
  }, [measurements, zoom, groupColorMap]);

  /* Render the PDF page into this pane's canvas. */
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const pdfPage = await pdfDoc.getPage(page);
        if (cancelled) return;
        const dpr = window.devicePixelRatio || 1;
        const viewport = pdfPage.getViewport({ scale: zoom * dpr });
        const canvas = canvasRef.current;
        if (!canvas) return;
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        canvas.style.width = `${viewport.width / dpr}px`;
        canvas.style.height = `${viewport.height / dpr}px`;
        const overlay = overlayRef.current;
        if (overlay) {
          overlay.width = viewport.width;
          overlay.height = viewport.height;
          overlay.style.width = canvas.style.width;
          overlay.style.height = canvas.style.height;
        }
        await pdfPage.render({ canvas, viewport }).promise;
        if (cancelled) return;
        drawOverlay();
      } catch {
        /* superseded render — ignore */
      }
    })();
    return () => {
      cancelled = true;
    };
  }, [pdfDoc, page, zoom, drawOverlay]);

  /* Repaint the overlay when the measurements change. */
  useEffect(() => {
    drawOverlay();
  }, [drawOverlay]);

  const stepZoom = (dir: 1 | -1) => {
    onZoomChange(Math.min(4, Math.max(0.25, Math.round((zoom + dir * 0.25) * 100) / 100)));
  };

  return (
    <div className="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-lg border border-border bg-gray-100 dark:bg-gray-900">
      {/* Pane header: own pager + zoom + close. */}
      <div className="flex shrink-0 items-center gap-1 border-b border-border bg-surface-primary px-2 py-1">
        <span className="mr-1 text-[10px] font-bold uppercase tracking-widest text-content-tertiary">
          Split
        </span>
        <button
          type="button"
          onClick={() => onPageChange(Math.max(1, page - 1))}
          disabled={page <= 1}
          className="rounded p-1 text-content-secondary hover:bg-surface-secondary disabled:opacity-40"
          aria-label="Previous page"
        >
          <ChevronLeft size={14} />
        </button>
        <span className="text-[11px] tabular-nums text-content-secondary">
          {page} / {totalPages}
        </span>
        <button
          type="button"
          onClick={() => onPageChange(Math.min(totalPages, page + 1))}
          disabled={page >= totalPages}
          className="rounded p-1 text-content-secondary hover:bg-surface-secondary disabled:opacity-40"
          aria-label="Next page"
        >
          <ChevronRight size={14} />
        </button>
        <span className="mx-1 h-4 w-px bg-border" />
        <button
          type="button"
          onClick={() => stepZoom(-1)}
          className="rounded p-1 text-content-secondary hover:bg-surface-secondary"
          aria-label="Zoom out"
        >
          <ZoomOut size={14} />
        </button>
        <span className="text-[11px] tabular-nums text-content-secondary w-10 text-center">
          {Math.round(zoom * 100)}%
        </span>
        <button
          type="button"
          onClick={() => stepZoom(1)}
          className="rounded p-1 text-content-secondary hover:bg-surface-secondary"
          aria-label="Zoom in"
        >
          <ZoomIn size={14} />
        </button>
        <button
          type="button"
          onClick={fitWidth}
          className="rounded p-1 text-content-secondary hover:bg-surface-secondary"
          aria-label="Fit page width"
          title="Fit page width"
        >
          <Maximize2 size={14} />
        </button>
        <button
          type="button"
          onClick={onClose}
          className="ml-auto rounded p-1 text-content-tertiary hover:bg-surface-secondary hover:text-content-primary"
          aria-label="Close split view"
          title="Close split view"
        >
          <X size={14} />
        </button>
      </div>
      {/* Pane canvas: native scroll = pan; Ctrl+wheel = zoom. */}
      <div ref={scrollRef} className="relative flex min-h-0 flex-1 overflow-auto">
        <div className="relative m-auto shrink-0">
          <canvas ref={canvasRef} className="block rounded-[2px] shadow-sm" />
          <canvas ref={overlayRef} className="pointer-events-none absolute inset-0" />
        </div>
      </div>
    </div>
  );
}
/** Thick horizontal drag handle below the bottom page-navigation bar
 *  (VS Code terminal style): a visible line with an up/down chevron pill.
 *  Drag down (or click) to collapse the bottom bar into this slim strip;
 *  drag up (or click) to expand it back. */
function BottomCollapseHandle({
  collapsed,
  onToggle,
}: {
  collapsed: boolean;
  onToggle: () => void;
}) {
  const dragRef = useRef<{ startY: number; pointerId: number; moved: boolean } | null>(null);
  const Icon = collapsed ? ChevronsUp : ChevronsDown;
  return (
    <div
      role="separator"
      aria-orientation="horizontal"
      aria-label={collapsed ? 'Expand the page navigation bar' : 'Collapse the page navigation bar'}
      title={collapsed ? 'Drag up or click to expand the page bar' : 'Drag down or click to collapse the page bar'}
      tabIndex={0}
      data-testid="takeoff-bottom-collapse-handle"
      onPointerDown={(e) => {
        e.preventDefault();
        e.currentTarget.setPointerCapture?.(e.pointerId);
        dragRef.current = { startY: e.clientY, pointerId: e.pointerId, moved: false };
      }}
      onPointerMove={(e) => {
        const d = dragRef.current;
        if (!d || e.pointerId !== d.pointerId) return;
        const dy = e.clientY - d.startY;
        if (Math.abs(dy) > 4) d.moved = true;
        if (!collapsed && dy > 24) {
          onToggle();
          dragRef.current = null;
        } else if (collapsed && dy < -24) {
          onToggle();
          dragRef.current = null;
        }
      }}
      onPointerUp={() => {
        const d = dragRef.current;
        dragRef.current = null;
        // A no-drag press is a click: toggle.
        if (d && !d.moved) onToggle();
      }}
      onKeyDown={(e) => {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowUp' || e.key === 'ArrowDown') {
          e.preventDefault();
          onToggle();
        }
      }}
      className="group relative h-3.5 shrink-0 cursor-row-resize touch-none select-none"
    >
      {/* Thick line */}
      <div
        aria-hidden="true"
        className="absolute inset-x-6 top-1/2 h-[3px] -translate-y-1/2 rounded-full bg-border transition-colors group-hover:bg-oe-blue/70"
      />
      {/* Up/down indication pill */}
      <div
        aria-hidden="true"
        className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-border bg-surface-elevated px-2 py-0.5 shadow-xs transition-all group-hover:border-oe-blue"
      >
        <Icon size={12} className="text-content-tertiary transition-colors group-hover:text-oe-blue" />
      </div>
    </div>
  );
}

/** Horizontal drag grip on the top edge of the bottom ledger bar. Works
 *  like the side-panel grips rotated 90 degrees: drag up/down to resize,
 *  drag to the bottom edge to collapse, double-click to reset, arrow keys
 *  to nudge. */
function LedgerResizeHandle({
  testId,
  label,
  onPointerDown,
  onDoubleClick,
  onKeyDown,
}: {
  testId: string;
  label: string;
  onPointerDown: (e: ReactPointerEvent<HTMLDivElement>) => void;
  onDoubleClick: () => void;
  onKeyDown: (e: ReactKeyboardEvent<HTMLDivElement>) => void;
}) {
  return (
    <div
      role="separator"
      aria-orientation="horizontal"
      aria-label={label}
      title={label}
      tabIndex={0}
      data-testid={testId}
      onPointerDown={onPointerDown}
      onDoubleClick={onDoubleClick}
      onKeyDown={onKeyDown}
      className="group relative h-4 shrink-0 cursor-row-resize touch-none select-none"
    >
      {/* Thick line */}
      <div
        aria-hidden="true"
        className="absolute inset-x-6 top-1/2 h-[3px] -translate-y-1/2 rounded-full bg-border transition-colors group-hover:bg-oe-blue/70"
      />
      {/* Up/down indication pill */}
      <div
        aria-hidden="true"
        className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-border bg-surface-elevated px-2 py-0.5 shadow-xs transition-all group-hover:border-oe-blue"
      >
        <ChevronsUpDown size={12} className="text-content-tertiary transition-colors group-hover:text-oe-blue" />
      </div>
    </div>
  );
}

/** Slim strip left behind when the ledger bar is collapsed: the visible
 *  indication of where it went. Click reopens at the last height; dragging
 *  up extends it from zero. */
function LedgerCollapsedStrip({
  onPointerDown,
  onKeyDown,
  reopenLabel,
}: {
  onPointerDown: (e: ReactPointerEvent<HTMLDivElement>) => void;
  onKeyDown: (e: ReactKeyboardEvent<HTMLDivElement>) => void;
  reopenLabel: string;
}) {
  return (
    <div
      role="separator"
      aria-orientation="horizontal"
      aria-label={reopenLabel}
      title={reopenLabel}
      tabIndex={0}
      data-testid="takeoff-ledger-collapsed"
      onPointerDown={onPointerDown}
      onKeyDown={onKeyDown}
      className="group relative h-4 shrink-0 cursor-row-resize touch-none select-none rounded-md border border-dashed border-border bg-surface-primary/60 transition-colors hover:border-oe-blue hover:bg-oe-blue/5 focus-visible:outline-none focus-visible:border-oe-blue"
    >
      <div
        aria-hidden="true"
        className="absolute inset-x-6 top-1/2 h-[3px] -translate-y-1/2 rounded-full bg-border transition-colors group-hover:bg-oe-blue/70"
      />
      <div
        aria-hidden="true"
        className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-border bg-surface-elevated px-2 py-0.5 shadow-xs transition-all group-hover:border-oe-blue"
      >
        <ChevronsUp size={12} className="text-content-tertiary transition-colors group-hover:text-oe-blue" />
      </div>
    </div>
  );
}

/** Vertical drag grip rendered between the canvas column and a side panel.
 *  A 16px hit area (comfortable on touch) with a centred grip pill, so the
 *  handle is easy to grab in the middle of the divider. Dragging the strip
 *  to its outer edge collapses it to zero; double-click resets the panel to
 *  its default width; arrow keys nudge it for keyboard users. */
function TakeoffResizeHandle({
  testId,
  label,
  onPointerDown,
  onDoubleClick,
  onKeyDown,
}: {
  testId: string;
  label: string;
  onPointerDown: (e: ReactPointerEvent<HTMLDivElement>) => void;
  onDoubleClick: () => void;
  onKeyDown: (e: ReactKeyboardEvent<HTMLDivElement>) => void;
}) {
  return (
    <div
      role="separator"
      aria-orientation="vertical"
      aria-label={label}
      title={label}
      tabIndex={0}
      data-testid={testId}
      onPointerDown={onPointerDown}
      onDoubleClick={onDoubleClick}
      onKeyDown={onKeyDown}
      className="group relative w-4 shrink-0 cursor-col-resize touch-none select-none focus-visible:outline-none"
    >
      {/* hairline track */}
      <div
        aria-hidden="true"
        className="absolute inset-y-1 left-1/2 w-px -translate-x-1/2 bg-border transition-colors group-hover:bg-oe-blue group-focus-visible:bg-oe-blue group-active:bg-oe-blue"
      />
      {/* grip pill, vertically centred */}
      <div
        aria-hidden="true"
        className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-border bg-surface-elevated px-0.5 py-2 shadow-xs transition-all group-hover:border-oe-blue group-hover:shadow-sm group-active:border-oe-blue"
      >
        <GripVertical size={12} className="text-content-tertiary transition-colors group-hover:text-oe-blue group-active:text-oe-blue" />
      </div>
    </div>
  );
}

/**
 * Whole-word spelling fixes for document names typed in the export dialog.
 * Deliberately small and safe: every key is an unambiguous misspelling, and
 * matching is whole-word only (lowercased), so real words are never rewritten.
 * OE-DELIVERY 2026-10-27-export-proposal.
 */
const PROPOSAL_NAME_SPELLING_FIXES: Record<string, string> = {
  propasal: 'proposal',
  propsal: 'proposal',
  proposl: 'proposal',
  porposal: 'proposal',
  quatation: 'quotation',
  quotaton: 'quotation',
  quottion: 'quotation',
  quotatoin: 'quotation',
  estiamte: 'estimate',
  estimte: 'estimate',
  estmate: 'estimate',
  documnet: 'document',
  documnt: 'document',
  reciept: 'receipt',
  seperate: 'separate',
  submittl: 'submittal',
};

/**
 * Deterministic document-name cleanup for the Proposal+Quotation export.
 * No AI involved: trim, collapse whitespace, drop a trailing ".pdf" (the
 * export appends it), strip filename-illegal characters, apply the
 * whole-word spelling map, then Title Case (first letter of each word
 * capital, the rest small). Returns '' when nothing usable remains.
 */
function correctDocumentName(raw: string): string {
  const collapsed = raw.replace(/\s+/g, ' ').trim();
  if (!collapsed) return '';
  const withoutExt = collapsed.replace(/\.pdf$/i, '');
  const words = withoutExt
    .split(' ')
    .map((word) => {
      const cleaned = word.replace(/[/\\:*?"<>|\x00-\x1f]/g, '');
      if (!cleaned) return '';
      const lower = cleaned.toLowerCase();
      const fixed = PROPOSAL_NAME_SPELLING_FIXES[lower] ?? lower;
      return fixed.charAt(0).toUpperCase() + fixed.slice(1);
    })
    .filter((w) => w.length > 0);
  return words.join(' ').replace(/^[.\s]+|[.\s]+$/g, '');
}

export default function TakeoffViewerModule({
  initialPdfUrl,
  initialPdfName,
  initialDocumentId,
  initialMeasurementId,
  initialPage,
  onPageChange,
  recentDocuments,
  onOpenRecentDocument,
}: TakeoffViewerModuleProps = {}) {
  const { t, i18n } = useTranslation();

  // PDF state
  const [pdfDoc, setPdfDoc] = useState<PDFDocumentProxy | null>(null);
  const [currentPage, setCurrentPage] = useState(1);
  const [totalPages, setTotalPages] = useState(0);
  /** PDF page labels (e.g. "T1.0") indexed by 0-based page; null when the
   *  document has none. Fetched after each PDF load; shown in the ledger's
   *  Page Label column. */
  const [pageLabels, setPageLabels] = useState<string[] | null>(null);
  /** Fetch the PDF's page labels (sheet names like "T1.0") for the ledger's
   *  Page Label column. Resolves to null when the document has none. */
  const refreshPageLabels = useCallback(async (doc: PDFDocumentProxy) => {
    try {
      const labels = await doc.getPageLabels();
      setPageLabels(Array.isArray(labels) && labels.length > 0 ? labels : null);
    } catch {
      setPageLabels(null);
    }
  }, []);
  const [zoom, setZoom] = useState(1.0);
  /* Current zoom for handlers that need it without re-subscribing. */
  const zoomRef = useRef(zoom);
  zoomRef.current = zoom;
  /* ── Debounced render zoom (ultra-smooth wheel zoom) ────────────────
   * A wheel-zoom gesture fires dozens of ticks; re-rendering the full PDF
   * bitmap on every tick makes zooming feel steppy on heavy drawings.
   * `zoom` stays live (cursor anchoring, % readout, measurement overlay all
   * track it instantly) while `renderZoom` trails it by ~150ms — the canvas
   * element CSS-scales the last bitmap during the gesture (GPU, smooth) and
   * the crisp bitmap re-renders once the gesture settles. */
  const [renderZoom, setRenderZoom] = useState(1.0);
  const renderZoomRef = useRef(renderZoom);
  renderZoomRef.current = renderZoom;
  useEffect(() => {
    if (renderZoom === zoom) return;
    const t = window.setTimeout(() => setRenderZoom(zoom), 150);
    return () => window.clearTimeout(t);
  }, [zoom, renderZoom]);
  const [isLoading, setIsLoading] = useState(false);
  /** Download progress % while a server PDF loads (range-request streaming). Null when idle. */
  const [loadProgress, setLoadProgress] = useState<number | null>(null);

  /* ── Page thumbnails sidebar ──────────────────────────────────────────
   * A left strip of small page previews for multi-page sets (click to jump,
   * current page highlighted, per-page measurement badge). Pure render maths
   * live in features/takeoff/lib/takeoff-thumbnails.ts; this state only drives
   * the strip. Thumbnails render into throwaway offscreen canvases (never the
   * live canvas/overlay) so they cannot disturb the main page render. */
  const [showThumbnails, setShowThumbnails] = useState<boolean>(() => {
    try {
      return localStorage.getItem('takeoff.showThumbnails') !== 'false';
    } catch {
      return true;
    }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.showThumbnails', String(showThumbnails)); } catch { /* ignore */ }
  }, [showThumbnails]);
  /** Collapse the right Properties/Ledger sidebar for a near-full-viewport
   *  measuring mode, mirroring the Pages strip toggle (#315). Persisted. */
  const [showSidebar, setShowSidebar] = useState<boolean>(() => {
    try {
      return localStorage.getItem('takeoff.showSidebar') !== 'false';
    } catch {
      return true;
    }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.showSidebar', String(showSidebar)); } catch { /* ignore */ }
  }, [showSidebar]);
  /** Mirror of showSidebar so the keydown handler can tell whether the panel is
   *  collapsed (#315) without joining the handler's dependency array. */
  const showSidebarRef = useRef(showSidebar);
  showSidebarRef.current = showSidebar;

  /* ── Resizable side panels + fullscreen measuring mode ──────────────── */
  const viewerRootRef = useRef<HTMLDivElement>(null);
  const [isTakeoffFullscreen, setIsTakeoffFullscreen] = useState(false);
  const [leftStripWidth, setLeftStripWidth] = useState<number>(() =>
    readPanelWidth(LEFT_STRIP_KEY, LEFT_STRIP_DEFAULT, LEFT_STRIP_MIN, LEFT_STRIP_MAX));
  const [rightPanelWidth, setRightPanelWidth] = useState<number>(() =>
    readPanelWidth(RIGHT_PANEL_KEY, RIGHT_PANEL_DEFAULT, RIGHT_PANEL_MIN, RIGHT_PANEL_MAX));
  /** Live mirrors so the pointer handlers always read fresh widths without
   *  re-subscribing (same pattern as showSidebarRef above). */
  const leftStripWidthRef = useRef(leftStripWidth);
  leftStripWidthRef.current = leftStripWidth;
  const rightPanelWidthRef = useRef(rightPanelWidth);
  rightPanelWidthRef.current = rightPanelWidth;
  /** Last non-collapsed widths, so reopening (toolbar, tab click, or a
   *  no-drag click on the collapsed tab) restores the previous size. */
  const lastOpenLeftWidthRef = useRef(leftStripWidth);
  const lastOpenRightWidthRef = useRef(rightPanelWidth);

  const persistPanelWidth = useCallback((side: 'left' | 'right', w: number) => {
    try {
      localStorage.setItem(side === 'left' ? LEFT_STRIP_KEY : RIGHT_PANEL_KEY, String(Math.round(w)));
    } catch { /* ignore */ }
  }, []);

  /** Pointer-drag state for the resize grips. A single window-level
   *  move/up listener pair (registered once) drives whichever grip started
   *  the drag, so rapid drags never lose the pointer. */
  const resizeDragRef = useRef<{
    side: 'left' | 'right';
    pointerId: number;
    startX: number;
    startWidth: number;
    rtl: boolean;
    latest: number;
    /** True when the drag started on a collapsed edge tab (from zero). */
    fromCollapsed: boolean;
    /** True once the pointer actually moved (distinguishes click). */
    moved: boolean;
  } | null>(null);

  useEffect(() => {
    const onMove = (ev: PointerEvent) => {
      const d = resizeDragRef.current;
      if (!d || ev.pointerId !== d.pointerId) return;
      const dx = ev.clientX - d.startX;
      if (Math.abs(dx) > 4) d.moved = true;
      // LTR: the left strip widens dragging right (+dx), the right panel
      // widens dragging left (-dx). RTL mirrors the visual order, so both
      // signs flip. Dragging a strip to its outer edge collapses it: below
      // the threshold the width snaps to zero, and on release the panel
      // hides so the canvas claims the space.
      const dir = d.side === 'left' ? 1 : -1;
      const signed = (d.rtl ? -dir : dir) * dx;
      const max = d.side === 'left' ? LEFT_STRIP_MAX : RIGHT_PANEL_MAX;
      const raw = d.startWidth + signed;
      const clamped = raw < COLLAPSE_THRESHOLD ? 0 : Math.min(max, Math.max(0, raw));
      d.latest = clamped;
      if (clamped >= COLLAPSE_THRESHOLD) {
        if (d.side === 'left') lastOpenLeftWidthRef.current = clamped;
        else lastOpenRightWidthRef.current = clamped;
      }
      if (d.side === 'left') setLeftStripWidth(clamped);
      else setRightPanelWidth(clamped);
    };
    const onUp = (ev: PointerEvent) => {
      const d = resizeDragRef.current;
      if (!d || ev.pointerId !== d.pointerId) return;
      resizeDragRef.current = null;
      document.body.style.cursor = '';
      if (d.fromCollapsed && !d.moved) {
        // Treated as a click on the collapsed tab: reopen at the last width.
        if (d.side === 'left') setLeftStripWidth(lastOpenLeftWidthRef.current);
        else setRightPanelWidth(lastOpenRightWidthRef.current);
        return;
      }
      if (!d.fromCollapsed && !d.moved) {
        // Treated as a click on the OPEN resize bar: collapse the panel.
        // The width stays in state, so reopening restores the recent size.
        if (d.side === 'left') setShowThumbnails(false);
        else setShowSidebar(false);
        return;
      }
      if (d.latest < COLLAPSE_THRESHOLD) {
        // Snapped shut: hide the panel but keep the pre-drag width in
        // state, so reopening from the toolbar restores it.
        if (d.side === 'left') {
          setLeftStripWidth(d.startWidth);
          setShowThumbnails(false);
        } else {
          setRightPanelWidth(d.startWidth);
          setShowSidebar(false);
        }
      } else {
        persistPanelWidth(d.side, d.latest);
      }
    };
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
    window.addEventListener('pointercancel', onUp);
    return () => {
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onUp);
    };
  }, [persistPanelWidth]);

  const beginPanelResize = useCallback((side: 'left' | 'right', startWidthOverride?: number) =>
    (e: ReactPointerEvent<HTMLDivElement>) => {
      if (resizeDragRef.current) return;
      e.preventDefault();
      e.currentTarget.setPointerCapture?.(e.pointerId);
      const startWidth = startWidthOverride ?? (side === 'left' ? leftStripWidthRef.current : rightPanelWidthRef.current);
      resizeDragRef.current = {
        side,
        pointerId: e.pointerId,
        startX: e.clientX,
        startWidth,
        rtl: typeof document !== 'undefined' && document.documentElement.dir === 'rtl',
        latest: startWidth,
        fromCollapsed: startWidthOverride !== undefined,
        moved: false,
      };
      document.body.style.cursor = 'col-resize';
    }, []);

  /** Start a drag from a collapsed edge tab: reopen the panel at zero width
   *  and let the same gesture extend it. A no-move click reopens at the
   *  last width (handled in the shared pointer-up). */
  const beginCollapsedDrag = useCallback((side: 'left' | 'right') =>
    (e: ReactPointerEvent<HTMLDivElement>) => {
      if (side === 'left') {
        setLeftStripWidth(0);
        setShowThumbnails(true);
      } else {
        setRightPanelWidth(0);
        setShowSidebar(true);
      }
      beginPanelResize(side, 0)(e);
    }, [beginPanelResize]);

  /** Reopen a collapsed panel at its last width (tab keyboard / click). */
  const reopenCollapsedPanel = useCallback((side: 'left' | 'right') => {
    if (side === 'left') {
      setLeftStripWidth(lastOpenLeftWidthRef.current);
      setShowThumbnails(true);
    } else {
      setRightPanelWidth(lastOpenRightWidthRef.current);
      setShowSidebar(true);
    }
  }, []);

  const onCollapsedTabKeyDown = useCallback((side: 'left' | 'right') =>
    (e: ReactKeyboardEvent<HTMLDivElement>) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        reopenCollapsedPanel(side);
      }
    }, [reopenCollapsedPanel]);

  const resetPanelWidth = useCallback((side: 'left' | 'right') => {
    if (side === 'left') {
      setLeftStripWidth(LEFT_STRIP_DEFAULT);
      lastOpenLeftWidthRef.current = LEFT_STRIP_DEFAULT;
      persistPanelWidth('left', LEFT_STRIP_DEFAULT);
    } else {
      setRightPanelWidth(RIGHT_PANEL_DEFAULT);
      lastOpenRightWidthRef.current = RIGHT_PANEL_DEFAULT;
      persistPanelWidth('right', RIGHT_PANEL_DEFAULT);
    }
  }, [persistPanelWidth]);

  /* ── Bottom ledger bar: vertical resize, mirroring the side panels ─── */
  const [showLedger, setShowLedger] = useState<boolean>(() => {
    try { return localStorage.getItem(LEDGER_SHOW_KEY) !== '0'; } catch { return true; }
  });
  const [ledgerHeight, setLedgerHeight] = useState<number>(() =>
    readPanelWidth(LEDGER_HEIGHT_KEY, LEDGER_DEFAULT, LEDGER_MIN, LEDGER_MAX));
  useEffect(() => {
    try { localStorage.setItem(LEDGER_SHOW_KEY, showLedger ? '1' : '0'); } catch { /* ignore */ }
  }, [showLedger]);
  const ledgerHeightRef = useRef(ledgerHeight);
  ledgerHeightRef.current = ledgerHeight;
  /** Last non-collapsed height, for reopening at the previous size. */
  const lastOpenLedgerHeightRef = useRef(ledgerHeight);

  const ledgerDragRef = useRef<{
    pointerId: number;
    startY: number;
    startHeight: number;
    latest: number;
    fromCollapsed: boolean;
    moved: boolean;
  } | null>(null);

  useEffect(() => {
    const onMove = (ev: PointerEvent) => {
      const d = ledgerDragRef.current;
      if (!d || ev.pointerId !== d.pointerId) return;
      // Dragging up grows the ledger, dragging down shrinks it. Below the
      // threshold it snaps to zero; on release the bar hides to a slim
      // strip so the canvas claims the space.
      const dy = d.startY - ev.clientY;
      if (Math.abs(ev.clientY - d.startY) > 4) d.moved = true;
      const raw = d.startHeight + dy;
      const clamped = raw < LEDGER_COLLAPSE_THRESHOLD ? 0 : Math.min(LEDGER_MAX, Math.max(0, raw));
      d.latest = clamped;
      if (clamped >= LEDGER_COLLAPSE_THRESHOLD) lastOpenLedgerHeightRef.current = clamped;
      setLedgerHeight(clamped);
    };
    const onUp = (ev: PointerEvent) => {
      const d = ledgerDragRef.current;
      if (!d || ev.pointerId !== d.pointerId) return;
      ledgerDragRef.current = null;
      document.body.style.cursor = '';
      if (d.fromCollapsed && !d.moved) {
        // Treated as a click on the collapsed strip: reopen at last height.
        setLedgerHeight(lastOpenLedgerHeightRef.current);
        return;
      }
      if (!d.moved) {
        // Click on the OPEN ledger bar: collapse, keeping the height so
        // reopening restores the recent size.
        setShowLedger(false);
        return;
      }
      if (d.latest < LEDGER_COLLAPSE_THRESHOLD) {
        // Snapped shut: hide but keep the pre-drag height, so reopening
        // restores it.
        setLedgerHeight(d.startHeight);
        setShowLedger(false);
      } else {
        try { localStorage.setItem(LEDGER_HEIGHT_KEY, String(Math.round(d.latest))); } catch { /* ignore */ }
      }
    };
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
    window.addEventListener('pointercancel', onUp);
    return () => {
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onUp);
    };
  }, []);

  const beginLedgerResize = useCallback((startHeightOverride?: number) =>
    (e: ReactPointerEvent<HTMLDivElement>) => {
      if (ledgerDragRef.current) return;
      e.preventDefault();
      e.currentTarget.setPointerCapture?.(e.pointerId);
      const startHeight = startHeightOverride ?? ledgerHeightRef.current;
      ledgerDragRef.current = {
        pointerId: e.pointerId,
        startY: e.clientY,
        startHeight,
        latest: startHeight,
        fromCollapsed: startHeightOverride !== undefined,
        moved: false,
      };
      document.body.style.cursor = 'row-resize';
    }, []);

  /** Drag from the collapsed strip: reopen at zero height, extend upward. */
  const beginLedgerCollapsedDrag = useCallback(
    (e: ReactPointerEvent<HTMLDivElement>) => {
      setLedgerHeight(0);
      setShowLedger(true);
      beginLedgerResize(0)(e);
    },
    [beginLedgerResize],
  );

  const reopenLedger = useCallback(() => {
    setLedgerHeight(lastOpenLedgerHeightRef.current);
    setShowLedger(true);
  }, []);

  const onLedgerHandleKeyDown = useCallback((e: ReactKeyboardEvent<HTMLDivElement>) => {
    let delta = 0;
    if (e.key === 'ArrowUp') delta = 16;
    else if (e.key === 'ArrowDown') delta = -16;
    else return;
    e.preventDefault();
    const next = ledgerHeightRef.current + delta;
    if (next < LEDGER_COLLAPSE_THRESHOLD) {
      setShowLedger(false);
    } else {
      const c = Math.min(LEDGER_MAX, Math.max(0, next));
      setLedgerHeight(c);
      lastOpenLedgerHeightRef.current = c;
      try { localStorage.setItem(LEDGER_HEIGHT_KEY, String(Math.round(c))); } catch { /* ignore */ }
    }
  }, []);

  const onLedgerCollapsedKeyDown = useCallback(
    (e: ReactKeyboardEvent<HTMLDivElement>) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowUp') {
        e.preventDefault();
        reopenLedger();
      }
    },
    [reopenLedger],
  );

  const resetLedgerHeight = useCallback(() => {
    setLedgerHeight(LEDGER_DEFAULT);
    lastOpenLedgerHeightRef.current = LEDGER_DEFAULT;
    try { localStorage.setItem(LEDGER_HEIGHT_KEY, String(LEDGER_DEFAULT)); } catch { /* ignore */ }
  }, []);

  const onResizeHandleKeyDown = useCallback((side: 'left' | 'right') =>
    (e: ReactKeyboardEvent<HTMLDivElement>) => {
      const rtl = typeof document !== 'undefined' && document.documentElement.dir === 'rtl';
      let delta = 0;
      if (e.key === 'ArrowLeft') delta = -16;
      else if (e.key === 'ArrowRight') delta = 16;
      else return;
      e.preventDefault();
      const dir = side === 'left' ? 1 : -1;
      const signed = (rtl ? -dir : dir) * delta;
      if (side === 'left') {
        const next = leftStripWidthRef.current + signed;
        if (next < COLLAPSE_THRESHOLD) {
          setShowThumbnails(false);
        } else {
          const c = Math.min(LEFT_STRIP_MAX, Math.max(0, next));
          setLeftStripWidth(c);
          lastOpenLeftWidthRef.current = c;
          persistPanelWidth('left', c);
        }
      } else {
        const next = rightPanelWidthRef.current + signed;
        if (next < COLLAPSE_THRESHOLD) {
          setShowSidebar(false);
        } else {
          const c = Math.min(RIGHT_PANEL_MAX, Math.max(0, next));
          setRightPanelWidth(c);
          lastOpenRightWidthRef.current = c;
          persistPanelWidth('right', c);
        }
      }
    }, [persistPanelWidth]);

  /* ── Fullscreen measuring mode ────────────────────────────────────────
   * Expands the whole viewer row (strips + canvas) to the viewport, the
   * same requestFullscreen pattern as the BIM federated viewer. The canvas
   * column is flex-sized, so it claims the extra space automatically. */
  const toggleTakeoffFullscreen = useCallback(() => {
    const el = viewerRootRef.current;
    if (!el) return;
    if (document.fullscreenElement) {
      void document.exitFullscreen?.();
    } else {
      void el.requestFullscreen?.();
    }
  }, []);

  useEffect(() => {
    const onFullscreenChange = () => {
      const isFs = document.fullscreenElement === viewerRootRef.current;
      setIsTakeoffFullscreen(isFs);
      // Step 1: only the function key (F11) should exit fullscreen, not ESC.
      // Browsers reserve ESC to leave fullscreen and it cannot be
      // preventDefault-ed; the Keyboard Lock API (Chromium) lets a fullscreen
      // element capture ESC so a plain press does nothing (hold ESC still
      // exits as a browser safety). Other browsers fall back to native
      // ESC-exits-fullscreen behaviour.
      try {
        const kb = (navigator as unknown as {
          keyboard?: { lock?: (keys: string[]) => Promise<void>; unlock?: () => void };
        }).keyboard;
        if (isFs) {
          void kb?.lock?.(['Escape'])?.catch?.(() => {});
        } else {
          kb?.unlock?.();
        }
      } catch { /* Keyboard Lock API unavailable - native behaviour */ }
    };
    document.addEventListener('fullscreenchange', onFullscreenChange);
    return () => document.removeEventListener('fullscreenchange', onFullscreenChange);
  }, []);

  /* ── F11 toggles the measurement fullscreen (in addition to Esc, which
   *  the browser reserves for exiting fullscreen). preventDefault stops
   *  the browser's own F11 fullscreen so ours wins. */
  useEffect(() => {
    if (!pdfDoc) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'F11') {
        e.preventDefault();
        toggleTakeoffFullscreen();
      }
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [pdfDoc, toggleTakeoffFullscreen]);

  /* ── Page view mode: single page vs continuous scroll ─────────────────
   *  Continuous stacks every page vertically in the scroll container; the
   *  measurement overlay rides on the active (most-visible) page. */
  const [pageMode, setPageMode] = useState<'single' | 'continuous'>(() => {
    try {
      return localStorage.getItem('takeoff.pageMode') === 'continuous' ? 'continuous' : 'single';
    } catch {
      return 'single';
    }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.pageMode', pageMode); } catch { /* ignore */ }
  }, [pageMode]);
  const pageModeRef = useRef(pageMode);
  pageModeRef.current = pageMode;

  /* Split-screen view (Bluebeam-style): a second independent read-only pane
   * showing the same PDF. 'vertical' = panes side by side, 'horizontal' =
   * panes stacked. The second pane has its own page + zoom. */
  const [splitMode, setSplitMode] = useState<'off' | 'horizontal' | 'vertical'>('off');
  const [splitPage, setSplitPage] = useState(1);
  const [splitZoom, setSplitZoom] = useState(1);

  /** Toggle split mode; when opening, park the second pane on a different
   *  page than the main view so the two views start out distinct. */
  const toggleSplit = (mode: 'horizontal' | 'vertical') => {
    setSplitMode((prev) => {
      if (prev === mode) return 'off';
      const total = totalPages || 1;
      const cur = currentPageRef.current || 1;
      setSplitPage(cur < total ? cur + 1 : Math.max(1, cur - 1));
      setSplitZoom(1);
      return mode;
    });
  };
  /** One canvas per page in continuous mode. */
  const continuousCanvasesRef = useRef<(HTMLCanvasElement | null)[]>([]);
  /** Wrapper around the page canvas(es) - the CSS-transform smooth zoom
   *  target and the safe-centering box. */
  const zoomWrapRef = useRef<HTMLDivElement>(null);
  /** Top offset (px) of the measurement overlay inside the wrapper: 0 in
   *  single mode, the active page's top in continuous mode. */
  const [overlayTop, setOverlayTop] = useState(0);

  /** Bottom pager input text, mirrored from currentPage. */
  const [pageInput, setPageInput] = useState('1');
  useEffect(() => {
    setPageInput(String(currentPage));
  }, [currentPage]);
  /** Zoom slider popover open state. */
  const [zoomMenuOpen, setZoomMenuOpen] = useState(false);
  /** Independently hide the on-canvas measurement name badges and the dimension
   *  values, so a dense sheet can be decluttered without hiding geometry; the
   *  numbers stay in the Ledger and hover tooltip either way (#314). Persisted. */
  const [showLabels, setShowLabels] = useState<boolean>(() => {
    try {
      return localStorage.getItem('takeoff.showLabels') !== 'false';
    } catch {
      return true;
    }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.showLabels', String(showLabels)); } catch { /* ignore */ }
  }, [showLabels]);
  const [showDimensions, setShowDimensions] = useState<boolean>(() => {
    try {
      return localStorage.getItem('takeoff.showDimensions') !== 'false';
    } catch {
      return true;
    }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.showDimensions', String(showDimensions)); } catch { /* ignore */ }
  }, [showDimensions]);
  /* ── Markup label appearance ───────────────────────────────────────
   * The centered three-line label stack (name + material + dimension)
   * drawn above distance/polyline markups. Size, colours and per-field
   * visibility are workspace prefs. */
  const [labelTextSize, setLabelTextSize] = useState<number>(() => {
    try {
      const v = Number(localStorage.getItem('takeoff.labelTextSize'));
      return Number.isFinite(v) && v >= 8 && v <= 32 ? v : 13;
    } catch { return 13; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelTextSize', String(labelTextSize)); } catch { /* ignore */ }
  }, [labelTextSize]);
  /** Material-line size (defaults to 88% of the name size, Bluebeam-like). */
  const [labelMaterialSize, setLabelMaterialSize] = useState<number>(() => {
    try {
      const v = Number(localStorage.getItem('takeoff.labelMaterialSize'));
      return Number.isFinite(v) && v >= 8 && v <= 32 ? v : 11;
    } catch { return 11; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelMaterialSize', String(labelMaterialSize)); } catch { /* ignore */ }
  }, [labelMaterialSize]);
  /** Dimension-line size. */
  const [labelDimSize, setLabelDimSize] = useState<number>(() => {
    try {
      const v = Number(localStorage.getItem('takeoff.labelDimSize'));
      return Number.isFinite(v) && v >= 8 && v <= 32 ? v : 13;
    } catch { return 13; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelDimSize', String(labelDimSize)); } catch { /* ignore */ }
  }, [labelDimSize]);
  const [labelTextColor, setLabelTextColor] = useState<string>(() => {
    try { return localStorage.getItem('takeoff.labelTextColor') || '#ffffff'; }
    catch { return '#ffffff'; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelTextColor', labelTextColor); } catch { /* ignore */ }
  }, [labelTextColor]);
  /** Per-line text colours (default to the main label text colour). */
  const [labelNameColor, setLabelNameColor] = useState<string>(() => {
    try { return localStorage.getItem('takeoff.labelNameColor') || localStorage.getItem('takeoff.labelTextColor') || '#ffffff'; }
    catch { return '#ffffff'; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelNameColor', labelNameColor); } catch { /* ignore */ }
  }, [labelNameColor]);
  const [labelMaterialColor, setLabelMaterialColor] = useState<string>(() => {
    try { return localStorage.getItem('takeoff.labelMaterialColor') || localStorage.getItem('takeoff.labelTextColor') || '#ffffff'; }
    catch { return '#ffffff'; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelMaterialColor', labelMaterialColor); } catch { /* ignore */ }
  }, [labelMaterialColor]);
  const [labelDimColor, setLabelDimColor] = useState<string>(() => {
    try { return localStorage.getItem('takeoff.labelDimColor') || localStorage.getItem('takeoff.labelTextColor') || '#ffffff'; }
    catch { return '#ffffff'; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelDimColor', labelDimColor); } catch { /* ignore */ }
  }, [labelDimColor]);
  const [labelBgColor, setLabelBgColor] = useState<string>(() => {
    try { return localStorage.getItem('takeoff.labelBgColor') || '#111c2e'; }
    catch { return '#111c2e'; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelBgColor', labelBgColor); } catch { /* ignore */ }
  }, [labelBgColor]);
  /** Per-field label visibility: which lines of the floating stack render.
   *  The toolbar Names / Values toggles remain the master switches for
   *  their groups. */
  const [labelShowName, setLabelShowName] = useState<boolean>(() => {
    try { return localStorage.getItem('takeoff.labelShowName.v2') !== 'false'; }
    catch { return true; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelShowName.v2', String(labelShowName)); } catch { /* ignore */ }
  }, [labelShowName]);
  const [labelShowMaterial, setLabelShowMaterial] = useState<boolean>(() => {
    try { return localStorage.getItem('takeoff.labelShowMaterial') !== 'false'; }
    catch { return true; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelShowMaterial', String(labelShowMaterial)); } catch { /* ignore */ }
  }, [labelShowMaterial]);
  const [labelShowDimension, setLabelShowDimension] = useState<boolean>(() => {
    try { return localStorage.getItem('takeoff.labelShowDimension') !== 'false'; }
    catch { return true; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.labelShowDimension', String(labelShowDimension)); } catch { /* ignore */ }
  }, [labelShowDimension]);
  /** page number -> data-URL of a small rendered preview, lazily filled and
   *  LRU-capped (see capThumbCache) so a 300-page set never holds 300 bitmaps. */
  const [thumbs, setThumbs] = useState<Record<number, string>>({});
  /** Mirror of `thumbs` for the render loop to read which pages already have a
   *  bitmap without taking `thumbs` as an effect dependency (which would loop). */
  const thumbsRef = useRef(thumbs);
  thumbsRef.current = thumbs;
  /** in-flight guard so the render loop never renders the same page twice. */
  const thumbRenderQueueRef = useRef<Set<number>>(new Set());
  /** Lazy-load work list: pages whose thumbnail item scrolled near the
   *  viewport and still need a bitmap. Drained one page at a time. */
  const thumbPendingRef = useRef<Set<number>>(new Set());
  /** Pump-loop re-entry guard. */
  const thumbPumpRunningRef = useRef(false);
  /** Mirror so the thumbnail renderer never needs pdfDoc as an effect
   *  dependency (which would re-run the lazy loader). currentPageRef already
   *  exists further below in this component - reused, not redeclared. */
  const pdfDocRef = useRef(pdfDoc);
  pdfDocRef.current = pdfDoc;

  /* ── Find on sheet (text search) ──────────────────────────────────────
   * A search box over the current document's pdf.js text layer: lists matches
   * by page, click to jump+zoom and highlight on the canvas. The tricky
   * coordinate conversion (pdf.js bottom-left text space -> top-left overlay
   * space) is isolated + unit-tested in takeoff-textsearch.ts. Client-only. */
  const [searchOpen, setSearchOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [searchMatches, setSearchMatches] = useState<TextMatch[]>([]);
  // Detect tab marks: boxes + profile/length labels pushed up by the
  // DetectPanel and drawn by the SVG overlay over the sheet.
  const [detectMarks, setDetectMarks] = useState<{ id: string; page: number; rect: [number, number, number, number]; label: string; status: 'confirmed' | 'verify' | 'selected'; category: string; line: [number, number, number, number] | null; angle: number | null; lengthFt: number | null }[]>([]);
  const [detectPickMode, setDetectPickMode] = useState(false);
  const [detectDrag, setDetectDrag] = useState<{ kind: 'click' | 'marquee' | 'end' | 'dup' | 'move'; id?: string; end?: number; startX: number; startY: number; additive: boolean; moved?: boolean } | null>(null);
  const [detectMarquee, setDetectMarquee] = useState<{ x0: number; y0: number; x1: number; y1: number } | null>(null);
  const [detectDragLine, setDetectDragLine] = useState<{ id: string; line: [number, number, number, number] } | null>(null);
  const [detectDupGhost, setDetectDupGhost] = useState<{ line: [number, number, number, number] | null; rect: [number, number, number, number] | null; category: string } | null>(null);
  const DETECT_CATEGORY_COLORS: Record<string, string> = { beams: '#3B82F6', columns: '#A855F7', joists: '#F97316', studs: '#14B8A6', walls: '#EC4899', trusses: '#EF4444', area: '#22C55E', other: '#9CA3AF' };
  useEffect(() => {
    const onPick = (e: Event) => {
      const d = (e as CustomEvent).detail as { on?: boolean } | undefined;
      const on = Boolean(d?.on);
      setDetectPickMode(on);
      if (!on) {
        setDetectDrag(null);
        setDetectMarquee(null);
        setDetectDragLine(null);
        setDetectDupGhost(null);
      }
    };
    window.addEventListener('oe-detect:pickmode', onPick);
    return () => window.removeEventListener('oe-detect:pickmode', onPick);
  }, []);
  useEffect(() => {
    if (!detectPickMode) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setDetectPickMode(false);
        window.dispatchEvent(new CustomEvent('oe-detect:pickmode', { detail: { on: false, fromViewer: true } }));
      }
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [detectPickMode]);
  const detectEvtPos = (e: any) => {
    const r = (e.currentTarget as SVGSVGElement).getBoundingClientRect();
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  };
  const detectFmtLen = (ft: number) => {
    const totalIn = Math.round(ft * 12);
    return `${Math.floor(totalIn / 12)}'-${totalIn % 12}"`;
  };
  const detectSegSeg = (ax: number, ay: number, bx: number, by: number, cx: number, cy: number, dx: number, dy: number) => {
    const o1 = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
    const o2 = (bx - ax) * (dy - ay) - (by - ay) * (dx - ax);
    const o3 = (dx - cx) * (ay - cy) - (dy - cy) * (ax - cx);
    const o4 = (dx - cx) * (by - cy) - (dy - cy) * (bx - cx);
    return o1 * o2 < 0 && o3 * o4 < 0;
  };
  const detectSegHitsRect = (x1: number, y1: number, x2: number, y2: number, rx0: number, ry0: number, rx1: number, ry1: number) => {
    const inside = (x: number, y: number) => x >= rx0 && x <= rx1 && y >= ry0 && y <= ry1;
    if (inside(x1, y1) || inside(x2, y2)) return true;
    return (
      detectSegSeg(x1, y1, x2, y2, rx0, ry0, rx1, ry0) ||
      detectSegSeg(x1, y1, x2, y2, rx1, ry0, rx1, ry1) ||
      detectSegSeg(x1, y1, x2, y2, rx1, ry1, rx0, ry1) ||
      detectSegSeg(x1, y1, x2, y2, rx0, ry1, rx0, ry0)
    );
  };
  const detectMarkHitsRect = (m: { rect: number[]; line: number[] | null }, rx0: number, ry0: number, rx1: number, ry1: number) => {
    if (m.line && m.line.length === 4) {
      return detectSegHitsRect(m.line[0] * zoom, m.line[1] * zoom, m.line[2] * zoom, m.line[3] * zoom, rx0, ry0, rx1, ry1);
    }
    const [bx, by, bx2, by2] = m.rect;
    return !(bx2 * zoom < rx0 || bx * zoom > rx1 || by2 * zoom < ry0 || by * zoom > ry1);
  };
  const [activeMatchIdx, setActiveMatchIdx] = useState(-1);
  /** True while the debounced fan-out is scanning page text layers. */
  const [searchBusy, setSearchBusy] = useState(false);
  /** per-page extracted+placed text items so re-searching never re-fetches a
   *  page's text layer. Cleared when the document changes. */
  const textLayerCacheRef = useRef<Map<number, TextItem[]>>(new Map());
  // Term the latest find scan actually computed matches for. The AI
  // panel highlight bridge compares against this so it never resolves
  // a request from a previous term's stale matches.
  const scannedQueryRef = useRef('');
  // True while a panel-requested highlight is active: lets the find
  // scan run and the highlight boxes draw WITHOUT opening the Find
  // popup (the scan normally only runs while the popup is open).
  const panelHighlightRef = useRef(false);
  const searchInputRef = useRef<HTMLInputElement>(null);

  // Measurement state
  const [activeTool, setActiveTool] = useState<MeasureTool>('select');
  /** Bluebeam-style area tool settings popup: display units + depth + slope.
   *  Shown when the Area tool is active; depth/slope are stamped onto new
   *  area measurements. */
  const [areaLengthUnit, setAreaLengthUnit] = useState('mm');
  const [areaAreaUnit, setAreaAreaUnit] = useState('sf');
  const areaAreaUnitRef = useRef(areaAreaUnit);
  areaAreaUnitRef.current = areaAreaUnit;
  /** Anchor the area popup under the Area tool button. */
  const areaToolBtnRef = useRef<HTMLButtonElement | null>(null);
  const [areaPopupPos, setAreaPopupPos] = useState<{ left: number; top: number } | null>(null);
  /** User-dismissed the area popup via X or second Area-tool click. */
  const [areaPopupDismissed, setAreaPopupDismissed] = useState(false);

  const [areaVolumeUnit, setAreaVolumeUnit] = useState('cu m');
  const [areaDepth, setAreaDepth] = useState('0');
  const [areaDepthUnit, setAreaDepthUnit] = useState('mm');
  const [areaSlopeType, setAreaSlopeType] = useState<'Pitch' | 'Degree' | 'Grade'>('Degree');
  const [areaSlopeValue, setAreaSlopeValue] = useState('0');
  /** Pitch rise/run inputs (only used when slope type is Pitch). */
  const [areaPitchRise, setAreaPitchRise] = useState('0');
  const [areaPitchRun, setAreaPitchRun] = useState('12');
  /** Convert the area-popup depth to canonical metres. */
  const areaDepthMeters = (): number | undefined => {
    const v = parseFloat(areaDepth);
    if (!Number.isFinite(v) || v <= 0) return undefined;
    const toM: Record<string, number> = {
      mm: 0.001, cm: 0.01, m: 1, km: 1000,
      in: 0.0254, 'in"': 0.0254, ft: 0.3048, 'ft in"': 0.3048,
      yd: 0.9144, mi: 1609.34,
    };
    return v * (toM[areaDepthUnit] ?? 1);
  };
  /** Convert the area-popup slope (type + value) to a slope factor. */
  const areaSlopeFactor = (): number | undefined => {
    if (areaSlopeType === 'Pitch') {
      const rise = parseFloat(areaPitchRise);
      const run = parseFloat(areaPitchRun);
      if (!Number.isFinite(rise) || !Number.isFinite(run) || run <= 0 || rise < 0) return undefined;
      if (rise === 0) return undefined;
      const f = 1 / Math.cos(Math.atan(rise / run));
      return Number.isFinite(f) && f >= 1 ? f : undefined;
    }
    const v = parseFloat(areaSlopeValue);
    if (!Number.isFinite(v) || v <= 0) return undefined;
    if (areaSlopeType === 'Degree') return slopeFactorFromDegrees(v);
    // Grade (percent): factor = 1 / cos(atan(grade/100)).
    const f = 1 / Math.cos(Math.atan(v / 100));
    return Number.isFinite(f) && f >= 1 ? f : undefined;
  };
  /** Live-apply the popup's Depth/Slope to the currently selected area
   *  measurement(s), so edits reflect immediately on the canvas + ledger.
   *  Takes explicit values so input onChange handlers (where setState is
   *  async) apply the just-typed value, not the previous render's. */
  const applyDepthSlopeToSelection = (
    depthInput: string, depthUnit: string,
    slopeType: 'Pitch' | 'Degree' | 'Grade', slopeVal: string,
    pitchRise: string, pitchRun: string,
  ): void => {
    const sel = selectedMeasurementId;
    if (!sel) return;
    const dv = parseFloat(depthInput);
    const toM: Record<string, number> = {
      mm: 0.001, cm: 0.01, m: 1, km: 1000,
      in: 0.0254, 'in"': 0.0254, ft: 0.3048, 'ft in"': 0.3048,
      yd: 0.9144, mi: 1609.34,
    };
    const depth = Number.isFinite(dv) && dv > 0 ? dv * (toM[depthUnit] ?? 1) : undefined;
    let slope: number | undefined;
    if (slopeType === 'Pitch') {
      const rise = parseFloat(pitchRise);
      const run = parseFloat(pitchRun);
      if (Number.isFinite(rise) && Number.isFinite(run) && run > 0 && rise > 0) {
        const f = 1 / Math.cos(Math.atan(rise / run));
        if (Number.isFinite(f) && f >= 1) slope = f;
      }
    } else {
      const v = parseFloat(slopeVal);
      if (Number.isFinite(v) && v > 0) {
        slope = slopeType === 'Degree'
          ? slopeFactorFromDegrees(v)
          : (() => { const f = 1 / Math.cos(Math.atan(v / 100)); return Number.isFinite(f) && f >= 1 ? f : undefined; })();
      }
    }
    setMeasurements((prev) =>
      prev.map((m) =>
        m.id === sel && (m.type === 'area' || m.type === 'volume')
          ? { ...m, depth, slopeFactor: slope }
          : m,
      ),
    );
  };
  /** Convenience: re-apply current popup state to the selection. */
  const applyAreaPopupToSelection = (): void => {
    applyDepthSlopeToSelection(areaDepth, areaDepthUnit, areaSlopeType, areaSlopeValue, areaPitchRise, areaPitchRun);
  };

  const [measurements, setMeasurements] = useState<Measurement[]>([]);
  // Single ordered projection (issue #379): every paint-order consumer - the
  // canvas paint pass, the click hit-test, the sidebar list and the PDF export
  // - reads measurements through this so they always agree on which shape is on
  // top. A measurement with an explicit `order` sorts by it; one without falls
  // back to its array position (creation order, the stable #375 baseline), so
  // rows the user never reordered paint exactly as before.
  // Groups the user has pinned to a position (issues #393/#400). Authoritative:
  // the copy mirrored onto each measurement is a cache of this, and is read back
  // only when rehydrating a document. Empty until something pins, so an
  // untouched document stores nothing and every client derives the same bands.
  const [explicitGroupBands, setExplicitGroupBands] = useState<Record<string, number>>({});

  // Where each group's block sits relative to the other groups (issue #394).
  // A group used to have no position of its own: it rendered wherever its
  // earliest member happened to land in the flat paint order, so restacking one
  // measurement dragged its whole group with it. Bands give the group its own
  // slot; a pinned group keeps the band it was pinned at, and everything else
  // falls back to first appearance in the array (creation order), which no
  // per-measurement reorder can touch. Derived over the WHOLE document, not the
  // current page, because the band map is per document.
  const groupBandMap = useMemo(
    () => groupBands(measurements, explicitGroupBands),
    [measurements, explicitGroupBands],
  );
  const orderedMeasurements = useMemo(
    () => sortByPaintOrder(measurements, groupBandMap),
    [measurements, groupBandMap],
  );
  const [activePoints, setActivePoints] = useState<Point[]>([]);

  /** This page's measurements for the split pane's read-only overlay.
   *  Declared here (after orderedMeasurements) so the dep array can't hit
   *  the TDZ. */
  const splitPageMeasurements = useMemo(
    () => orderedMeasurements.filter((m) => m.page === splitPage),
    [orderedMeasurements, splitPage],
  );
  const [countLabel, setCountLabel] = useState(t('takeoff_viewer.default_count_label', { defaultValue: 'Element' }));
  // Focused/selected by Enter while the Count tool is armed, so the user can
  // rename the group and start a fresh count without hunting for the field (#308).
  const countLabelRef = useRef<HTMLInputElement | null>(null);

  // Scale - PER PAGE (per sheet). A multi-sheet drawing set has a different
  // scale per page (floor plan 1:50, site plan 1:500, ...), so the calibration
  // is keyed by 1-indexed page with a single document default for pages that
  // have not been calibrated yet. ``scale`` below is the effective scale for
  // the *current* page; the rest of the module reads it unchanged.
  const [pageScales, setPageScales] = useState<PageScales>(emptyPageScales);
  const scale = useMemo(
    () => scaleForPage(pageScales, currentPage),
    [pageScales, currentPage],
  );
  /* Badge label: when the current page's scale matches a predefined preset,
   * show the preset's label (e.g. 1/8" = 1'-0") instead of the computed ratio
   * (1:96). */
  const activePresetLabel = useMemo(() => {
    if (scale.invalid) return null;
    const match = DRAWING_SCALE_PRESETS.find((p) => sameScale(scale, p.scale));
    return match ? match.label : null;
  }, [scale]);
  /** Set the scale for the CURRENT page only (calibration applies to the
   *  page it was set on). Other uncalibrated pages keep the document
   *  default. */
  const setScale = useCallback(
    (next: ScaleConfig) => {
      setPageScales((prev) => setPageScaleIn(prev, currentPage, next));
    },
    [currentPage],
  );
  // Issue #333: when persistence HYDRATES the page scales on load (restoring a
  // saved calibration), that is a reconciliation, not a recalibration. The
  // scale-change recompute effect below re-projects a volume's typed depth
  // through the old->new pixels-per-unit ratio; on load the "old" ratio is the
  // factory default, so the restore used to corrupt every stored depth (and,
  // via the server recompute, the volume). We flag the hydrate so that one
  // transition SKIPS the recompute entirely and every stored measurement stays
  // byte-identical across a plain reload. A genuine user recalibration goes
  // through ``setScale`` above (no flag) and still re-projects depth correctly.
  const skipScaleRecomputeRef = useRef(false);
  const hydratePageScalesFromPersistence = useCallback((next: PageScales) => {
    skipScaleRecomputeRef.current = true;
    setPageScales(next);
  }, []);
  const [showScaleDialog, setShowScaleDialog] = useState(false);
  const [scaleRefPixels, setScaleRefPixels] = useState(0);
  const [scaleRefReal, setScaleRefReal] = useState(1);
  /** Unit of the scale dialog's real-world length: metric (m, mm), imperial
   *  (ft, in) and the USA-standard feet+inches combination. */
  const [scaleRefUnit, setScaleRefUnit] = useState<'m' | 'mm' | 'ft' | 'in' | 'ftin'>('m');
  const [scaleRefFeet, setScaleRefFeet] = useState<string>('');
  const [scaleRefInches, setScaleRefInches] = useState<string>('');
  const [settingScale, setSettingScale] = useState(false);
  const [scalePoints, setScalePoints] = useState<Point[]>([]);

  // Calibration (two-click → modal).  When armed, the same click-to-pick
  // logic as the existing legacy Scale dialog runs, but on completion
  // we route into the new CalibrationDialog which offers unit selection.
  const [showCalibrationDialog, setShowCalibrationDialog] = useState(false);
  const [calibrationPixels, setCalibrationPixels] = useState(0);
  const [calibrationMode, setCalibrationMode] = useState(false);
  /** Cached last calibration PER PAGE (for badge display) - real length +
   *  unit. Keyed by page so the badge always reflects the current sheet. */
  const [lastCalibrationByPage, setLastCalibrationByPage] = useState<
    Record<number, { realLength: number; unit: 'm' | 'mm' | 'ft' | 'in'; display?: string }>
  >({});
  const lastCalibration = lastCalibrationByPage[currentPage] ?? null;
  /* Badge main label, in priority order:
   *  1. preset label when the page scale matches a predefined preset,
   *  2. the dimension the user typed during manual calibration (e.g. 10 ft),
   *  3. the computed ratio (1:96) as fallback. */
  const badgeMainLabel =
    activePresetLabel ??
    (lastCalibration
      ? (lastCalibration.display ??
        `${formatMaxDigits(lastCalibration.realLength, 3)} ${lastCalibration.unit}`)
      : formatScaleRatio(scale));
  /** True when the CURRENT page has its own calibration - drives the
   *  "Calibrated · 1:N @ Lm" status badge. Per-page so navigating to an
   *  uncalibrated sheet correctly shows "not calibrated". */
  const isCalibrated = pageIsCalibrated(pageScales, currentPage);

  // Sidebar right-panel tab: "Properties" (existing) or "Ledger" (new).
  // Persisted to localStorage so the choice survives reloads.
  const [sidebarTab, setSidebarTab] = useState<'properties' | 'tools' | 'colours' | 'ai' | 'detect'>(() => {
    try {
      const saved = localStorage.getItem('takeoff.sidebarTab');
      return saved === 'tools' || saved === 'colours' ? saved : 'properties';
    } catch {
      return 'properties';
    }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.sidebarTab', sidebarTab); } catch { /* ignore */ }
  }, [sidebarTab]);

  /* Tool Chest state — the saved custom tools, persisted across reloads. */
  const [toolChest, setToolChest] = useState<SavedTool[]>(loadToolChest);
  useEffect(() => {
    try { localStorage.setItem(TOOL_CHEST_KEY, JSON.stringify(toolChest)); } catch { /* ignore */ }
  }, [toolChest]);
  // Name being edited inline in the chest (tool id), or null.
  const [renamingToolId, setRenamingToolId] = useState<string | null>(null);
  /** Material library folders (with user customizations applied). */
  const [chestLibrary, setChestLibrary] = useState<ChestFolder[]>(() => getCustomizedLibrary());
  /** Expanded folder ids in the material library. */
  const [expandedFolders, setExpandedFolders] = useState<Set<string>>(new Set(['cfs-trusses']));
  /** Material being edited (folder id + material), or null. */
  const [editingMaterial, setEditingMaterial] = useState<{ folderId: string; material: ChestMaterial } | null>(null);
  /** Refresh the library from customizations. */
  const refreshLibrary = useCallback(() => {
    setChestLibrary(getCustomizedLibrary());
  }, []);



  /* Pending annotation label from an applied chest tool (e.g. 362S162-43).
   * Sticky like a Bluebeam tool: every measurement drawn while the tool is
   * active gets this annotation. Cleared when the user switches tools
   * manually via selectTool. A ref (not state) so nextAnnotation can read it
   * without re-subscribing. */
  const toolLabelRef = useRef<string | null>(null);
  /* Pending tool set (e.g. Truss, CFS) from an applied chest tool — used to
   * build type-aware default annotations like "Howe truss 800S200-33". */
  const toolSetRef = useRef<string | null>(null);
  /* Pending subject (e.g. Howe) from an applied chest tool — stamped onto
   * new measurements as customFields.Subject alongside the material. */
  const toolSubjectRef = useRef<string | null>(null);

  /** Build the type descriptor (e.g. "Howe Truss", "CFS Joist") from the
   *  active chest tool's subject + tool set. Shared by nextAnnotation and
   *  toolFieldSpread so the PDF label and ledger stay consistent. */
  const buildToolTypeDescriptor = (): string => {
    const subject = (toolSubjectRef.current || '').trim();
    const toolSet = (toolSetRef.current || '').trim();
    const sub = subject.toLowerCase();
    const set = toolSet.toLowerCase();
    // Already a full member-type name (e.g. "Howe Truss", "CFS Joist") —
    // use as-is, normalizing capitalization.
    const knownTypes = [
      'CFS Joist',
      'Howe Truss',
      'Jack Truss',
      'Girder Truss',
      'CFS Bearing Wall',
      'CFS Non-load Bearing Wall',
      'Header',
      'Jamb',
      'King Stud',
      'Cripple Stud',
    ];
    for (const kt of knownTypes) {
      if (sub === kt.toLowerCase()) return kt;
    }
    if (sub.includes('truss') || set.includes('truss')) {
      // Avoid "Howe Truss truss" when the subject already ends with truss.
      return sub.endsWith('truss') ? subject : `${subject} Truss`;
    }
    if (sub.includes('joist') || set.includes('joist')) {
      return 'CFS Joist';
    }
    if (sub.includes('non-load') || sub.includes('non load') || sub.includes('nonload')) {
      return 'CFS Non-load Bearing Wall';
    }
    if (sub.includes('bearing wall') || sub.includes('load bearing')) {
      return 'CFS Bearing Wall';
    }
    if (sub.includes('wall')) {
      return subject;
    }
    if (sub.includes('header')) {
      return 'Header';
    }
    if (sub.includes('jamb')) {
      return 'Jamb';
    }
    if (subject) {
      return subject;
    }
    return toolSet;
  };

  /** Extra measurement fields from the active chest tool. Spread into every
   *  new measurement literal so Subject/Material ride along as their own
   *  ledger fields. Subject is the full type descriptor (e.g. "Howe truss")
   *  so the 3-line PDF label shows Subject / Material / Dimension cleanly.
   *  Also stamps author (profile full_name) + createdAt on every markup for
   *  the ledger's Author/Date columns. */
  const toolFieldSpread = (): Partial<Measurement> => {
    const subject = toolSubjectRef.current;
    const material = toolLabelRef.current;
    const stamp: Partial<Measurement> = {
      author: useAuthStore.getState().userFullName || undefined,
      createdAt: new Date().toISOString(),
    };
    if (!subject && !material) return stamp;
    return {
      ...stamp,
      customFields: {
        ...(subject ? { Subject: buildToolTypeDescriptor() || subject } : {}),
        ...(material ? { Material: material.trim() } : {}),
      },
    };
  };

  const renameTool = useCallback((id: string, name: string) => {
    const trimmed = name.trim();
    if (!trimmed) return;
    setToolChest((prev) => prev.map((t) => (t.id === id ? { ...t, name: trimmed } : t)));
    setRenamingToolId(null);
  }, []);

  const deleteTool = useCallback((id: string) => {
    setToolChest((prev) => prev.filter((t) => t.id !== id));
  }, []);

  /* Bottom page-navigation bar: collapsible via a thick drag handle with
   * up/down chevrons below the pager (VS Code terminal style). Drag down
   * (or click) to collapse it to the slim handle strip for more canvas
   * space; drag up (or click) to bring it back. Persisted. */
  const [bottomBarCollapsed, setBottomBarCollapsed] = useState<boolean>(() => {
    try { return localStorage.getItem('takeoff.bottomBarCollapsed') === '1'; } catch { return false; }
  });
  useEffect(() => {
    try { localStorage.setItem('takeoff.bottomBarCollapsed', bottomBarCollapsed ? '1' : '0'); } catch { /* ignore */ }
  }, [bottomBarCollapsed]);

  // Canvas refs
  const canvasRef = useRef<HTMLCanvasElement>(null);
  /** Set when the main PDF canvas mounts — the page-render effect waits for
   *  this, otherwise a fast (range-request) load can setPdfDoc before the
   *  canvas exists and the first paint is skipped forever (blank page until
   *  refresh). */
  const [canvasReady, setCanvasReady] = useState(false);
  const overlayRef = useRef<HTMLCanvasElement>(null);
  const containerRef = useRef<HTMLDivElement>(null);
  // Bumped at the end of every successful (non-cancelled) page render. The
  // overlay-draw effect depends on it so it repaints AFTER the render
  // continuation resets the overlay bitmap - otherwise a page navigation /
  // select-tool zoom leaves the measurements wiped until the next unrelated
  // redraw (issue #297). The render effect does NOT depend on it, so it can
  // never loop.
  const [renderNonce, setRenderNonce] = useState(0);
  // 1-indexed page the main canvas has actually finished rendering. The
  // thumbnail effect reads this to know the main canvas holds THIS page before
  // downscaling it into the current page's thumbnail (issue #301).
  const mainRenderedPageRef = useRef(0);

  // Touch state for pinch-to-zoom
  const touchStateRef = useRef<{ initialDistance: number; initialZoom: number } | null>(null);

  /* ── Viewport interaction (fit / ortho / pan / readout / hover) ───────
   * All the pure geometry lives in features/takeoff/lib/takeoff-viewport.ts;
   * this state only drives the React surface (toolbar toggles, the live HUD
   * and the hover tooltip). Zoom-at-cursor + touch pinch already exist and
   * are left intact. */

  /** Ortho lock toggle (toolbar). When on - or while Shift is held - a new
   *  segment is constrained to 0 / 45 / 90 degrees from its anchor. The
   *  draw + render paths read `orthoLock || shiftHeldRef.current`. */
  const [orthoLock, setOrthoLock] = useState(false);
  /** True while Shift is physically held, so a momentary press locks the
   *  segment without flipping the persistent toggle (CAD-standard). */
  const shiftHeldRef = useRef(false);

  /** Vertex-snap toggle (toolbar). When on, a new point being drawn snaps onto
   *  the nearest vertex of an already-drawn measurement within a screen-space
   *  radius, so shapes connect exactly to existing corners (issue #303). Read
   *  through a ref in the pointer handlers so toggling it never re-creates
   *  them. Takes precedence over the ortho lock when a vertex is in range. */
  const [vertexSnap, setVertexSnap] = useState(false);
  const vertexSnapRef = useRef(vertexSnap);
  vertexSnapRef.current = vertexSnap;
  /** Snap to PDF drawing content (vector geometry). Bluebeam-style. Off by
   *  default so clicks never get hijacked unexpectedly (accuracy). */
  const [contentSnap, setContentSnap] = useState(false);
  const contentSnapRef = useRef(contentSnap);
  contentSnapRef.current = contentSnap;
  /** The existing vertex the in-progress point is currently snapping to, in PDF
   *  units, or null. Drives the on-canvas snap ring cue. */
  const [snapPoint, setSnapPoint] = useState<Point | null>(null);
  /** Whether the current snapPoint came from PDF content (vs markup vertex).
   *  Content snaps render in a different color. */
  const [snapIsContent, setSnapIsContent] = useState(false);
  /** Cached per-page PDF-content snap indexes. Built lazily on page open. */
  const contentSnapCache = useRef<Map<number, SnapIndex>>(new Map());

  /** Build the PDF-content snap index for the current page (lazily, once per
   *  page). Runs in the background so page open stays snappy. */
  useEffect(() => {
    if (!pdfDoc) return;
    if (contentSnapCache.current.has(currentPage)) return;
    let cancelled = false;
    (async () => {
      try {
        const page = await pdfDoc.getPage(currentPage);
        if (cancelled) return;
        const segments = await extractPageSegments(page);
        if (cancelled) return;
        contentSnapCache.current.set(currentPage, buildSnapIndex(segments));
      } catch {
        // Content snap is best-effort; a failure just means no content snaps.
      }
    })();
    return () => { cancelled = true; };
  }, [pdfDoc, currentPage]);

  /** Space-drag / middle-mouse pan transient. Lives in a ref so the
   *  mid-pan mousemove never triggers a re-render storm; `panning` state
   *  only flips the cursor + suppresses click-to-place. */
  const panRef = useRef<{ startX: number; startY: number; startPanX: number; startPanY: number } | null>(null);
  const [panning, setPanning] = useState(false);
  /** Transform-based pan offset (CSS px): lets the user drag the sheet freely
   *  inside the working area even when it fits entirely in the viewport
   *  (scroll-based pan can't move it then). Applied as translate() on the
   *  pan wrapper around the zoom wrapper. Reset on page change. */
  const [panOffset, setPanOffset] = useState({ x: 0, y: 0 });
  const panOffsetRef = useRef(panOffset);
  panOffsetRef.current = panOffset;
  /** Ref to the pan wrapper div (translate target during gestures). */
  const panWrapRef = useRef<HTMLDivElement | null>(null);
  /** Reset the pan offset when the page changes. */
  useEffect(() => {
    setPanOffset({ x: 0, y: 0 });
    if (panWrapRef.current) panWrapRef.current.style.transform = '';
  }, [currentPage]);
  /* ── Marquee (rubber-band) multi-select, Bluebeam-style ───────────────
   * In select mode, dragging on empty canvas draws a selection box; every
   * measurement intersecting it joins `selectedLedgerIds`. Shift+click
   * toggles a single measurement in/out of the set. The rect lives in PDF
   * coordinates; the overlay draw effect paints it. */
  const marqueeRef = useRef<{ start: Point; current: Point } | null>(null);
  const [marqueeRect, setMarqueeRect] = useState<{ x0: number; y0: number; x1: number; y1: number } | null>(null);
  /** Zoom-to-area (marquee zoom): when armed, dragging on the canvas draws a
   *  rectangle and zooms to fit it. The button lives in the bottom pager bar. */
  const [zoomAreaArmed, setZoomAreaArmed] = useState(false);
  const [zoomAreaRect, setZoomAreaRect] = useState<{ x0: number; y0: number; x1: number; y1: number } | null>(null);
  const zoomAreaRef = useRef<{ start: Point; current: Point } | null>(null);

  /** Bluebeam-style legend placement: when armed (via the Legend panel's
   *  "Place Legend" button), the next canvas click drops a legend box at
   *  that point on the current page. Read through a ref inside the click
   *  handler so it never enters the dependency array. */
  const [legendPlacing, setLegendPlacing] = useState(false);
  const legendPlacingRef = useRef(false);
  // Keep the ref mirror current (set alongside setLegendPlacing at call sites).
  useEffect(() => {
    legendPlacingRef.current = legendPlacing;
  }, [legendPlacing]);
  /** Legend styling: text color, background color, border style (PDF box only;
   *  the sidebar Legend dashboard keeps default theme colours). Declared here
   *  (before the overlay-draw effect) so the effect's dependency array can
   *  reference them without a TDZ crash. */
  const [legendTextColor, setLegendTextColor] = useState('#1a1a1a');
  const [legendBgColor, setLegendBgColor] = useState('#ffffff');
  const [legendBorderStyle, setLegendBorderStyle] = useState<'none' | 'outline' | 'horizontal' | 'vertical' | 'grid'>('outline');
  const legendTextColorRef = useRef(legendTextColor);
  legendTextColorRef.current = legendTextColor;
  const legendBgColorRef = useRef(legendBgColor);
  legendBgColorRef.current = legendBgColor;
  const legendBorderStyleRef = useRef(legendBorderStyle);
  legendBorderStyleRef.current = legendBorderStyle;
  /** Merge similar lengths is always on (no toggle): rows with identical
   *  Type + Material + Name (+ same unit) whose length spread fits within
   *  tolerance merge into ONE row showing the MAX length with the summed qty;
   *  original lengths stay visible in the hover tooltip. Source markups are
   *  never touched. Tolerance in canonical metres (0.1524 m = 0.5 ft). */
  const LEGEND_MERGE_TOLERANCE_M = 0.1524;
  /** Cell padding for the placed PDF legend box (CSS px at content scale 1):
   *  extra space around every value — top / bottom grow the row height
   *  (title, column headers and data rows alike), left / right widen the
   *  columns. Defaults to a little breathing room. */
  const [legendPadTop, setLegendPadTop] = useState(4);
  const [legendPadBottom, setLegendPadBottom] = useState(4);
  const [legendPadLeft, setLegendPadLeft] = useState(4);
  const [legendPadRight, setLegendPadRight] = useState(4);

  /** Primary-button canvas press in flight (down, not yet released). Scoped to
   *  button 0: a non-primary press fires auxclick, never click, so keying this
   *  on any button would let a middle-click disarm a guard a tool switch armed
   *  (#356). */
  const pressActiveRef = useRef(false);
  /** The trailing click of the current press must not be treated as a
   *  placement - armed when the tool changes mid-press, consumed by the next
   *  handleCanvasClick (#356). Keyed on the press, not on dragRef, since Escape
   *  can null dragRef mid-press while the click is still coming. */
  const suppressNextClickRef = useRef(false);
  /** True while the Space bar is held - arms pan on the next mousedown and
   *  shows the grab cursor. Cleared on keyup / blur. */
  const [spaceHeld, setSpaceHeld] = useState(false);
  const spaceHeldRef = useRef(false);
  /** Hand / pan mode armed from the toolbar (#316). Unlike Space it is a sticky
   *  toggle: left-drag pans until the user clicks the toolbar button again or
   *  presses Escape. Helps trackpad users who find Space-drag awkward. A ref
   *  mirrors it for the pointer handlers that must not re-subscribe. */
  const [panLock, setPanLock] = useState(false);
  const panLockRef = useRef(false);
  useEffect(() => {
    panLockRef.current = panLock;
  }, [panLock]);

  /** Live pointer position in PDF units while a measure tool is active,
   *  drives the running-length HUD. Null when the pointer is off-canvas. */
  const [liveCursor, setLiveCursor] = useState<Point | null>(null);

  /** Hover tooltip for an existing measurement in select mode: the measured
   *  value / group / linked BOQ reference, anchored at the cursor. */
  const [hoverInfo, setHoverInfo] = useState<{
    measurementId: string;
    x: number;
    y: number;
  } | null>(null);
  /** Mirror of hoverInfo so the right-click context-menu handler can read the
   *  measurement under the cursor without adding hoverInfo to its deps. */
  const hoverInfoRef = useRef(hoverInfo);
  hoverInfoRef.current = hoverInfo;

  /** Right-click context menu for a measurement (select tool). Positioned at
   *  the viewport-space cursor; carries the target measurement id. Null when
   *  closed. Offers Duplicate / Delete (issue #302). */
  const [contextMenu, setContextMenu] = useState<{
    x: number;
    y: number;
    measurementId: string;
  } | null>(null);
  /** Multiply dialog: linear Bluebeam-style copy. Null when closed; carries
   *  the source measurement id. Direction/Distance/Copies/Preview mirror
   *  Bluebeam Revu's Multiply dialog. */
  const [multiplyDialog, setMultiplyDialog] = useState<{ measurementId: string } | null>(null);
  const multiplyDialogRef = useRef(multiplyDialog);
  multiplyDialogRef.current = multiplyDialog;
  const [multiplyDirection, setMultiplyDirection] = useState<'right' | 'left' | 'up' | 'down'>('right');
  const [multiplyDistance, setMultiplyDistance] = useState(`1'-0"`);
  const multiplyDistanceRef = useRef(multiplyDistance);
  multiplyDistanceRef.current = multiplyDistance;
  const [multiplyCopies, setMultiplyCopies] = useState(8);
  const multiplyCopiesRef = useRef(multiplyCopies);
  multiplyCopiesRef.current = multiplyCopies;
  const multiplyDirectionRef = useRef(multiplyDirection);
  multiplyDirectionRef.current = multiplyDirection;
  /** Unit pick list for the multiply distance (Bluebeam-style). */
  const [multiplyUnit, setMultiplyUnit] = useState<'ft' | 'ft-in' | 'in' | 'mm' | 'm'>('ft');
  const multiplyUnitRef = useRef(multiplyUnit);
  multiplyUnitRef.current = multiplyUnit;
  /** Ghost preview (state, not ref): the draw effect reads this directly.
   *  Includes track metadata so the canvas can draw the direction line,
   *  copy numbers and spacing labels. */
  const [multiplyGhosts, setMultiplyGhosts] = useState<{
    points: Point[][];
    srcCenter: Point;
    dir: Point;
    distPdf: number;
    copies: number;
  } | null>(null);
  /** Ghost preview point-arrays, recomputed live while the dialog is open. */
  const multiplyPreviewRef = useRef<Point[][] | null>(null);
  /** Offset dialog: parallel copy of a line/polyline. Null when closed. */
  const [offsetDialog, setOffsetDialog] = useState<{ measurementId: string } | null>(null);
  const [offsetDistance, setOffsetDistance] = useState('6');
  const offsetDistanceRef = useRef(offsetDistance);
  offsetDistanceRef.current = offsetDistance;
  const [offsetSide, setOffsetSide] = useState<'left' | 'right' | 'both' | 'dynamic' | 'outward' | 'inward'>('dynamic');
  /** Unit pick list for offset distance (same as multiply). */
  const [offsetUnit, setOffsetUnit] = useState<'ft' | 'ft-in' | 'in' | 'mm' | 'm'>('ft');
  const offsetUnitRef = useRef(offsetUnit);
  offsetUnitRef.current = offsetUnit;
  /** Interactive offset tool (Bluebeam-style): hover shows ghost, click commits.
   *  Toggle via the toolbar button. */
  const [offsetTool, setOffsetTool] = useState(false);
  const offsetToolRef = useRef(false);
  useEffect(() => { offsetToolRef.current = offsetTool; }, [offsetTool]);
  /** Settings popup for the interactive offset tool. */
  const [showOffsetPopup, setShowOffsetPopup] = useState(false);
  /** Ref to the offset toolbar button — popup positions below it. */
  const offsetBtnRef = useRef<HTMLButtonElement>(null);
  /** Popup position (below the offset icon). */
  const [offsetPopupPos, setOffsetPopupPos] = useState({ top: 80, left: 300 });
  /** Whether the offset tool is armed and waiting for hover (popup closed, cursor indicator active). */
  const [offsetArmed, setOffsetArmed] = useState(false);
  /** Selected measurement ID for click-based offset (fallback when hover fails). */
  const [offsetSelectedId, setOffsetSelectedId] = useState<string | null>(null);
  const offsetSelectedIdRef = useRef<string | null>(null);
  useEffect(() => { offsetSelectedIdRef.current = offsetSelectedId; }, [offsetSelectedId]);
  const offsetArmedRef = useRef(false);
  useEffect(() => { offsetArmedRef.current = offsetArmed; }, [offsetArmed]);
  /** Screen position of the cursor-following offset indicator. */
  const [offsetCursorPos, setOffsetCursorPos] = useState<{ x: number; y: number } | null>(null);
  /** Ghost preview: source measurement id + offset point arrays. */
  const [offsetGhost, setOffsetGhost] = useState<{ sourceId: string; ghosts: Point[][] } | null>(null);
  const offsetGhostRef = useRef<{ sourceId: string; ghosts: Point[][] } | null>(null);
  offsetGhostRef.current = offsetGhost;
  const contextMenuRef = useRef(contextMenu);
  contextMenuRef.current = contextMenu;

  // Measurement groups
  const [activeGroup, setActiveGroup] = useState('General');

  /* ── Ledger multi-selection for CFS export ────────────────────────────
   * The estimator ticks rows in the ledger, hits "Export to Estimation",
   * picks a CFS target in the popup, and the mapped rows land in the
   * matching CFS Estimation tab. */
  const [selectedLedgerIds, setSelectedLedgerIds] = useState<ReadonlySet<string>>(new Set());
  const selectedLedgerIdsRef = useRef(selectedLedgerIds);
  selectedLedgerIdsRef.current = selectedLedgerIds;
  const [showCfsExportDialog, setShowCfsExportDialog] = useState(false);
  const [cfsExportTarget, setCfsExportTarget] = useState<CfsExportTargetId>('roofTrusses');

  /** Shift+click on canvas: toggle one measurement in/out of the multi-select
   *  set (used by the select-tool mousedown; defined here so the handler
   *  below can depend on it). */
  const toggleMarqueeSelection = useCallback(
    (id: string) => {
      setSelectedLedgerIds((prev) => {
        const next = new Set(prev);
        if (next.has(id)) next.delete(id);
        else next.add(id);
        return next;
      });
      setSelectedMeasurementId(id);
    },
    [setSelectedLedgerIds],
  );

  /** Clear the canvas multi-select set. */
  const clearMarqueeSelection = useCallback(() => {
    setSelectedLedgerIds(new Set());
    setSelectedMeasurementId(null);
  }, []);

  const toggleLedgerSelect = useCallback((id: string) => {
    setSelectedLedgerIds((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      // Keep the single primary selection in sync so the Properties panel
      // (which renders on selectedMeasurementId) opens for ledger checks.
      // On uncheck of the primary, fall back to another selected id.
      if (next.has(id)) {
        setSelectedMeasurementId(id);
      } else {
        setSelectedMeasurementId((cur) => {
          if (cur !== id) return cur;
          const remaining = [...next];
          return remaining.length > 0 ? remaining[0] : null;
        });
      }
      return next;
    });
    // Open the Properties panel on any ledger (un)check so the selection's
    // editable fields are immediately visible.
    setSidebarTab('properties');
    setRightPanelWidth((w) => {
      if (w !== 0) return w;
      const last = lastOpenRightWidthRef.current;
      return last > 0 ? last : RIGHT_PANEL_DEFAULT;
    });
    setShowSidebar(true);
  }, []);

  const toggleLedgerSelectAll = useCallback(() => {
    setSelectedLedgerIds((prev) => {
      // Select-all is scoped to the currently visible measurements; if
      // everything visible is already selected, clear instead.
      const allIds = measurements.map((m) => m.id);
      const allSelected = allIds.length > 0 && allIds.every((id) => prev.has(id));
      const next = allSelected ? new Set<string>() : new Set(allIds);
      // Sync primary selection for the Properties panel.
      setSelectedMeasurementId(next.size > 0 ? [...next][0] : null);
      return next;
    });
    setSidebarTab('properties');
    setRightPanelWidth((w) => {
      if (w !== 0) return w;
      const last = lastOpenRightWidthRef.current;
      return last > 0 ? last : RIGHT_PANEL_DEFAULT;
    });
    setShowSidebar(true);
  }, [measurements]);
  const [hiddenGroups, setHiddenGroups] = useState<Set<string>>(new Set());
  // Per-measurement visibility (issue #359), keyed by measurement id. Parallel
  // to hiddenGroups and honoured at every site group visibility is: a hidden
  // measurement leaves the canvas, the snap pool, the hit-test, the legend
  // count and the annotated PDF, but stays listed (dimmed) so it can be
  // restored. View concern only - it never affects CSV/XLSX/BOQ or totals.
  // Session-scoped, like hiddenGroups (not persisted).
  const [hiddenMeasurements, setHiddenMeasurements] = useState<Set<string>>(new Set());
  const [collapsedGroups, setCollapsedGroups] = useState<Set<string>>(new Set());
  // Custom per-group colours (issue #313). Merged over the built-in colours so a
  // user-defined group paints in its chosen colour on the canvas, in the legend
  // and in exports. Loaded/saved per document below.
  const [customGroupColors, setCustomGroupColors] = useState<Record<string, string>>({});
  const groupColorMap = useMemo(
    () => ({ ...BASE_GROUP_COLORS, ...customGroupColors }),
    [customGroupColors],
  );
  /** Set a group's colour (issue #313). */
  const setGroupColor = useCallback((group: string, color: string) => {
    setCustomGroupColors((prev) => ({ ...prev, [group]: color }));
  }, []);

  // Volume depth input
  const [showVolumeDepthInput, setShowVolumeDepthInput] = useState(false);
  const [volumeDepthValue, setVolumeDepthValue] = useState('1');
  const [pendingVolumePoints, setPendingVolumePoints] = useState<Point[]>([]);

  // Annotation auto-numbering counters (type -> next index)
  const annotationCounterRef = useRef<Record<string, number>>({ distance: 0, polyline: 0, area: 0, volume: 0, count: 0, cloud: 0, arrow: 0, text: 0, rectangle: 0, highlight: 0 });

  // Annotation markup state
  const [annotationColor, setAnnotationColor] = useState('#EF4444');
  const [showTextInput, setShowTextInput] = useState(false);
  const [textInputPos, setTextInputPos] = useState<Point>({ x: 0, y: 0 });
  const [textInputValue, setTextInputValue] = useState('');
  /** When set, the text input edits this existing text annotation
   *  instead of creating a new one (click / double-click a placed text). */
  const [editingTextId, setEditingTextId] = useState<string | null>(null);
  /** Width (PDF units) of the text box currently open in the editor. */
  const [textInputWidth, setTextInputWidth] = useState(TEXT_BOX_DEFAULT_W);
  /** Set on Escape so the imminent input onBlur skips handleTextConfirm.
   *  Without it, the unmounting input fires blur, blur calls confirm with
   *  the still-typed value, and a "ghost" annotation is created despite
   *  the user pressing Escape to cancel. */
  const textInputCancellingRef = useRef(false);
  /** Timestamp of the last editor save caused by a blur (outside click).
   *  The same physical click then reaches the canvas click handler,
   *  which would instantly reopen a new editor at that point — the text
   *  branch swallows one click inside a short window after a blur-save
   *  so an outside click simply saves and closes. */
  const textSaveAtRef = useRef(0);
  /** Latest handleTextConfirm, for the canvas mousedown commit path
   *  (the confirm callback is defined far below the mouse handlers). */
  const handleTextConfirmRef = useRef<(() => void) | null>(null);
  /** Mirror of showTextInput for handlers that must not re-subscribe. */
  const showTextInputRef = useRef(false);
  showTextInputRef.current = showTextInput;
  const [rectStartPoint, setRectStartPoint] = useState<Point | null>(null);
  const [isDraggingRect, setIsDraggingRect] = useState(false);

  // Inline editing state for annotations in the measurement list
  const [editingAnnotationId, setEditingAnnotationId] = useState<string | null>(null);
  const [editingAnnotationValue, setEditingAnnotationValue] = useState('');

  // Undo / Redo stacks.  Redo is cleared whenever a fresh user operation
  // is pushed onto undo (so the two stacks never fork).
  const undoStackRef = useRef<UndoOperation[]>([]);
  const redoStackRef = useRef<UndoOperation[]>([]);
  const [undoCount, setUndoCount] = useState(0);
  const [redoCount, setRedoCount] = useState(0);
  const addToast = useToastStore((s) => s.addToast);
  const queryClient = useQueryClient();
  // User's measurement system. Measurements are stored metric-canonical
  // (D-TKC-016); this drives display + export conversion (m -> ft, etc.).
  // Read with a selector so unrelated preference changes don't re-render.
  const measurementSystem = usePreferencesStore((s) => s.measurementSystem);

  // Selected measurement (drives the right-side Properties panel).
  const [selectedMeasurementId, setSelectedMeasurementId] = useState<string | null>(null);
  /** Whether the area popup should be visible. */
  const showAreaPopup = !areaPopupDismissed && (activeTool === 'area' || (() => {
    const m = measurements.find((x) => x.id === selectedMeasurementId);
    return !!m && (m.type === 'area' || m.type === 'volume');
  })());
  /** Position the popup under the Area tool button when it appears. */
  useEffect(() => {
    if (showAreaPopup && areaToolBtnRef.current) {
      const rect = areaToolBtnRef.current.getBoundingClientRect();
      setAreaPopupPos({ left: Math.max(8, rect.left), top: rect.bottom + 8 });
    } else {
      setAreaPopupPos(null);
    }
  }, [showAreaPopup]);
  /** Re-open the popup when a different area gets selected. */
  useEffect(() => {
    setAreaPopupDismissed(false);
  }, [selectedMeasurementId]);
  /** When an area/volume markup gets selected, load its depth/slope into
   *  the popup so the user sees (and can change) its current values. */
  useEffect(() => {
    if (!selectedMeasurementId) return;
    const m = measurementsRef.current.find((x) => x.id === selectedMeasurementId);
    if (!m || (m.type !== 'area' && m.type !== 'volume')) return;
    if (typeof m.depth === 'number' && m.depth > 0) {
      // Show stored metres back in the popup's current depth unit.
      const toM: Record<string, number> = {
        mm: 0.001, cm: 0.01, m: 1, km: 1000,
        in: 0.0254, 'in"': 0.0254, ft: 0.3048, 'ft in"': 0.3048,
        yd: 0.9144, mi: 1609.34,
      };
      const f = toM[areaDepthUnit] ?? 1;
      setAreaDepth(String(Math.round((m.depth / f) * 100) / 100));
    }
    if (typeof m.slopeFactor === 'number' && m.slopeFactor > 1) {
      const deg = degreesFromSlopeFactor(m.slopeFactor);
      setAreaSlopeType('Degree');
      setAreaSlopeValue(String(Math.round(deg * 10) / 10));
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedMeasurementId]);
  // "Copy to pages" target selection (issue #332 wave): pages the properties
  // panel will replicate the selected measurement / its group onto. Cleared
  // after a copy and whenever the selection changes.
  const [copyTargetPages, setCopyTargetPages] = useState<Set<number>>(new Set());
  // Line-width unit mode + edit buffer (issue #339). ``widthMode`` toggles the
  // Line-width control between screen pixels and the drawing's real-world unit;
  // ``widthDraft`` holds the in-progress text for the real-mode fields so typing
  // is not renormalised on every keystroke (the canonical value stays in
  // ``strokeWidthReal``, in metres). Seeded from the selection by an effect keyed
  // only on the selection id, so re-selecting re-seeds but an unrelated edit does
  // not clobber a half-typed value.
  const [widthMode, setWidthMode] = useState<'px' | 'real'>('px');
  const [widthDraft, setWidthDraft] = useState<{ m: string; ft: string; in: string }>({
    m: '',
    ft: '',
    in: '',
  });

  /* ── In-canvas editing (#194 Feature 1) ──────────────────────────────
   * Drag transient lives in a ref so mid-drag mousemove never triggers a
   * re-render storm. A single `dragPreview` state holds the live mutated
   * points the overlay draws for the one measurement being reshaped; the
   * commit lands on mouseup, which is also where the undo frame + the
   * server-authoritative PATCH (via the persistence hook) fire. */
  const dragRef = useRef<{
    mode: 'vertex' | 'shape';
    measurementId: string;
    /** Pre-edit measurement snapshot for the undo frame + abort restore. */
    original: Measurement;
    /** Original points captured at drag start (vertex / shape source). */
    origPoints: Point[];
    /** Vertex being dragged (vertex mode only). */
    vertexIndex: number;
    /** Pointer position at drag start in PDF units (shape mode only). */
    startPt: Point;
    /** True once the pointer actually moved, so a plain click that grabs a
     *  vertex but does not move it produces no edit / undo frame. */
    moved: boolean;
    /** The latest dragged points - the authoritative geometry the commit
     *  uses on mouseup (state only holds the pre-drag copy mid-drag). */
    lastPoints: Point[];
    /** Shift+drag duplicate: this drag moves a freshly minted clone of
     *  `sourceId`; commit records a creation (not an edit) and abort
     *  removes the clone again. */
    wasDuplicate?: boolean;
    /** The measurement the clone was copied from (abort reselect). */
    sourceId?: string;
  } | null>(null);
  /** A Shift+press on a markup body whose intent is not yet known: a
   *  plain release toggles the markup in the multi-select set (the
   *  long-standing Shift+click), while a drag past the threshold
   *  converts it into a duplicate drag of a fresh clone. */
  const shiftPendingRef = useRef<{
    measurementId: string;
    startPt: Point;
    source: Measurement;
  } | null>(null);
  /** Arrow-key nudge bookkeeping: the pre-burst originals of every
   *  measurement the current key burst has moved, flushed into undo
   *  frames ~700 ms after the last press so a held key stays a
   *  single undo step per markup. */
  const nudgeUndoRef = useRef<{ originals: Map<string, Measurement>; timer: number | null }>({
    originals: new Map(),
    timer: null,
  });
  /** Active legend-box corner resize. Separate from dragRef so the two never
   *  interfere; follows the same arm → live-update → commit/abort pattern.
   *  Corner index: 0 = top-left, 1 = top-right, 2 = bottom-right,
   *  3 = bottom-left. */
  const legendResizeRef = useRef<{
    measurementId: string;
    /** Pre-resize snapshot for the undo frame + abort restore. */
    original: Measurement;
    /** Box top-left anchor at drag start (PDF units). */
    origAnchor: Point;
    /** Box width/height at drag start (PDF units). */
    origW: number;
    origH: number;
    /** Pointer position at drag start (PDF units). */
    startPt: Point;
    /** Corner being dragged (0..3). */
    corner: number;
    /** True once the pointer actually moved. */
    moved: boolean;
  } | null>(null);
  /** Last mousedown press on a text box (double-click detection). */
  const lastTextPressRef = useRef<{ id: string; at: number } | null>(null);
  /** Active text-box width resize (bottom-right corner drag). */
  const textResizeRef = useRef<{
    measurementId: string;
    /** Pre-resize snapshot for the undo frame + abort restore. */
    original: Measurement;
    /** Pointer position at drag start (PDF units). */
    startPt: Point;
    /** Box width at drag start (PDF units). */
    origW: number;
    /** True once the pointer actually moved. */
    moved: boolean;
  } | null>(null);
  const [dragPreview, setDragPreview] = useState<
    {
      measurementId: string;
      points: Point[];
      label: string;
      selfIntersecting: boolean;
      // The live recompute result (value / unit / area / width / height), so the
      // completed-measurements pass can repoint the dragged band to the cursor
      // and its value label stays in sync (#357). selfIntersecting also lives on
      // this object (above), where the bowtie warning already reads it, so the
      // patch is projected field-by-field into the render, never spread whole.
      patch: ReturnType<typeof recomputeMeasurement>;
    } | null
  >(null);
  /** The vertex most recently grabbed / hovered on the selected
   *  measurement, so Delete can remove a vertex (when valid) instead of
   *  always deleting the whole measurement. Cleared on deselect. */
  const activeVertexRef = useRef<{ measurementId: string; index: number } | null>(null);

  // Legend overlay visibility (bottom-left of canvas). Off by default:
  // the navbar Legend button opens only the sidebar dashboard now.
  const [showLegend, setShowLegend] = useState(false);
  /** Navbar legend toggle also shows/hides the right-side Legend dashboard.
   *  On = dashboard visible (sidebar opens, Properties tab, expanded).
   *  Off = dashboard hidden. Defaults on. */
  const [legendDashboardVisible, setLegendDashboardVisible] = useState(true);
  // Dragged legend position (#358), in px from the pinned wrapper's top-left;
  // null keeps the default bottom-2 left-2 corner. Seeded from localStorage.
  const [legendPos, setLegendPos] = useState<{ x: number; y: number } | null>(() => {
    if (typeof window === 'undefined') return null;
    try {
      const raw = window.localStorage.getItem(LEGEND_POS_KEY);
      if (raw) {
        const p = JSON.parse(raw) as { x?: unknown; y?: unknown };
        if (typeof p.x === 'number' && typeof p.y === 'number') return { x: p.x, y: p.y };
      }
    } catch {
      /* ignore malformed / unavailable storage */
    }
    return null;
  });
  /** The pinned, non-scrolling wrapper the legend is positioned against (#358):
   *  every drag coordinate and clamp bound is measured relative to it. */
  const legendViewportRef = useRef<HTMLDivElement | null>(null);
  const legendElRef = useRef<HTMLDivElement | null>(null);
  const legendResizeObsRef = useRef<ResizeObserver | null>(null);
  const legendDragRef = useRef<{ onMove: (e: MouseEvent) => void; onUp: () => void } | null>(null);

  // Export to BOQ state
  const [showExportDialog, setShowExportDialog] = useState(false);
  const [exportProjects, setExportProjects] = useState<{ id: string; name: string }[]>([]);
  const [exportBoqs, setExportBoqs] = useState<{ id: string; name: string }[]>([]);
  const [selectedProjectId, setSelectedProjectId] = useState('');
  const [selectedBoqId, setSelectedBoqId] = useState('');
  const [isExporting, setIsExporting] = useState(false);
  const [showClearConfirm, setShowClearConfirm] = useState(false);

  // Link measurement to BOQ state.  The picker is self-contained: it can
  // discover project + BOQ on its own (no dependency on the Export dialog
  // being opened first) and supports creating a new position inline.
  const [linkingMeasurementId, setLinkingMeasurementId] = useState<string | null>(null);
  const [linkPickerProjectId, setLinkPickerProjectId] = useState('');
  const [linkPickerBoqId, setLinkPickerBoqId] = useState('');
  const [linkPickerProjects, setLinkPickerProjects] = useState<{ id: string; name: string }[]>([]);
  const [linkPickerBoqs, setLinkPickerBoqs] = useState<{ id: string; name: string }[]>([]);
  const [linkBoqPositions, setLinkBoqPositions] = useState<Position[]>([]);
  const [linkBoqsLoading, setLinkBoqsLoading] = useState(false);
  const [linkPositionsLoading, setLinkPositionsLoading] = useState(false);
  const [linkingInProgress, setLinkingInProgress] = useState(false);
  const [linkPickerSearch, setLinkPickerSearch] = useState('');
  const [linkPickerMode, setLinkPickerMode] = useState<'pick' | 'create'>('pick');
  // "Create new position" form. null section / description = not touched yet,
  // so the defaults (last section, the measurement's name) apply.
  const [linkCreateSectionId, setLinkCreateSectionId] = useState<string | null>(null);
  const [linkCreateDescription, setLinkCreateDescription] = useState<string | null>(null);
  const [linkCreateCost, setLinkCreateCost] = useState<
    { id: string; code: string; description: string; unit: string; rate: number; currency?: string } | null
  >(null);
  const [linkCostPickerOpen, setLinkCostPickerOpen] = useState(false);
  // Bulk "Add all to BOQ" from the Ledger tab: the eligible (unlinked,
  // measurable, human-confirmed) measurements awaiting a target BOQ pick.
  // null = panel closed. Reuses the link-picker project/BOQ state above.
  const [bulkAddMeasurements, setBulkAddMeasurements] = useState<Measurement[] | null>(null);

  // Cross-module linking (issue: takeoff -> Issue/RFI): the measurement the
  // "Create RFI" dialog is open for, or null when closed. A measurement must
  // be synced (have a serverId) to be linkable, so the openers gate on that.
  const [rfiMeasurement, setRfiMeasurement] = useState<Measurement | null>(null);

  // Document persistence + server sync
  const [fileName, setFileName] = useState<string | null>(null);
  // Stable document UUID (issue #238). Measurement identity is projectId +
  // this id. Resolved below from the explicit prop or the download URL; null
  // for a freshly dropped local file (which then persists locally only).
  const [documentId, setDocumentId] = useState<string | null>(initialDocumentId ?? null);
  /* ── Ledger custom columns ──────────────────────────────────────────
   * User-defined ledger columns, persisted per document in localStorage.
   * Cell values ride on `measurement.customFields` (metadata round-trip). */
  const ledgerDocKey = documentId || fileName || 'local';
  const [customColumns, setCustomColumns] = useState<string[]>([]);
  /** Manage Columns dialog visibility. */
  const [manageColumnsOpen, setManageColumnsOpen] = useState(false);
  /** Hidden built-in ledger columns (Bluebeam-style Manage Columns). */
  const [hiddenLedgerColumns, setHiddenLedgerColumns] = useState<ReadonlySet<string>>(new Set());
  // Load the document's custom columns (on mount and when the document changes).
  useEffect(() => {
    try {
      const raw = localStorage.getItem(`takeoff.customColumns.${ledgerDocKey}`);
      const parsed = raw ? JSON.parse(raw) : [];
      setCustomColumns(
        Array.isArray(parsed) ? parsed.filter((c) => typeof c === 'string') : [],
      );
    } catch {
      setCustomColumns([]);
    }
  }, [ledgerDocKey]);
  // Persist on change.
  useEffect(() => {
    try {
      localStorage.setItem(`takeoff.customColumns.${ledgerDocKey}`, JSON.stringify(customColumns));
    } catch { /* ignore */ }
  }, [customColumns, ledgerDocKey]);

  const handleAddCustomColumn = useCallback((name: string) => {
    setCustomColumns((prev) => (prev.includes(name) ? prev : [...prev, name]));
  }, []);
  const handleDeleteCustomColumn = useCallback((name: string) => {
    setCustomColumns((prev) => prev.filter((c) => c !== name));
    setMeasurements((prev) =>
      prev.map((m) => {
        if (!m.customFields?.[name]) return m;
        const rest = { ...m.customFields };
        delete rest[name];
        return { ...m, customFields: rest };
      }),
    );
  }, []);
  const handleCustomFieldChange = useCallback((id: string, column: string, value: string) => {
    setMeasurements((prev) =>
      prev.map((m) =>
        m.id === id ? { ...m, customFields: { ...m.customFields, [column]: value } } : m,
      ),
    );
  }, []);
  const handleLedgerFieldChange = useCallback(
    (id: string, field: 'annotation' | 'group' | 'qty' | 'label' | 'material', value: string) => {
      // Bulk edit: when the edited row is part of a multi-selection, apply
      // the change to every selected row (Bluebeam-style). Otherwise just
      // the single row.
      const ids =
        selectedLedgerIds.size > 1 && selectedLedgerIds.has(id)
          ? selectedLedgerIds
          : new Set([id]);
      setMeasurements((prev) =>
        prev.map((m) => {
          if (!ids.has(m.id)) return m;
          if (field === 'qty') {
            const n = parseInt(value, 10);
            return Number.isFinite(n) && n >= 1 ? { ...m, multiplier: n } : m;
          }
          if (field === 'label') {
            return { ...m, customFields: { ...m.customFields, Subject: value } };
          }
          if (field === 'material') {
            return { ...m, customFields: { ...m.customFields, Material: value } };
          }
          return { ...m, [field]: value };
        }),
      );
    },
    [selectedLedgerIds],
  );
  // Per-page text-layer audit (8.2.0). When a document was opened from the
  // server we fetch its metadata to learn how many pages came back with no
  // text layer (likely scanned drawings that need OCR) so the viewer can flag
  // them instead of presenting them as silently empty. ``null`` = not loaded /
  // not applicable (e.g. a freshly dropped local file).
  const [noTextLayer, setNoTextLayer] = useState<{ count: number; pages: number[] } | null>(null);
  const [noTextBannerDismissed, setNoTextBannerDismissed] = useState(false);
  // The server document's own project (from the metadata fetch below). Fallback
  // identity for measurement persistence when no project is active in the app
  // header: without it a document opened from /markups or the documents tab on
  // a clean profile never fetches its measurements - the screen does not ask,
  // it just renders an empty ledger. The header project, when set, still wins.
  const [docProjectId, setDocProjectId] = useState<string | null>(null);
  const activeProjectId = useProjectContextStore((s) => s.activeProjectId);
  const activeProjectName = useProjectContextStore((s) => s.activeProjectName);

  // PDF / Excel export in-flight flags (drive button spinner state).
  const [isExportingPdf, setIsExportingPdf] = useState(false);
  const [isExportingXlsx, setIsExportingXlsx] = useState(false);
  const { hasPersistedData, saveNow, clearPersisted, syncing, syncedToServer, registerDeletion, hasUnsavedChanges } = useMeasurementPersistence({
    fileName,
    // Stable document UUID drives both the localStorage key and server sync
    // (issue #238); a null id (fresh local drop) keeps everything local.
    documentId,
    measurements,
    // Pass the stable useState setters directly (NOT inline arrows): an
    // inline-arrow setter changes identity every render, which used to tear
    // down the persistence hook's in-flight server load and drop the just-
    // loaded measurements (issue #276).
    setMeasurements,
    // Per-page scale: the hook persists the whole page-scale model and
    // migrates a legacy single-scale document into the default on load.
    pageScales,
    // Hydration goes through the wrapped setter (issue #333) so a load-time
    // scale restore flags the recompute effect to skip re-projecting depth -
    // it is a reconciliation, not a recalibration. Still a stable callback, so
    // the #276 load-teardown guarantee holds.
    setPageScales: hydratePageScalesFromPersistence,
    // The current page's effective scale is still sent on each measurement
    // (scale_pixels_per_unit) so the server-side B8 recompute uses the same
    // ratio the row was drawn at.
    scale,
    // The header project wins; the document's own project fills in when no
    // project is active so a server document still loads its measurements.
    projectId: activeProjectId || docProjectId,
  });

  /* ── Seed default-label counters from hydrated measurements (issue #384) ─
   * The per-type counters (annotationCounterRef) reset to 0 on every load path
   * and were never re-seeded from the measurements that hydrate afterwards, so a
   * reopened document recounted from 1 and produced a duplicate "Distance 1"
   * next to the one already on the sheet (labels feed the BOQ export, where a
   * duplicate is ambiguous). Raise each per-type counter to the highest trailing
   * number already present so the next auto label resumes above the numbers in
   * use. Monotonic (never lowered): deleting the highest-numbered measurement
   * does not free its number for reuse, and the brief window during an in-place
   * re-upload can only over-count (skip a number), never duplicate. */
  useEffect(() => {
    if (measurements.length === 0) return;
    const seeded = seedAnnotationCounters(measurements);
    const counters = annotationCounterRef.current;
    for (const type of Object.keys(seeded)) {
      const n = seeded[type]!;
      if (n > (counters[type] ?? 0)) counters[type] = n;
    }
  }, [measurements]);

  /* ── Deep-link: auto-select measurement from /markups ─────────────────
   * The /markups hub deep-links here with ``?measurementId=<uuid>``. After
   * the persistence hook hydrates the measurement list we look up the row
   * by either the frontend id or the server-side UUID, switch to its page
   * if needed, swap the sidebar to the Ledger tab (so the scroll-to-flash
   * has somewhere visible to land) and select it. The MeasurementLedger
   * scrolls the matching row into view + flashes via CSS.
   *
   * Guarded by a ref so we only consume the param once per mount — the
   * user is free to click around afterwards without us yanking them back. */
  const deepLinkConsumedRef = useRef<string | null>(null);
  /** Guards the ``initialPage`` restore (issue #386) so it is applied once
   *  per mount, mirroring ``deepLinkConsumedRef`` above. The viewer is keyed
   *  by document id and remounts on document switch, so a fresh mount always
   *  gets a fresh ref. */
  const initialPageConsumedRef = useRef(false);
  useEffect(() => {
    if (!initialMeasurementId) return;
    if (deepLinkConsumedRef.current === initialMeasurementId) return;
    if (measurements.length === 0) return;
    const match = measurements.find(
      (m) => m.id === initialMeasurementId || m.serverId === initialMeasurementId,
    );
    if (!match) return;
    deepLinkConsumedRef.current = initialMeasurementId;
    const targetPage = Math.max(1, Math.min(match.page || 1, totalPages || 1));
    if (targetPage !== currentPage) setCurrentPage(targetPage);
    setSidebarTab('properties');
    setSelectedMeasurementId(match.id);
  }, [initialMeasurementId, measurements, totalPages, currentPage]);

  /* ── Load PDF ────────────────────────────────────────────────────── */

  const handleFileUpload = useCallback(async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setIsLoading(true);
    try {
      const arrayBuffer = await file.arrayBuffer();
      const doc = await openPdf(arrayBuffer).promise;
      setPdfDoc(doc);
      setTotalPages(doc.numPages);
      setCurrentPage(1);
      setFileName(file.name); // Triggers persistence hook to load saved measurements
      refreshPageLabels(doc);
      // A freshly dropped local file has no server document UUID yet (issue
      // #238): clear the id so the persistence hook keeps it local-only and
      // never syncs filename-keyed rows to the server.
      setDocumentId(null);
      setActivePoints([]);
      undoStackRef.current = [];
      redoStackRef.current = [];
      setUndoCount(0);
      setRedoCount(0);
      setSelectedMeasurementId(null);
      annotationCounterRef.current = { distance: 0, polyline: 0, area: 0, volume: 0, count: 0, cloud: 0, arrow: 0, text: 0, rectangle: 0, highlight: 0 };
      setShowVolumeDepthInput(false);
      setPendingVolumePoints([]);
      setShowTextInput(false);
      setRectStartPoint(null);
      setIsDraggingRect(false);
    } catch (err) {
      console.error('Failed to load PDF:', err);
      addToast({
        type: 'error',
        title: t('takeoff_viewer.pdf_load_failed', { defaultValue: 'Failed to load PDF' }),
        message: err instanceof Error ? err.message : t('takeoff_viewer.pdf_load_error_hint', { defaultValue: 'The file may be corrupted or not a valid PDF.' }),
      });
    } finally {
      setIsLoading(false);
    }
  }, []);

  /* ── Reset cross-page in-progress state on page change ───────────
   * Without this, an in-progress drawing (one click placed) on page 1,
   * a half-finished calibration pick, or a selected measurement that
   * lives on another page all leak to the new page.  Symptoms: the next
   * click on page 2 completes a polygon spanning pages, the calibration
   * dialog opens with a nonsense distance, the Properties panel shows
   * data for an off-screen measurement.  See takeoff audit BUG-1/2/5/6. */
  useEffect(() => {
    setActivePoints([]);
    setRectStartPoint(null);
    setIsDraggingRect(false);
    setShowTextInput(false);
    setPendingVolumePoints([]);
    setShowVolumeDepthInput(false);
    setSettingScale(false);
    setCalibrationMode(false);
    setScalePoints([]);
    // Clear the live draw/calibration preview so no rubber-band or snap ring
    // carries over to the new page (#367).
    setLiveCursor(null);
    setSnapPoint(null);
    // Abandon any in-flight in-canvas edit drag so it cannot bleed onto the
    // new page (#194).
    dragRef.current = null;
    activeVertexRef.current = null;
    setDragPreview(null);
  }, [currentPage]);

  /* ── Mirror the current page back to the parent (issue #386) ──────────
   * Guarded on `pdfDoc` being loaded: before the document finishes loading,
   * `currentPage` still holds its mount-time default (1), and emitting that
   * here would overwrite a deep-linked `?page=` in the URL before the
   * restore above has had a chance to apply it. Once `pdfDoc` is set, the
   * restore has already run in the same update (both are set together in
   * the load effect), so `currentPage` is always the resolved value here. */
  useEffect(() => {
    if (!pdfDoc) return;
    onPageChange?.(currentPage);
  }, [currentPage, pdfDoc, onPageChange]);

  /* Deselect a measurement that lives on a different page than the one
   * being viewed — keeps Properties panel coherent with the canvas. */
  useEffect(() => {
    if (!selectedMeasurementId) return;
    const m = measurements.find((x) => x.id === selectedMeasurementId);
    if (m && m.page !== currentPage) setSelectedMeasurementId(null);
  }, [currentPage, selectedMeasurementId, measurements]);

  /* Clear the active-vertex tracker whenever the selection changes, so a
   * stale vertex index from a previously-selected measurement can never
   * drive a Delete-vertex on the wrong shape (#194). */
  useEffect(() => {
    const active = activeVertexRef.current;
    if (active && active.measurementId !== selectedMeasurementId) {
      activeVertexRef.current = null;
    }
  }, [selectedMeasurementId]);

  /* ── Load PDF from URL (filmstrip click / deep link) ────────────── */

  useEffect(() => {
    if (!initialPdfUrl) return;
    let cancelled = false;
    setIsLoading(true);
    setLoadProgress(null);
    (async () => {
      try {
        const token = useAuthStore.getState().accessToken;
        const httpHeaders: Record<string, string> = {};
        if (token) httpHeaders['Authorization'] = `Bearer ${token}`;
        // Range-request loading: pdf.js fetches only the byte ranges it needs
        // (header + xref + first pages), so a 14 MB drawing can paint its
        // first page after ~1-2 MB instead of waiting for the full download.
        // Falls back to a full download automatically if the server ignores
        // Range requests.
        const loadingTask = openPdfUrl(initialPdfUrl, httpHeaders);
        loadingTask.onProgress = (progressData: { loaded: number; total: number }) => {
          if (cancelled) return;
          const { loaded, total } = progressData;
          if (total > 0) {
            setLoadProgress(Math.min(99, Math.round((loaded / total) * 100)));
          }
        };
        const doc = await loadingTask.promise;
        if (cancelled) return;
        setPdfDoc(doc);
        setTotalPages(doc.numPages);
        refreshPageLabels(doc);
        // Restore the page the document was left on (issue #386) rather than
        // always landing on page 1, so reopening a takeoff document (or
        // sharing/bookmarking a `?page=` link) returns to the same sheet.
        // Consumed once per mount; a fresh mount (new document, new key) gets
        // a fresh ref, so switching documents never leaks the old page.
        if (initialPage && !initialPageConsumedRef.current) {
          initialPageConsumedRef.current = true;
          setCurrentPage(Math.max(1, Math.min(initialPage, doc.numPages)));
        } else {
          setCurrentPage(1);
        }
        setFileName(initialPdfName || 'Document.pdf');
        setActivePoints([]);
        undoStackRef.current = [];
        redoStackRef.current = [];
        setUndoCount(0);
        setRedoCount(0);
        setSelectedMeasurementId(null);
        annotationCounterRef.current = { distance: 0, polyline: 0, area: 0, volume: 0, count: 0, cloud: 0, arrow: 0, text: 0, rectangle: 0, highlight: 0 };
        setShowVolumeDepthInput(false);
        setPendingVolumePoints([]);
        setShowTextInput(false);
        setRectStartPoint(null);
        setIsDraggingRect(false);
      } catch (err) {
        if (cancelled) return;
        console.error('Failed to load PDF from URL:', err);
        addToast({
          type: 'error',
          title: t('takeoff_viewer.pdf_load_failed', { defaultValue: 'Failed to load PDF' }),
          message: err instanceof Error ? err.message : t('takeoff_viewer.pdf_load_error_hint', { defaultValue: 'The file may be corrupted or not a valid PDF.' }),
        });
      } finally {
        if (!cancelled) {
          setIsLoading(false);
          setLoadProgress(null);
        }
      }
    })();
    return () => { cancelled = true; };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [initialPdfUrl, initialPdfName]);

  /* ── Restore an ERP-embedded takeoff snapshot ───────────────────────
   * A PDF exported via "Save PDF" carries its measurements in the file
   * metadata. Reopening it here restores every markup as an editable
   * measurement (server ids are dropped, so rows save as new). Runs once
   * per loaded document. The atomic functional update means the
   * persistence hook always wins a race: if it already loaded server or
   * local rows, the snapshot is skipped; if it loads them later, its
   * setMeasurements overwrites the snapshot rows. */
  useEffect(() => {
    if (!pdfDoc) return;
    let cancelled = false;
    (async () => {
      const snapshot = await readTakeoffSnapshot(pdfDoc);
      if (cancelled || !snapshot) return;
      const rows = await snapshotToMeasurements(snapshot, pdfDoc);
      if (cancelled || rows.length === 0) return;
      setMeasurements((prev) => (prev.length === 0 ? rows : prev));
      addToast({
        type: 'success',
        title: t('takeoff_viewer.snapshot_restored_title', { defaultValue: 'Markups restored' }),
        message: t('takeoff_viewer.snapshot_restored_msg', {
          defaultValue: '{{count}} editable markups embedded in this PDF were restored.',
          count: rows.length,
        }),
      });
    })();
    return () => { cancelled = true; };
    // Intentionally keyed on pdfDoc only: one restore attempt per opened
    // document, reading load-time state via the functional updater.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [pdfDoc]);

  /* ── Fetch server-side document metadata (text-layer audit) ───────── */
  // When a PDF is opened from the server (filmstrip / deep link) we pull the
  // document metadata so the viewer can flag pages that came back with no text
  // layer (likely scanned drawings that need OCR). Keyed off ``documentId`` so
  // that dropping a local file takes the banner down with it instead of
  // leaving the previous drawing's OCR verdict on screen. Best-effort: any
  // failure leaves the banner hidden rather than blocking the drawing.
  useEffect(() => {
    setNoTextLayer(null);
    setDocProjectId(null);
    const docId = documentId;
    if (!docId) {
      setNoTextBannerDismissed(false);
      return;
    }
    // Restore a per-document dismissal (issue #346): a banner the user already
    // closed for this drawing stays closed when the document is reopened,
    // instead of resetting on every mount. Keyed by the stable document id,
    // following the takeoff.groupColors.<id> idiom used in this component.
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(`takeoff.ocrBannerDismissed.${docId}`) === 'true';
    } catch {
      /* ignore private-mode / quota read failures */
    }
    setNoTextBannerDismissed(dismissed);
    let cancelled = false;
    (async () => {
      try {
        const meta = await takeoffApi.getDocument(docId);
        if (cancelled || !meta) return;
        setDocProjectId(meta.project_id ?? null);
        const count = meta.pages_without_text ?? 0;
        if (count > 0) {
          setNoTextLayer({ count, pages: meta.pages_without_text_list ?? [] });
        }
      } catch {
        /* metadata is advisory - ignore and leave the banner hidden */
      }
    })();
    return () => { cancelled = true; };
  }, [documentId]);

  /* ── Track the stable document UUID (issue #238) ──────────────────────
   * Measurement identity is projectId + this id, never the filename. The id
   * comes from the opener and from nowhere else. It is deliberately NOT
   * recovered from ``initialPdfUrl``: that URL may belong to either document
   * namespace, and a Project Files id sent to a takeoff endpoint 404s.
   *
   * This effect only mirrors the prop. ``documentId`` is the live truth and
   * can diverge from it: dropping a local file clears the id while the prop
   * and the URL still describe the previously opened server document. Server
   * calls must therefore read ``documentId``, never the prop. */
  useEffect(() => {
    setDocumentId(initialDocumentId ?? null);
  }, [initialDocumentId]);

  /* Custom group colours (issue #313) persist per document so a colour scheme
   * survives a reload. A still-local file (documentId null) keeps them for the
   * session only. */
  useEffect(() => {
    if (!documentId) return;
    try {
      const raw = localStorage.getItem(`takeoff.groupColors.${documentId}`);
      setCustomGroupColors(raw ? (JSON.parse(raw) as Record<string, string>) : {});
    } catch {
      setCustomGroupColors({});
    }
  }, [documentId]);
  useEffect(() => {
    if (!documentId) return;
    try {
      localStorage.setItem(
        `takeoff.groupColors.${documentId}`,
        JSON.stringify(customGroupColors),
      );
    } catch {
      /* ignore quota / private-mode failures */
    }
  }, [documentId, customGroupColors]);

  /* Server-side group-colour persistence (issues #313/#398). localStorage alone
   * left a re-coloured group blue for a second user / another machine. The
   * metadata blob on each measurement DOES round-trip to the server (like the
   * #311/#312 per-measurement styles), so each group's custom colour is
   * mirrored onto its measurements' `groupColor`: that stamps the
   * sync-signature, PATCHes the rows, and comes back through `fromApiFormat`.
   *
   * `customGroupColors` is the authority and the mirror is its cache, so this
   * runs in ONE direction. It used to be two standing effects writing at each
   * other, each reading a snapshot the other had already invalidated; once the
   * two copies disagreed neither could win, so the pair alternated forever,
   * kept the affected rows permanently dirty (which re-armed the debounced save
   * before it could ever fire) and persisted the inconsistent map, so a reload
   * resumed the loop rather than ending it.
   *
   * The one moment the mirror feeds the map is hydration, which is how a colour
   * chosen elsewhere arrives at all. {@link groupColorCommit} owns that gate;
   * hydration runs once per document and does not also stamp, so exactly one
   * copy is written per commit. Both writes go through functional updaters so
   * they compose with anything an earlier effect queued in the same batch. */
  const colorIdentity = groupColorIdentity(activeProjectId, documentId, fileName);
  const [groupColorsHydratedFor, setGroupColorsHydratedFor] = useState<string | null>(null);
  useEffect(() => {
    const action = groupColorCommit(
      { colors: customGroupColors, measurements, hydratedFor: groupColorsHydratedFor },
      colorIdentity,
    );
    if (action.colors) {
      setCustomGroupColors((prev) => hydrateGroupColors(prev, measurements));
      setGroupColorsHydratedFor(action.hydratedFor);
    }
    if (action.measurements) {
      setMeasurements((prev) => stampGroupColors(prev, customGroupColors));
    }
  }, [customGroupColors, measurements, groupColorsHydratedFor, colorIdentity]);

  /* Group bands ride the same one-way pair as the colours above (issue #393):
   * the map is authoritative, the copy on each measurement is a cache of it,
   * and the copy is read back only while rehydrating a document. Keyed on the
   * same document identity, so opening a second file cannot fold the first
   * file's group order into it. */
  const [groupBandsHydratedFor, setGroupBandsHydratedFor] = useState<string | null>(null);
  useEffect(() => {
    const action = groupBandCommit(
      { bands: explicitGroupBands, items: measurements, hydratedFor: groupBandsHydratedFor },
      colorIdentity,
    );
    if (action.bands) {
      setExplicitGroupBands((prev) => hydrateGroupBands(prev, measurements));
      setGroupBandsHydratedFor(action.hydratedFor);
    }
    if (action.items) {
      setMeasurements((prev) => stampGroupBands(prev, explicitGroupBands));
    }
  }, [explicitGroupBands, measurements, groupBandsHydratedFor, colorIdentity]);

  /* ── Reset per-document caches when the open PDF changes ──────────────
   * Thumbnails and extracted text layers are keyed by page number, so they
   * MUST be dropped when a different document is opened or they would show
   * the previous file's previews / find a previous file's text. */
  useEffect(() => {
    setThumbs({});
    thumbRenderQueueRef.current.clear();
    thumbPendingRef.current.clear();
    textLayerCacheRef.current.clear();
    setSearchQuery('');
    setSearchMatches([]);
    setActiveMatchIdx(-1);
  }, [pdfDoc]);

  /* ── Warn on unsaved changes (tab close / navigation) ────────────── */

  useEffect(() => {
    if (measurements.length === 0) return;
    const handler = (e: BeforeUnloadEvent) => {
      // Actually persist before warning (issue #281): the old handler only
      // showed the browser prompt and relied on the user clicking "stay".
      // saveNow writes localStorage synchronously (and best-effort kicks the
      // server) so a tab close keeps the latest measurements regardless of
      // which button the user picks.
      saveNow();
      // Only nag when work is genuinely unsaved (issue #336). The old handler
      // prompted on EVERY navigation - even when everything was already synced -
      // so users learned to click through it. ``hasUnsavedChanges`` reads the
      // live pending state (debounced writes / server sync / edit-PATCH / queued
      // deletes) so a fully-synced document leaves without a prompt.
      if (!hasUnsavedChanges()) return;
      e.preventDefault();
      e.returnValue = '';
    };
    window.addEventListener('beforeunload', handler);
    return () => window.removeEventListener('beforeunload', handler);
  }, [measurements.length, saveNow, hasUnsavedChanges]);

  /* ── First-measurement-without-calibration warning ───────────────── */
  // Fires exactly once per session: when the user creates their first
  // measurement on an uncalibrated drawing, surface a toast that links
  // back to the Calibrate tool. Without this, raw-pixel measurements
  // (e.g. "22.98 km" on a unitless DWG/PDF) sail through silently.
  const calibrationWarnShownRef = useRef(false);
  useEffect(() => {
    if (calibrationWarnShownRef.current) return;
    if (isCalibrated) return;
    if (measurements.length === 0) return;
    // Only count "real" measurements, not annotations.
    const hasRealMeasurement = measurements.some(
      (m) => !ANNOTATION_TOOLS.includes(m.type as AnnotationToolType),
    );
    if (!hasRealMeasurement) return;
    calibrationWarnShownRef.current = true;
    addToast({
      type: 'warning',
      title: t('takeoff_viewer.calibration_warn_title', {
        defaultValue: 'Drawing is not calibrated',
      }),
      message: t('takeoff_viewer.calibration_warn_msg', {
        defaultValue: 'Measurements may be inaccurate. Use the Calibrate tool to set a real-world length.',
      }),
    });
  }, [measurements, isCalibrated, addToast, t]);

  /* ── Render page to canvas ───────────────────────────────────────── */

  useEffect(() => {
    if (!pdfDoc || !canvasReady || !canvasRef.current) return;
    if (pageMode !== 'single') return; // continuous mode renders per-page below
    let cancelled = false;
    let activeTask: { cancel: () => void } | null = null;

    (async () => {
      // Guard the whole render (getPage + page.render) in one try/catch.
      // A rapid zoom or page-flip supersedes an in-flight render - pdf.js
      // throws RenderingCancelledException, or "Cannot use the same canvas
      // during multiple render() operations" - a page-flip mid-getPage
      // rejects, and teardown aborts the worker. None of these are
      // actionable. The old code rethrew every non-cancellation error out of
      // this fire-and-forget IIFE, surfacing as "Uncaught (in promise)" in the
      // console (and getPage at the top was unguarded entirely). The sibling
      // PDF viewers (InlinePdfAnnotator / PunchPinBoard / PdfCompare) all
      // swallow this; do the same - swallow, dev-only warn.
      try {
        const page = await pdfDoc.getPage(currentPage);
        if (cancelled) return;

        const dpr = window.devicePixelRatio || 1;
        const rz = renderZoomRef.current || zoom;
        // Bitmap renders at the settled (debounced) zoom for crispness;
        // the element CSS-scales with the LIVE zoom so the page tracks a
        // zoom gesture smoothly while the bitmap catches up.
        const viewport = page.getViewport({ scale: rz * dpr });
        const canvas = canvasRef.current!;

        canvas.width = viewport.width;
        canvas.height = viewport.height;
        const liveScale = rz > 0 ? zoom / rz : 1;
        canvas.style.width = `${(viewport.width / dpr) * liveScale}px`;
        canvas.style.height = `${(viewport.height / dpr) * liveScale}px`;

        // The measurement overlay is sized + repainted by its own effect
        // (bitmap stays at the live zoom — vector repaint is cheap); just
        // keep its CSS box glued to the PDF canvas here.
        if (overlayRef.current) {
          overlayRef.current.style.width = canvas.style.width;
          overlayRef.current.style.height = canvas.style.height;
        }

        const task = page.render({ canvas, viewport });
        activeTask = task;
        await task.promise;
        if (cancelled) return;
        // The overlay is sized by its own effect; bump a nonce so the draw
        // effect repaints over the freshly rendered page (issue #297);
        // record that the main canvas now holds this page for the thumbnail
        // downscale (#301).
        mainRenderedPageRef.current = currentPage;
        setRenderNonce((n) => n + 1);
      } catch (err: any) {
        // Superseded/cancelled render or a teardown abort - expected, silent.
        if (err?.name === 'RenderingCancelledException' || cancelled) return;
        if (import.meta.env.DEV) {
          console.warn('[takeoff] page render skipped:', err);
        }
      }
    })();

    return () => {
      cancelled = true;
      try { activeTask?.cancel(); } catch { /* ignore */ }
    };
  }, [pdfDoc, canvasReady, currentPage, renderZoom, pageMode]);

  /* ── Live-zoom CSS follow ────────────────────────────────────────────
   * While a zoom gesture is in flight the bitmap re-render is debounced
   * (see renderZoom); this keeps the canvas ELEMENT glued to the live zoom
   * so the page tracks the cursor smoothly, GPU-scaling the last bitmap
   * until the crisp re-render lands. Derived from the last bitmap's own
   * dimensions, so no extra getPage call is needed per tick. */
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas || !pdfDoc || pageMode !== 'single') return;
    // Don't size from a stale bitmap while a page change is in flight.
    if (mainRenderedPageRef.current !== currentPage) return;
    const dpr = window.devicePixelRatio || 1;
    const rz = renderZoomRef.current || zoom;
    if (!(rz > 0) || canvas.width === 0) return;
    const pageW = canvas.width / (rz * dpr);
    const pageH = canvas.height / (rz * dpr);
    if (!Number.isFinite(pageW) || pageW <= 0 || !Number.isFinite(pageH) || pageH <= 0) return;
    canvas.style.width = `${pageW * zoom}px`;
    canvas.style.height = `${pageH * zoom}px`;
    const overlay = overlayRef.current;
    if (overlay) {
      overlay.style.width = canvas.style.width;
      overlay.style.height = canvas.style.height;
    }
  }, [zoom, pdfDoc, currentPage, pageMode]);

  /* ── Measurement overlay sizing ──────────────────────────────────────
   * The overlay bitmap tracks the LIVE zoom (vector repaint is cheap, so
   * measurements stay sharp and correctly placed through a zoom gesture)
   * while only the PDF bitmap below it is debounced. Bumps the render
   * nonce so the draw effect repaints at the new bitmap size. */
  useEffect(() => {
    const overlay = overlayRef.current;
    const canvas = canvasRef.current;
    if (!overlay || !canvas || !pdfDoc || pageMode !== 'single') return;
    // Don't size from a stale bitmap while a page change is in flight.
    if (mainRenderedPageRef.current !== currentPage) return;
    const dpr = window.devicePixelRatio || 1;
    const rz = renderZoomRef.current || zoom;
    if (!(rz > 0) || canvas.width === 0) return;
    const pageW = canvas.width / (rz * dpr);
    const pageH = canvas.height / (rz * dpr);
    if (!Number.isFinite(pageW) || pageW <= 0 || !Number.isFinite(pageH) || pageH <= 0) return;
    const w = Math.max(1, Math.round(pageW * zoom * dpr));
    const h = Math.max(1, Math.round(pageH * zoom * dpr));
    if (overlay.width !== w || overlay.height !== h) {
      overlay.width = w;
      overlay.height = h;
      setRenderNonce((n) => n + 1);
    }
    overlay.style.width = canvas.style.width;
    overlay.style.height = canvas.style.height;
  }, [zoom, renderNonce, pdfDoc, currentPage, pageMode]);

  /* ── Render all pages (continuous mode) ───────────────────────────────
   * Each page gets its own canvas stacked vertically. Re-renders are
   * debounced while zooming so a wheel-zoom gesture settles before the
   * (potentially many) page renders run. The measurement overlay stays a
   * single canvas, repositioned over the active page via `overlayTop`. */
  useEffect(() => {
    if (!pdfDoc || pageMode !== 'continuous' || totalPages === 0) return;
    let cancelled = false;
    const dpr = window.devicePixelRatio || 1;
    const z = zoomRef.current;
    const timer = window.setTimeout(() => {
      if (cancelled) return;
      for (let p = 1; p <= totalPages; p++) {
        const canvas = continuousCanvasesRef.current[p - 1];
        if (!canvas) continue;
        // Skip pages already rendered at this zoom.
        if (canvas.dataset.rz === String(z)) continue;
        void (async () => {
          try {
            const page = await pdfDoc.getPage(p);
            if (cancelled) return;
            const viewport = page.getViewport({ scale: z * dpr });
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            canvas.style.width = `${viewport.width / dpr}px`;
            canvas.style.height = `${viewport.height / dpr}px`;
            canvas.dataset.rz = String(z);
            await page.render({ canvas, viewport }).promise;
            if (cancelled) return;
            if (p === currentPageRef.current) {
              // Active page: size the measurement overlay to the fresh
              // bitmap, repaint measurements over it, and reposition it.
              const overlay = overlayRef.current;
              if (overlay) {
                overlay.width = viewport.width;
                overlay.height = viewport.height;
                overlay.style.width = `${viewport.width / dpr}px`;
                overlay.style.height = `${viewport.height / dpr}px`;
              }
              setRenderNonce((n) => n + 1);
              requestAnimationFrame(() => {
                const el = continuousCanvasesRef.current[currentPageRef.current - 1];
                const c = containerRef.current;
                if (el) {
                  setOverlayTop(el.offsetTop);
                  // A zoom asked to land the scroll once laid out.
                  const pending = pendingScrollRef.current;
                  if (pending && c) {
                    pendingScrollRef.current = null;
                    if (pending.kind === 'page-top') {
                      c.scrollTop = Math.max(0, el.offsetTop - 12);
                    } else {
                      c.scrollLeft = pending.left;
                      c.scrollTop = pending.top + el.offsetTop;
                    }
                  }
                }
              });
            }
          } catch (err: any) {
            if (err?.name === 'RenderingCancelledException' || cancelled) return;
            if (import.meta.env.DEV) {
              console.warn('[takeoff] continuous page render skipped:', err);
            }
          }
        })();
      }
    }, 80);
    return () => {
      cancelled = true;
      window.clearTimeout(timer);
    };
  }, [pdfDoc, totalPages, zoom, pageMode]);

  /* ── Keep the overlay glued to the active page ────────────────────────
   * Single mode: top 0. Continuous: sized to the active page canvas and
   * positioned at its top within the wrapper. Runs before the draw effect
   * (declaration order) so the repaint uses fresh dimensions. When the
   * page isn't rendered yet, the render effect sizes/positions on
   * completion instead. */
  useEffect(() => {
    if (pageMode !== 'continuous') {
      setOverlayTop(0);
      pendingScrollRef.current = null;
      return;
    }
    const el = continuousCanvasesRef.current[currentPage - 1];
    const overlay = overlayRef.current;
    if (el && el.width > 0 && overlay) {
      overlay.width = el.width;
      overlay.height = el.height;
      overlay.style.width = el.style.width;
      overlay.style.height = el.style.height;
      setOverlayTop(el.offsetTop);
    }
  }, [pageMode, currentPage]);

  /* ── Active page follows scroll (continuous mode) ───────────────────── */
  useEffect(() => {
    const container = containerRef.current;
    if (!container || pageMode !== 'continuous') return;
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const c = containerRef.current;
        if (!c || pageModeRef.current !== 'continuous') return;
        const probe = c.scrollTop + c.clientHeight * 0.35;
        const canvases = continuousCanvasesRef.current;
        for (let i = 0; i < canvases.length; i++) {
          const el = canvases[i];
          if (!el || el.offsetHeight === 0) continue;
          if (el.offsetTop + el.offsetHeight > probe) {
            const p = i + 1;
            if (p !== currentPageRef.current) setCurrentPage(p);
            break;
          }
        }
      });
    };
    container.addEventListener('scroll', onScroll, { passive: true });
    return () => container.removeEventListener('scroll', onScroll);
  }, [pageMode, totalPages]);

  /* ── Render page thumbnails (sidebar previews), lazily ────────────────
   * Viewport-based lazy loading: an IntersectionObserver on the thumbnail
   * strip renders a page's preview only when its item scrolls near the
   * visible area (rootMargin = prefetch buffer), instead of eagerly
   * rendering every page of a 70+ page set on open. The current page is
   * still captured from the main canvas by the effect below (issue #301),
   * never re-rendered here - re-rendering it through pdf.js races the main
   * render effect for the same page object and the loser rejects into the
   * empty catch, so the thumbnail spins forever.
   * Pages drain from `thumbPendingRef` one at a time (rAF yield between
   * pages keeps navigation + drawing responsive), nearest to the current
   * page first. The queue + thumbsRef guards make renders idempotent, so
   * observer re-fires are cheap no-ops; `capThumbCache` keeps the bitmap
   * map LRU-capped. `thumbs` is deliberately NOT in the dep array - it is
   * read through refs, so including it would re-run the effect on every
   * rendered page and loop. */
  const renderThumbRef = useRef<(n: number) => Promise<void>>(async () => {});
  renderThumbRef.current = async (n: number) => {
    const doc = pdfDocRef.current;
    if (!doc) return;
    const queue = thumbRenderQueueRef.current;
    // Skip pages already rendered (thumbsRef) or currently rendering (queue).
    if (queue.has(n) || thumbsRef.current[n] !== undefined) return;
    queue.add(n);
    try {
      const page = await doc.getPage(n);
      // Render at 2x for sharp thumbnails on retina displays (displayed at ~120px CSS).
      const scale = computeThumbScale(page.getViewport({ scale: 1 }).width, THUMB_MAX_WIDTH * 2);
      const vp = page.getViewport({ scale });
      const off = document.createElement('canvas');
      off.width = Math.max(1, Math.ceil(vp.width));
      off.height = Math.max(1, Math.ceil(vp.height));
      await page.render({ canvas: off, viewport: vp }).promise;
      // The document may have changed mid-render; never paint an old doc's
      // bitmap into the new doc's thumbnail map (caches reset on pdfDoc change).
      if (pdfDocRef.current !== doc) return;
      const url = off.toDataURL('image/png');
      setThumbs((prev) => capThumbCache({ ...prev, [n]: url }, currentPageRef.current));
    } catch {
      /* a bad page: drop it and move on */
    } finally {
      queue.delete(n);
    }
  };
  const pumpThumbQueue = (): void => {
    if (thumbPumpRunningRef.current) return;
    thumbPumpRunningRef.current = true;
    (async () => {
      try {
        for (;;) {
          const pending = thumbPendingRef.current;
          if (pending.size === 0) return;
          // Nearest to the current page first, so the visible neighbourhood wins.
          const cp = currentPageRef.current;
          let next = -1;
          let best = Infinity;
          pending.forEach((pn) => {
            const d = Math.abs(pn - cp);
            if (d < best) { best = d; next = pn; }
          });
          pending.delete(next);
          await renderThumbRef.current(next);
          // Yield a frame so navigation + drawing never block on thumbnails.
          await new Promise<void>((r) => requestAnimationFrame(() => r()));
        }
      } finally {
        thumbPumpRunningRef.current = false;
        // A request may have landed while the last page rendered; drain it.
        if (thumbPendingRef.current.size > 0) pumpThumbQueue();
      }
    })();
  };
  const requestThumb = (n: number): void => {
    if (n === currentPageRef.current) return; // captured from the main canvas below
    if (thumbsRef.current[n] !== undefined || thumbRenderQueueRef.current.has(n)) return;
    thumbPendingRef.current.add(n);
    pumpThumbQueue();
  };
  useEffect(() => {
    if (!pdfDoc || !showThumbnails || totalPages <= 1) return;
    const strip = document.querySelector<HTMLElement>('[data-testid="thumbnail-strip"]');
    if (typeof IntersectionObserver === 'undefined' || !strip) {
      // Fallback: no observer support - eager nearest-first render (old behaviour).
      (async () => {
        for (const n of pagesNearestFirst(currentPage, totalPages)) {
          requestThumb(n);
          await new Promise<void>((r) => requestAnimationFrame(() => r()));
        }
      })();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const n = Number((e.target as HTMLElement).dataset.page);
          if (Number.isFinite(n) && n >= 1 && n <= totalPages) requestThumb(n);
        }
      },
      // Prefetch buffer: start rendering ~900px before an item scrolls into view.
      { root: strip, rootMargin: '900px 0px', threshold: 0 },
    );
    strip
      .querySelectorAll<HTMLElement>('[data-testid="thumbnail-item"]')
      .forEach((el) => io.observe(el));
    return () => { io.disconnect(); };
    // `thumbs` intentionally excluded - read through thumbsRef; requestThumb only
    // touches refs, so the closure staying fixed between dep changes is safe.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [pdfDoc, showThumbnails, totalPages]);

  /* Current page thumbnail (issue #301). Rather than re-rendering the current
   * page through pdf.js (which races the main render effect), downscale the
   * already-rendered main canvas into the thumbnail once the main render has
   * settled. `renderNonce` bumps on every completed main render, so this
   * captures the page as soon as it is painted and the sidebar spinner clears.
   * Cheap (a single drawImage), so re-running it per render is fine. */
  useEffect(() => {
    if (!showThumbnails || totalPages <= 1) return;
    if (mainRenderedPageRef.current !== currentPage) return; // not painted yet
    if (thumbsRef.current[currentPage] !== undefined) return; // already captured
    const main = canvasRef.current;
    if (!main || main.width === 0) return;
    try {
      // Capture at 2x for sharp thumbnails on retina displays.
      const targetW = Math.max(1, THUMB_MAX_WIDTH * 2);
      const targetH = Math.max(1, Math.round(targetW * (main.height / main.width)));
      const off = document.createElement('canvas');
      off.width = targetW;
      off.height = targetH;
      const offCtx = off.getContext('2d');
      if (!offCtx) return;
      offCtx.drawImage(main, 0, 0, targetW, targetH);
      const url = off.toDataURL('image/png');
      setThumbs((prev) => capThumbCache({ ...prev, [currentPage]: url }, currentPage));
    } catch {
      /* tainted / not-ready canvas: a later render pass retries */
    }
    // `thumbs` read through thumbsRef; capture keyed off renderNonce.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [showThumbnails, totalPages, currentPage, renderNonce]);

  /** Keep the current-page thumbnail in view as the page changes. */
  useEffect(() => {
    if (!showThumbnails) return;
    const el = document.querySelector<HTMLElement>(
      `[data-testid="thumbnail-item"][data-page="${currentPage}"]`,
    );
    el?.scrollIntoView({ block: 'nearest' });
  }, [currentPage, showThumbnails]);

  /* ── Draw overlay (measurements + active drawing) ────────────────── */

  useEffect(() => {
    if (!overlayRef.current) return;
    const ctx = overlayRef.current.getContext('2d')!;
    const dpr = window.devicePixelRatio;
    ctx.clearRect(0, 0, overlayRef.current.width, overlayRef.current.height);

    ctx.lineWidth = 2 * dpr;
    ctx.font = `${12 * dpr}px sans-serif`;

    /** Draw an annotation label with a semi-transparent background at (lx, ly).
     *
     * Dark-mode fix (D-TKC-DK01): the label pill background was hardcoded
     * to '#ffffff', which made it invisible against a light canvas in light
     * mode when globalAlpha was low, and looked jarring in dark mode where
     * the app chrome is dark but the PDF canvas itself is always white.
     * We now read the actual dark-mode state from the html element so the
     * pill adapts correctly: white background in light mode, dark-grey in
     * dark mode. The text color is always the measurement group color so
     * the label remains legible regardless of theme.
     */
    const isDark = document.documentElement.classList.contains('dark');
    const drawAnnotationLabel = (
      text: string,
      lx: number,
      ly: number,
      color: string,
      alignRight = false,
    ) => {
      // Names view toggle: the name badges (and the count badge, which carries
      // the running total) are the names layer and hide together (#314).
      if (!showLabels) return;
      const fontSize = 11 * dpr;
      ctx.font = `bold ${fontSize}px sans-serif`;
      const metrics = ctx.measureText(text);
      const padX = 4 * dpr;
      const padY = 2 * dpr;
      const boxW = metrics.width + padX * 2;
      const boxH = fontSize + padY * 2;
      // alignRight anchors the badge by its RIGHT edge and grows it leftward, so
      // a name stacked over a right-aligned value label (a near-vertical line
      // whose value sits left of the band, #355) extends away from the band
      // instead of back across it. The box stays left-aligned internally, so it
      // does not depend on the global ctx.textAlign the caller has restored.
      const tx = alignRight ? lx - metrics.width : lx;
      const bx = tx - padX;
      const by = ly - fontSize - padY;
      // Semi-transparent background — white in light mode, dark-grey in dark mode
      ctx.globalAlpha = 0.82;
      ctx.fillStyle = isDark ? '#1e293b' : '#ffffff';
      ctx.fillRect(bx, by, boxW, boxH);
      ctx.globalAlpha = 1;
      // Border
      ctx.strokeStyle = color;
      ctx.lineWidth = 1 * dpr;
      ctx.strokeRect(bx, by, boxW, boxH);
      // Text
      ctx.fillStyle = color;
      ctx.fillText(text, tx, ly - padY);
      // Restore line width
      ctx.lineWidth = 2 * dpr;
    };

    /* ── Centered three-line markup label ──────────────────────────
     * Name (tool Subject, else the annotation text) over the material over
     * the dimension, centered as a stack just ABOVE the markup's midpoint —
     * never on the line itself. Each of the three lines is individually
     * toggleable (labelShowName/Material/Dimension) from the Colours tab,
     * which is the single control for this stack. (The toolbar Names toggle
     * only gates the other badge types now, so the two controls can't fight
     * each other and hide the label unexpectedly.) */
    const drawLabelStack = (
      m: Measurement,
      cx: number, // device px (already scaled by dpr * zoom)
      cy: number,
    ) => {
      const name = (m.customFields?.Subject?.trim() || m.annotation?.trim() || '');
      const material = (m.customFields?.Material?.trim() || '');
      const value = measurementLabel(m, scale, measurementSystem, areaAreaUnitRef.current);
      const showName = labelShowName && name.length > 0;
      const showMaterial = labelShowMaterial && material.length > 0;
      const showValue = showDimensions && labelShowDimension && value.length > 0;
      // Label rotation: for linear measurements (distance, polyline), rotate
      // the pill to match the line direction — horizontal line → horizontal
      // text, vertical → vertical, angular → angular. Other types stay horizontal.
      let labelAngle = 0;
      if ((m.type === 'distance' || m.type === 'polyline') && m.points.length >= 2) {
        const p0 = m.points[0]!;
        const p1 = m.points[m.points.length - 1]!;
        const dx = p1.x - p0.x;
        const dy = p1.y - p0.y;
        if (Math.abs(dx) > 1e-9 || Math.abs(dy) > 1e-9) {
          labelAngle = Math.atan2(dy, dx);
          // Keep text upright: flip if it would be upside-down.
          if (labelAngle > Math.PI / 2) labelAngle -= Math.PI;
          if (labelAngle < -Math.PI / 2) labelAngle += Math.PI;
        }
      }
      if (!showName && !showMaterial && !showValue) return;
      // Per-markup size overrides win; otherwise the global Colours-tab sizes.
      // Three independent lines: name, material, dimension.
      const fsName = (m.labelTextSize ?? labelTextSize) * dpr;
      const fsMat = (m.labelMaterialSize ?? labelMaterialSize) * dpr;
      const fsDim = (m.labelDimSize ?? labelDimSize) * dpr;
      const gap = 4 * dpr;
      const lift = 2 * dpr; // stack bottom sits tight above the line (no floating gap)
      const padX = 6 * dpr;
      const padY = 4 * dpr;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      ctx.font = `bold ${fsName}px sans-serif`;
      const nameW = showName ? ctx.measureText(name).width : 0;
      ctx.font = `${fsMat}px sans-serif`;
      const matW = showMaterial ? ctx.measureText(material).width : 0;
      ctx.font = `bold ${fsDim}px sans-serif`;
      const valueW = showValue ? ctx.measureText(value).width : 0;
      const lineHName = fsName * 1.25;
      const lineHMat = fsMat * 1.25;
      const lineHDim = fsDim * 1.25;
      const lineCount = (showName ? 1 : 0) + (showMaterial ? 1 : 0) + (showValue ? 1 : 0);
      const boxH =
        (showName ? lineHName : 0) + (showMaterial ? lineHMat : 0) + (showValue ? lineHDim : 0) +
        gap * (lineCount - 1) + padY * 2;
      const boxW = Math.max(nameW, matW, valueW, 1) + padX * 2;
      // Pixel-snap the pill and text for crisp edges (fractional coordinates
      // blur canvas text). Fully opaque background for maximum contrast.
      // Position the pill ABOVE the line in the line's own direction: offset
      // along the line's normal (perpendicular), not just straight up.
      const nx = -Math.sin(labelAngle);
      const ny = -Math.cos(labelAngle);
      const offX = nx * (lift + boxH / 2);
      const offY = ny * (lift + boxH / 2);
      const pcx = cx + offX; // pill center x
      const pcy = cy + offY; // pill center y
      const bx = Math.round(pcx - boxW / 2);
      const by = Math.round(pcy - boxH / 2);
      const tx = Math.round(pcx);
      // Rotate the pill around its center to match the line direction.
      const rcx = pcx;
      const rcy = pcy;
      ctx.save();
      if (labelAngle !== 0) {
        ctx.translate(rcx, rcy);
        ctx.rotate(labelAngle);
        ctx.translate(-rcx, -rcy);
      }
      // Pill background in the user's label colour.
      ctx.fillStyle = labelBgColor;
      const r = Math.min(6 * dpr, boxH / 2);
      ctx.beginPath();
      if (typeof ctx.roundRect === 'function') ctx.roundRect(bx, by, Math.round(boxW), Math.round(boxH), r);
      else ctx.rect(bx, by, Math.round(boxW), Math.round(boxH));
      ctx.fill();
      // Text lines, top to bottom: name, material, dimension — each with its
      // own size and colour (per-markup overrides win).
      const colName = m.labelNameColor ?? labelNameColor;
      const colMat = m.labelMaterialColor ?? labelMaterialColor;
      const colDim = m.labelDimColor ?? labelDimColor;
      let ty = by + padY;
      if (showName) {
        ctx.font = `bold ${fsName}px sans-serif`;
        ctx.fillStyle = colName;
        ty += fsName;
        ctx.fillText(name, tx, Math.round(ty));
        ty += lineHName - fsName + gap;
      }
      if (showMaterial) {
        ctx.font = `${fsMat}px sans-serif`;
        ctx.fillStyle = colMat;
        ty += fsMat;
        ctx.fillText(material, tx, Math.round(ty));
        ty += lineHMat - fsMat + gap;
      }
      if (showValue) {
        ctx.font = `bold ${fsDim}px sans-serif`;
        ctx.fillStyle = colDim;
        ty += fsDim;
        ctx.fillText(value, tx, Math.round(ty));
      }
      ctx.textAlign = 'left';
      ctx.restore(); // matches the save before rotation
    };

    /** Anchor a value label off the line it measures (issue #355).
     *
     * A distance / polyline can carry a real-world width (strokeWidthReal) and
     * paint as a band tens of device px wide, so a fixed straight-up offset lands
     * the text inside the band, in the band's own colour. Offset along the
     * segment's up-facing unit normal instead, by half the painted band plus the
     * caller's gap, and derive the text alignment from that normal so the text
     * runs away from the line rather than back across it. originX/Y is the point
     * the label sits by (a segment midpoint, or the first vertex for a polyline
     * total); segA/segB are that segment's endpoints; all are device coords.
     */
    const placeLabel = (
      originX: number,
      originY: number,
      segAx: number,
      segAy: number,
      segBx: number,
      segBy: number,
      gapPx: number,
      bandHalfPx: number,
    ): { lx: number; ly: number; align: CanvasTextAlign; baseline: CanvasTextBaseline } => {
      let nx = -(segBy - segAy);
      let ny = segBx - segAx;
      const len = Math.hypot(nx, ny);
      if (len < 1e-6) {
        // Zero-length segment (nothing dedupes coincident vertices): no
        // direction, so fall back to straight up instead of dividing by zero.
        nx = 0;
        ny = -1;
      } else {
        nx /= len;
        ny /= len;
        // Pick whichever of the two normals points up on screen (smaller y) so
        // labels sit above their lines as they did before. This flips the side
        // as a segment crosses vertical; the invariant that holds is that the
        // text ends up outside the band in every case.
        if (ny > 0) {
          nx = -nx;
          ny = -ny;
        }
      }
      const off = bandHalfPx + gapPx;
      return {
        lx: originX + nx * off,
        ly: originY + ny * off,
        // Canvas text runs rightward from its anchor on its baseline, so a label
        // left of a near-vertical band still runs back across it unless aligned:
        // align right when the normal points left, centre when it is vertical.
        align: nx < -0.01 ? 'right' : nx > 0.01 ? 'left' : 'center',
        baseline: ny < -0.01 ? 'bottom' : ny > 0.01 ? 'top' : 'middle',
      };
    };

    // The measurement being dragged, repointed to the live preview geometry so
    // its band, fills, value label, per-segment labels, vertex dots and
    // annotation all follow the cursor and there is only ever one band on screen
    // (#357). Project the recompute patch field-by-field exactly like
    // commitGeometryEdit does on release - never spread it, since it also carries
    // selfIntersecting, which is not a Measurement field.
    const previewMeasurement: Measurement | null = (() => {
      if (!dragPreview) return null;
      const base = measurements.find((mm) => mm.id === dragPreview.measurementId);
      if (!base || base.page !== currentPage) return null;
      const patch = dragPreview.patch;
      return {
        ...base,
        points: dragPreview.points,
        value: patch.value,
        label: patch.label,
        unit: patch.unit ?? base.unit,
        ...(patch.area !== undefined ? { area: patch.area } : {}),
        ...(patch.width !== undefined ? { width: patch.width } : {}),
        ...(patch.height !== undefined ? { height: patch.height } : {}),
      };
    })();

    // Draw completed measurements on current page (respecting group visibility).
    // Iterate the ordered projection (issue #379) so an explicit z-order drives
    // which shape paints on top; un-ordered rows keep creation order (#375).
    for (const rawM of orderedMeasurements.filter((m) => m.page === currentPage && !hiddenGroups.has(m.group) && !hiddenMeasurements.has(m.id) && !(isAnnotationType(m.type) && hiddenGroups.has('__annotations__')))) {
      // Repoint the dragged measurement to its live geometry (#357); the rest of
      // the loop then draws the band / labels / dots from the cursor position.
      const m = previewMeasurement && previewMeasurement.id === rawM.id ? previewMeasurement : rawM;
      // A per-measurement colour (set via the properties swatch) wins over the
      // group default so a recoloured measurement paints in its chosen colour
      // (issue #299); annotation markups already resolve `m.color` below.
      const color = resolveMeasurementColor(m, groupColorMap);
      ctx.strokeStyle = color;
      ctx.fillStyle = color;
      // Optional per-measurement stroke width (issues #312/#339). A real-world
      // width (issue #339, canonical metres) wins when set and the measurement's
      // OWN page is calibrated (pixelsPerUnit > 0): the band then renders at the
      // element's true width via strokeWidthReal * pixelsPerUnit and stays
      // consistent across pages calibrated at different scales. Otherwise the
      // pixel width (issue #312) is used, defaulting to the 2px hairline so unset
      // measurements render exactly as before. Linear types honour it directly;
      // annotation markups reset their own width below. The width scales with
      // zoom (issue #321) so the outline stays fixed relative to the geometry as
      // the user zooms, matching document space.
      const ownPixelsPerUnit = scaleForPage(pageScales, m.page).pixelsPerUnit;
      const baseStrokeWidth =
        m.strokeWidthReal != null && m.strokeWidthReal > 0 && ownPixelsPerUnit > 0
          ? m.strokeWidthReal * ownPixelsPerUnit
          : (m.strokeWidth ?? 2);
      ctx.lineWidth = baseStrokeWidth * dpr * zoom;
      // Half the painted band, in device px, used to push value labels clear of
      // a wide real-world line so they are not drawn on top of it (issue #355).
      const bandHalfPx = (baseStrokeWidth * dpr * zoom) / 2;
      // AI suggestions (#194) render translucent + dashed until the user
      // confirms them, so they read as proposals rather than committed work.
      ctx.globalAlpha = m.suggested ? 0.5 : 1.0;
      ctx.setLineDash(m.suggested ? [6 * dpr, 4 * dpr] : []);

      if (m.type === 'distance' && m.points.length === 2) {
        const p0 = m.points[0]!;
        const p1 = m.points[1]!;
        ctx.beginPath();
        ctx.moveTo(p0.x * dpr * zoom, p0.y * dpr * zoom);
        ctx.lineTo(p1.x * dpr * zoom, p1.y * dpr * zoom);
        // Per-measurement line opacity (issue #332), composed with the loop
        // alpha (0.5 for an unconfirmed AI suggestion, else 1) so a suggested
        // line still reads as translucent. Restored to the loop alpha right
        // after the stroke so the value label / annotation that follow keep
        // full loop opacity. Unset strokeAlpha is fully opaque (no change).
        ctx.globalAlpha = (m.suggested ? 0.5 : 1) * (m.strokeAlpha ?? 1);
        ctx.stroke();
        ctx.globalAlpha = m.suggested ? 0.5 : 1;
        // Measurement value label (converted to the user's system; stored
        // metric per D-TKC-016). Offset perpendicular to the line so a wide
        // real-world band does not paint over it (issue #355).
        const ax = p0.x * dpr * zoom;
        const ay = p0.y * dpr * zoom;
        const bx = p1.x * dpr * zoom;
        const by = p1.y * dpr * zoom;
        // Centered name + dimension stack floating just above the midpoint —
        // never on the line itself.
        drawLabelStack(m, (ax + bx) / 2, (ay + by) / 2);
      }

      if (m.type === 'polyline' && m.points.length >= 2) {
        // Draw connected line segments
        const p0 = m.points[0]!;
        ctx.beginPath();
        ctx.moveTo(p0.x * dpr * zoom, p0.y * dpr * zoom);
        for (let i = 1; i < m.points.length; i++) {
          const pt = m.points[i]!;
          ctx.lineTo(pt.x * dpr * zoom, pt.y * dpr * zoom);
        }
        // Per-measurement line opacity (issue #332), composed with the loop
        // alpha; restored to the loop alpha right after so the per-segment
        // labels + vertex dots below keep full loop opacity.
        ctx.globalAlpha = (m.suggested ? 0.5 : 1) * (m.strokeAlpha ?? 1);
        ctx.stroke();
        ctx.globalAlpha = m.suggested ? 0.5 : 1;
        // Single centered name + total-dimension stack floating just above
        // the shape's centre — replaces the old per-segment labels.
        {
          let minX = Infinity;
          let minY = Infinity;
          let maxX = -Infinity;
          let maxY = -Infinity;
          for (const p of m.points) {
            const x = p.x * dpr * zoom;
            const y = p.y * dpr * zoom;
            if (x < minX) minX = x;
            if (x > maxX) maxX = x;
            if (y < minY) minY = y;
            if (y > maxY) maxY = y;
          }
          drawLabelStack(m, (minX + maxX) / 2, (minY + maxY) / 2);
        }
        // Draw points
        for (const p of m.points) {
          ctx.beginPath();
          ctx.arc(p.x * dpr * zoom, p.y * dpr * zoom, 3 * dpr, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      if ((m.type === 'area' || m.type === 'volume') && m.points.length >= 3) {
        const firstPt = m.points[0]!;
        ctx.beginPath();
        ctx.moveTo(firstPt.x * dpr * zoom, firstPt.y * dpr * zoom);
        for (let i = 1; i < m.points.length; i++) {
          const pt = m.points[i]!;
          ctx.lineTo(pt.x * dpr * zoom, pt.y * dpr * zoom);
        }
        ctx.closePath();
        // An opening deduction (area void) renders in a warning red with a
        // dashed outline so the estimator can see at a glance which areas are
        // being subtracted from the net.
        const isVoid = m.type === 'area' && m.isDeduction;
        if (isVoid) {
          ctx.save();
          ctx.fillStyle = '#ef4444';
          ctx.strokeStyle = '#ef4444';
          ctx.globalAlpha = m.fillAlpha ?? 0.18;
          ctx.fill();
          ctx.globalAlpha = 1;
          ctx.setLineDash([6 * dpr, 4 * dpr]);
          ctx.stroke();
          ctx.restore();
        } else {
          ctx.globalAlpha = m.fillAlpha ?? 0.15;
          ctx.fill();
          ctx.globalAlpha = 1;
          ctx.stroke();
        }
        // Measurement value label at centroid (converted to the user's
        // measurement system; stored metric per D-TKC-016).
        const cx = m.points.reduce((s, p) => s + p.x, 0) / m.points.length * dpr * zoom;
        const cy = m.points.reduce((s, p) => s + p.y, 0) / m.points.length * dpr * zoom;
        ctx.font = `${12 * dpr}px sans-serif`;
        // Prefix a minus so the on-canvas number reads as a subtraction.
        const areaLabel = measurementLabel(m, scale, measurementSystem, areaAreaUnitRef.current);
        if (showDimensions) ctx.fillText(isVoid ? `- ${areaLabel}` : areaLabel, cx, cy);
        // Annotation above centroid
        drawAnnotationLabel(m.annotation, cx, cy - 14 * dpr, color);
      }

      if (m.type === 'perimeter' && m.points.length >= 3) {
        const firstPt = m.points[0]!;
        ctx.beginPath();
        ctx.moveTo(firstPt.x * dpr * zoom, firstPt.y * dpr * zoom);
        for (let i = 1; i < m.points.length; i++) {
          const pt = m.points[i]!;
          ctx.lineTo(pt.x * dpr * zoom, pt.y * dpr * zoom);
        }
        ctx.closePath();
        ctx.stroke();
        const cx = m.points.reduce((s, p) => s + p.x, 0) / m.points.length * dpr * zoom;
        const cy = m.points.reduce((s, p) => s + p.y, 0) / m.points.length * dpr * zoom;
        drawLabelStack(m, cx, cy);
      }

      if (m.type === 'polygonCutout' && m.points.length >= 3) {
        const firstPt = m.points[0]!;
        ctx.save();
        ctx.strokeStyle = '#ef4444';
        ctx.setLineDash([6 * dpr, 4 * dpr]);
        ctx.beginPath();
        ctx.moveTo(firstPt.x * dpr * zoom, firstPt.y * dpr * zoom);
        for (let i = 1; i < m.points.length; i++) {
          const pt = m.points[i]!;
          ctx.lineTo(pt.x * dpr * zoom, pt.y * dpr * zoom);
        }
        ctx.closePath();
        ctx.globalAlpha = 0.15;
        ctx.fillStyle = '#ef4444';
        ctx.fill();
        ctx.globalAlpha = 1;
        ctx.stroke();
        ctx.restore();
        const cx = m.points.reduce((s, p) => s + p.x, 0) / m.points.length * dpr * zoom;
        const cy = m.points.reduce((s, p) => s + p.y, 0) / m.points.length * dpr * zoom;
        drawLabelStack(m, cx, cy);
      }

      if (m.type === 'ellipseCutout' && m.points.length === 2) {
        const cp = m.points[0]!;
        const ep = m.points[1]!;
        const cx = cp.x * dpr * zoom;
        const cy = cp.y * dpr * zoom;
        const rx = Math.abs(ep.x - cp.x) * dpr * zoom;
        const ry = Math.abs(ep.y - cp.y) * dpr * zoom;
        ctx.save();
        ctx.strokeStyle = '#ef4444';
        ctx.setLineDash([6 * dpr, 4 * dpr]);
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
        ctx.globalAlpha = 0.15;
        ctx.fillStyle = '#ef4444';
        ctx.fill();
        ctx.globalAlpha = 1;
        ctx.stroke();
        ctx.restore();
        drawLabelStack(m, cx, cy);
      }

      if (m.type === 'dynamicFill' && m.points.length >= 3) {
        const firstPt = m.points[0]!;
        ctx.save();
        ctx.strokeStyle = '#8b5cf6';
        ctx.beginPath();
        ctx.moveTo(firstPt.x * dpr * zoom, firstPt.y * dpr * zoom);
        for (let i = 1; i < m.points.length; i++) {
          const pt = m.points[i]!;
          ctx.lineTo(pt.x * dpr * zoom, pt.y * dpr * zoom);
        }
        ctx.closePath();
        ctx.globalAlpha = m.fillAlpha ?? 0.2;
        ctx.fillStyle = '#8b5cf6';
        ctx.fill();
        ctx.globalAlpha = 1;
        ctx.stroke();
        ctx.restore();
        const cx = m.points.reduce((s, p) => s + p.x, 0) / m.points.length * dpr * zoom;
        const cy = m.points.reduce((s, p) => s + p.y, 0) / m.points.length * dpr * zoom;
        drawLabelStack(m, cx, cy);
      }

      if (m.type === 'diameter' && m.points.length === 2) {
        const p0 = m.points[0]!;
        const p1 = m.points[1]!;
        const cx = (p0.x + p1.x) / 2 * dpr * zoom;
        const cy = (p0.y + p1.y) / 2 * dpr * zoom;
        const r = Math.hypot(p1.x - p0.x, p1.y - p0.y) / 2 * dpr * zoom;
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(p0.x * dpr * zoom, p0.y * dpr * zoom);
        ctx.lineTo(p1.x * dpr * zoom, p1.y * dpr * zoom);
        ctx.stroke();
        drawLabelStack(m, cx, cy);
      }

      if (m.type === 'radiusCenter' && m.points.length === 2) {
        const cp = m.points[0]!;
        const ep = m.points[1]!;
        const cx = cp.x * dpr * zoom;
        const cy = cp.y * dpr * zoom;
        const r = Math.hypot(ep.x - cp.x, ep.y - cp.y) * dpr * zoom;
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(ep.x * dpr * zoom, ep.y * dpr * zoom);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(cx, cy, 3 * dpr, 0, Math.PI * 2);
        ctx.fill();
        drawLabelStack(m, cx, cy - r - 10 * dpr);
      }

      if (m.type === 'radius3Point' && m.points.length === 3) {
        const circ = circleFrom3Points(m.points[0]!, m.points[1]!, m.points[2]!);
        if (circ) {
          const cx = circ.c.x * dpr * zoom;
          const cy = circ.c.y * dpr * zoom;
          const r = circ.r * dpr * zoom;
          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.stroke();
          for (const p of m.points) {
            ctx.beginPath();
            ctx.arc(p.x * dpr * zoom, p.y * dpr * zoom, 3 * dpr, 0, Math.PI * 2);
            ctx.fill();
          }
          drawLabelStack(m, cx, cy - r - 10 * dpr);
        }
      }

      if (m.type === 'angle' && m.points.length === 3) {
        const v = m.points[0]!;
        const p1 = m.points[1]!;
        const p2 = m.points[2]!;
        const vx = v.x * dpr * zoom;
        const vy = v.y * dpr * zoom;
        ctx.beginPath();
        ctx.moveTo(vx, vy);
        ctx.lineTo(p1.x * dpr * zoom, p1.y * dpr * zoom);
        ctx.moveTo(vx, vy);
        ctx.lineTo(p2.x * dpr * zoom, p2.y * dpr * zoom);
        ctx.stroke();
        const a1 = Math.atan2(p1.y - v.y, p1.x - v.x);
        const a2 = Math.atan2(p2.y - v.y, p2.x - v.x);
        const arcR = 30 * dpr;
        ctx.beginPath();
        ctx.arc(vx, vy, arcR, Math.min(a1, a2), Math.max(a1, a2));
        ctx.stroke();
        drawLabelStack(m, vx + arcR + 10 * dpr, vy);
      }

      if (m.type === 'count') {
        for (const p of m.points) {
          ctx.beginPath();
          ctx.arc(p.x * dpr * zoom, p.y * dpr * zoom, 8 * dpr, 0, Math.PI * 2);
          ctx.globalAlpha = m.fillAlpha ?? 0.3;
          ctx.fill();
          ctx.globalAlpha = 1;
          ctx.stroke();
        }
        // Annotation near first point
        if (m.points.length > 0) {
          const fp = m.points[0]!;
          drawAnnotationLabel(
            `${m.annotation} (${m.points.length})`,
            fp.x * dpr * zoom + 12 * dpr,
            fp.y * dpr * zoom - 4 * dpr,
            color,
          );
        }
      }

      /* ── Annotation markup rendering ────────────────────────────── */

      const annoColor = m.color || color;

      if (m.type === 'cloud' && m.points.length >= 3) {
        // Revision cloud: draw scalloped arcs between consecutive points (closed polygon)
        ctx.strokeStyle = annoColor;
        ctx.lineWidth = 2.5 * dpr;
        ctx.beginPath();
        const pts = m.points;
        for (let i = 0; i < pts.length; i++) {
          const pA = pts[i]!;
          const pB = pts[(i + 1) % pts.length]!;
          const ax = pA.x * dpr * zoom;
          const ay = pA.y * dpr * zoom;
          const bx = pB.x * dpr * zoom;
          const by = pB.y * dpr * zoom;
          const segLen = Math.sqrt((bx - ax) ** 2 + (by - ay) ** 2);
          const arcCount = Math.max(2, Math.round(segLen / (18 * dpr)));
          for (let j = 0; j < arcCount; j++) {
            const t0 = j / arcCount;
            const t1 = (j + 1) / arcCount;
            const x0 = ax + (bx - ax) * t0;
            const y0 = ay + (by - ay) * t0;
            const x1 = ax + (bx - ax) * t1;
            const y1 = ay + (by - ay) * t1;
            const cpx = (x0 + x1) / 2;
            const cpy = (y0 + y1) / 2;
            // Perpendicular offset for the bump
            const dx = x1 - x0;
            const dy = y1 - y0;
            const bumpSize = 6 * dpr;
            // Determine outward direction using centroid
            const centX = pts.reduce((s, p) => s + p.x, 0) / pts.length * dpr * zoom;
            const centY = pts.reduce((s, p) => s + p.y, 0) / pts.length * dpr * zoom;
            const midToCentX = centX - cpx;
            const midToCentY = centY - cpy;
            const perpX = -dy;
            const perpY = dx;
            // Bump outward (away from centroid)
            const dot = perpX * midToCentX + perpY * midToCentY;
            const sign = dot > 0 ? -1 : 1;
            const len = Math.sqrt(perpX * perpX + perpY * perpY) || 1;
            const offX = (sign * perpX / len) * bumpSize;
            const offY = (sign * perpY / len) * bumpSize;
            ctx.moveTo(x0, y0);
            ctx.quadraticCurveTo(cpx + offX, cpy + offY, x1, y1);
          }
        }
        ctx.stroke();
        ctx.lineWidth = 2 * dpr;
        // Semi-transparent fill
        ctx.fillStyle = annoColor;
        ctx.globalAlpha = 0.06;
        ctx.beginPath();
        ctx.moveTo(pts[0]!.x * dpr * zoom, pts[0]!.y * dpr * zoom);
        for (let i = 1; i < pts.length; i++) {
          ctx.lineTo(pts[i]!.x * dpr * zoom, pts[i]!.y * dpr * zoom);
        }
        ctx.closePath();
        ctx.fill();
        ctx.globalAlpha = 1;
        // Annotation label at centroid
        const centroidX = pts.reduce((s, p) => s + p.x, 0) / pts.length * dpr * zoom;
        const centroidY = pts.reduce((s, p) => s + p.y, 0) / pts.length * dpr * zoom;
        drawAnnotationLabel(m.annotation, centroidX, centroidY, annoColor);
      }

      if (m.type === 'arrow' && m.points.length === 2) {
        const p0 = m.points[0]!;
        const p1 = m.points[1]!;
        const x0 = p0.x * dpr * zoom;
        const y0 = p0.y * dpr * zoom;
        const x1 = p1.x * dpr * zoom;
        const y1 = p1.y * dpr * zoom;
        // Line
        ctx.strokeStyle = annoColor;
        ctx.lineWidth = 2.5 * dpr;
        ctx.beginPath();
        ctx.moveTo(x0, y0);
        ctx.lineTo(x1, y1);
        ctx.stroke();
        // Arrowhead at end point
        const angle = Math.atan2(y1 - y0, x1 - x0);
        const headLen = 12 * dpr;
        ctx.fillStyle = annoColor;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x1 - headLen * Math.cos(angle - Math.PI / 6), y1 - headLen * Math.sin(angle - Math.PI / 6));
        ctx.lineTo(x1 - headLen * Math.cos(angle + Math.PI / 6), y1 - headLen * Math.sin(angle + Math.PI / 6));
        ctx.closePath();
        ctx.fill();
        ctx.lineWidth = 2 * dpr;
        // Annotation label near start
        drawAnnotationLabel(m.annotation, x0 + 8 * dpr, y0 - 8 * dpr, annoColor);
      }

      if (m.type === 'text' && m.points.length >= 1) {
        // Revu-style text box: wrapped text inside a stored-width box,
        // anchor at the box's top-left. While this text is open in the
        // editor the textarea shows the content, so the canvas skips it.
        if (!(showTextInput && editingTextId === m.id)) {
          const p = m.points[0]!;
          const tx = p.x * dpr * zoom;
          const ty = p.y * dpr * zoom;
          const textContent = m.text || m.annotation;
          const boxW = m.width && m.width > 0 ? m.width : 0;
          ctx.font = `bold ${TEXT_FONT_PX * dpr * zoom}px sans-serif`;
          ctx.fillStyle = annoColor;
          ctx.textBaseline = 'top';
          const lines = boxW > 0
            ? wrapTextLines(textContent, boxW - TEXT_PAD_X * 2)
            : textContent.split('\n');
          lines.forEach((line, i) => {
            ctx.fillText(
              line,
              tx + TEXT_PAD_X * dpr * zoom,
              ty + (TEXT_PAD_Y + i * TEXT_LINE_HEIGHT_PX) * dpr * zoom,
            );
          });
          ctx.textBaseline = 'alphabetic';
          // Selected box: border + bottom-right resize handle.
          if (boxW > 0 && m.id === selectedMeasurementId) {
            const bw = boxW * dpr * zoom;
            const bh = (m.height && m.height > 0
              ? m.height
              : lines.length * TEXT_LINE_HEIGHT_PX + TEXT_PAD_Y * 2) * dpr * zoom;
            ctx.strokeStyle = '#2563eb';
            ctx.lineWidth = 1.5 * dpr;
            ctx.strokeRect(tx, ty, bw, bh);
            const hs = 8 * dpr;
            ctx.fillStyle = '#2563eb';
            ctx.fillRect(tx + bw - hs / 2, ty + bh - hs / 2, hs, hs);
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1 * dpr;
            ctx.strokeRect(tx + bw - hs / 2, ty + bh - hs / 2, hs, hs);
            ctx.lineWidth = 2 * dpr;
          }
        }
      }

      // Bluebeam-style placed legend: white box with a table of
      // (swatch, type label, + visible legend columns) rows. Selection-based
      // legends show their snapshot; "all" legends stay live.
      // Column set follows the panel's visibility toggles.
      if (m.type === 'legend' && m.points.length >= 1) {
        const p = m.points[0]!;
        const rows = getPlacedLegendRowsRef.current(m);
        const cols = legendVisibleColumnsRef.current;
        const lx = p.x * dpr * zoom;
        const ly = p.y * dpr * zoom;
        // Box size: responsive — measure each column's content and auto-fit,
        // unless the user manually resized (then use the stored size).
        const userW = m.width && m.width > 0 ? m.width : 0;
        const defaultW = legendContentWidth(cols.length);
        // Per-column widths: measure header + all values, add padding
        // (base 16px + the user's left/right cell padding).
        // Type column: swatch + label.
        ctx.font = `${11 * dpr}px sans-serif`;
        // Type column: colour swatch + tool symbol only (no name text),
        // so the width is fixed — offset + swatch + gap + symbol + air.
        const typeColW = 48 + legendPadLeft + legendPadRight;
        ctx.font = `bold ${10 * dpr}px sans-serif`;
        const colWidths: number[] = cols.map((col) => {
          let w = ctx.measureText(col.label).width / (dpr * zoom);
          ctx.font = `${11 * dpr}px sans-serif`;
          for (const row of rows) {
            const val = String(row.cells[col.key] ?? '—').slice(0, 20);
            w = Math.max(w, ctx.measureText(val).width / (dpr * zoom));
          }
          ctx.font = `bold ${10 * dpr}px sans-serif`;
          return Math.max(40, w + 16 + legendPadLeft + legendPadRight); // padding
        });
        // Column x offsets (cumulative).
        const colXOffsets: number[] = [];
        let acc = typeColW;
        for (const w of colWidths) {
          colXOffsets.push(acc);
          acc += w;
        }
        const autoW = Math.max(150, acc + 12);
        legendAutoWidthRef.current.set(m.id, autoW);
        // Never shrink below what the content needs (prevents overlap);
        // the user can only enlarge, and content scales up with the box.
        const effW = userW > 0 ? Math.max(userW, autoW) : autoW;
        const lw = effW * dpr * zoom;
        const lh = legendHeightOf(m, rows.length, legendPadTop + legendPadBottom) * dpr * zoom;
        // Content scale: only when the user manually enlarged beyond auto —
        // then content scales up. Auto-width itself always renders at cs=1.
        const cs = userW > 0 ? Math.min(3, Math.max(1, userW / Math.max(autoW, 1))) : 1;
        const isSel = m.id === selectedMeasurementId;
        // Box
        ctx.fillStyle = legendBgColorRef.current;
        ctx.strokeStyle = isSel ? '#2563eb' : '#9ca3af';
        ctx.lineWidth = (isSel ? 2.5 : 1.5) * dpr;
        ctx.beginPath();
        ctx.roundRect(lx, ly, lw, lh);
        ctx.fill();
        ctx.stroke();
        ctx.lineWidth = 2 * dpr;
        // Header (scaled): title row + column label row.
        // Title + column-header rows also grow with the top/bottom padding.
        const headerH = (LEGEND_HEADER_H + legendPadTop + legendPadBottom) * cs * dpr * zoom;
        const colHeaderH = (LEGEND_COLHEADER_H + legendPadTop + legendPadBottom) * cs * dpr * zoom;
        const totalHeaderH = headerH + colHeaderH;
        ctx.fillStyle = legendBgColorRef.current;
        ctx.beginPath();
        ctx.roundRect(lx, ly, lw, totalHeaderH, [6 * dpr, 6 * dpr, 0, 0]);
        ctx.fill();
        ctx.fillStyle = legendTextColorRef.current;
        ctx.font = `bold ${13 * cs * dpr}px sans-serif`;
        ctx.textBaseline = 'middle';
        ctx.textAlign = 'center';
        ctx.fillText('Legend', lx + lw / 2, ly + headerH / 2);
        ctx.textAlign = 'left';
        // Separator between the title field and the grid: "Legend" stays a
        // visually separate field, the column grid starts below it.
        ctx.strokeStyle = '#9ca3af';
        ctx.lineWidth = 1 * dpr;
        ctx.beginPath();
        ctx.moveTo(lx, ly + headerH);
        ctx.lineTo(lx + lw, ly + headerH);
        ctx.stroke();
        // Column labels (scaled) — aligned with the value columns below.
        // Uses the measured per-column x offsets so nothing overlaps.
        ctx.font = `bold ${10 * cs * dpr}px sans-serif`;
        ctx.fillStyle = legendTextColorRef.current;
        const colX = (idx: number) => lx + colXOffsets[idx]! * cs * dpr * zoom;
        const colW = (idx: number) => colWidths[idx]! * cs * dpr * zoom;
        cols.forEach((col, idx) => {
          const x = colX(idx);
          if (col.align === 'right') {
            ctx.textAlign = 'right';
            ctx.fillText(col.label, x + colW(idx) - (6 + legendPadRight) * cs * dpr * zoom, ly + headerH + colHeaderH / 2);
          } else {
            ctx.textAlign = 'left';
            ctx.fillText(col.label, x + legendPadLeft * cs * dpr * zoom, ly + headerH + colHeaderH / 2);
          }
        });
        ctx.textAlign = 'left';
        // Rows (scaled, clipped to the box interior so a user-shrunk box
        // never overflows its content). Row height grows with the user's
        // top/bottom cell padding.
        const rowH = (LEGEND_ROW_H + legendPadTop + legendPadBottom) * cs * dpr * zoom;
        ctx.save();
        ctx.beginPath();
        ctx.rect(lx, ly + totalHeaderH, lw, Math.max(0, lh - totalHeaderH));
        ctx.clip();
        ctx.font = `${11 * cs * dpr}px sans-serif`;
        rows.forEach((row, i) => {
          const ry = ly + totalHeaderH + i * rowH;
          // Swatch (scaled)
          const sw = 12 * cs * dpr * zoom;
          ctx.fillStyle = row.color;
          ctx.fillRect(lx + (10 + legendPadLeft) * cs * dpr * zoom, ry + (rowH - sw) / 2, sw, sw);
          ctx.strokeStyle = '#9ca3af';
          ctx.lineWidth = 1 * dpr;
          ctx.strokeRect(lx + (10 + legendPadLeft) * cs * dpr * zoom, ry + (rowH - sw) / 2, sw, sw);
          // Tool symbol (scaled) — the Kind column shows the symbol
          // instead of the type name text.
          drawLegendTypeSymbol(
            ctx,
            row.type,
            lx + (28 + legendPadLeft) * cs * dpr * zoom,
            ry + (rowH - 12 * cs * dpr * zoom) / 2,
            12 * cs * dpr * zoom,
            legendTextColorRef.current,
          );
          // Dynamic columns (scaled) — same x positions and alignment as headers.
          cols.forEach((col, idx) => {
            ctx.fillStyle = legendTextColorRef.current;
            const val = String(row.cells[col.key] ?? '—').slice(0, 20);
            const x = colX(idx);
            if (col.align === 'right') {
              ctx.textAlign = 'right';
              ctx.fillText(val, x + colW(idx) - (6 + legendPadRight) * cs * dpr * zoom, ry + rowH / 2);
            } else {
              ctx.textAlign = 'left';
              ctx.fillText(val, x + legendPadLeft * cs * dpr * zoom, ry + rowH / 2);
            }
          });
          ctx.textAlign = 'left';
        });
        ctx.restore();
        // Table borders per legend style (user's Style setting — PDF box only).
        const borderStyle = legendBorderStyleRef.current;
        if (borderStyle !== 'none') {
          ctx.strokeStyle = '#9ca3af';
          ctx.lineWidth = 1 * dpr;
          ctx.beginPath();
          if (borderStyle === 'outline' || borderStyle === 'grid') {
            // The grid's own frame starts below the separate "Legend" title
            // field (the standalone "outline" style still frames the whole box).
            const oy = borderStyle === 'grid' ? ly + headerH : ly;
            ctx.rect(lx, oy, lw, lh - (oy - ly));
          }
          if (borderStyle === 'horizontal' || borderStyle === 'grid') {
            // Header bottom + lines between rows.
            ctx.moveTo(lx, ly + totalHeaderH);
            ctx.lineTo(lx + lw, ly + totalHeaderH);
            rows.forEach((_, i) => {
              const ry = ly + totalHeaderH + (i + 1) * rowH;
              if (ry < ly + lh) {
                ctx.moveTo(lx, ry);
                ctx.lineTo(lx + lw, ry);
              }
            });
          }
          if (borderStyle === 'vertical' || borderStyle === 'grid') {
