  }, [measurements, orderedMeasurements, activePoints, currentPage, zoom, settingScale, scalePoints, activeTool, hiddenGroups, hiddenMeasurements, scale, pageScales, annotationColor, rectStartPoint, isDraggingRect, selectedMeasurementId, selectedLedgerIds, marqueeRect, zoomAreaRect, dragPreview, liveCursor, panning, searchMatches, activeMatchIdx, measurementSystem, snapPoint, snapIsContent, showLabels, showDimensions, labelTextSize, labelMaterialSize, labelDimSize, labelTextColor, labelNameColor, labelMaterialColor, labelDimColor, labelBgColor, labelShowName, labelShowMaterial, labelShowDimension, renderNonce, groupColorMap, multiplyGhosts, offsetGhost, legendTextColor, legendBgColor, legendBorderStyle, legendPadTop, legendPadBottom, legendPadLeft, legendPadRight, showTextInput, editingTextId]);

