      }

      if (m.type === 'rectangle' && m.points.length === 2) {
        const p0 = m.points[0]!;
        const p1 = m.points[1]!;
        const rx = Math.min(p0.x, p1.x) * dpr * zoom;
        const ry = Math.min(p0.y, p1.y) * dpr * zoom;
        const rw = Math.abs(p1.x - p0.x) * dpr * zoom;
        const rh = Math.abs(p1.y - p0.y) * dpr * zoom;
